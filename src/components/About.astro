---
import { site } from "../data/site";
---

<section id="o-mne" class="section about" aria-labelledby="about-title">
  <div class="container-x about__inner">
    <div class="about__media reveal">
      <div class="about__portrait">
        <img
          src="/images/about-mom-baby-original.png"
          alt="Maminka s miminkem"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="about__text reveal">
      <h2 id="about-title">O mně</h2>

      <p class="about__lead">
        Lorem ipsum dolor sit amet consectetur adipisicing elit. A illo
        inventore, libero accusamus officia reiciendis cumque at modi harum
        deserunt laborum ratione ad eum neque doloribus quaerat ex! Explicabo,
        sunt!
      </p>

      <ul class="about__values">
        <li class="about__value-item-link">
          <a
            href="#absolvovane-kurzy"
            class="about__value-link"
            aria-label="Certifikovaná lektorka – přejít na sekci Absolvované kurzy"
          >
            <span class="about__value-icon" aria-hidden="true">🎓</span>
            <div>
              <span><strong>Certifikovaná lektorka</strong></span>
            </div>
          </a>
        </li>
        <!-- <li>
          <span class="about__value-icon" aria-hidden="true"></span>
          <div>
            <strong></strong>
            <span></span>
          </div>
        </li>
        <li>
          <span class="about__value-icon" aria-hidden="true"></span>
          <div>
            <strong></strong>
            <span></span>
          </div>
        </li> -->
      </ul>
    </div>
  </div>
</section>

<style>
  #o-mne {
    scroll-margin-top: -5.5rem;
    position: relative;
    z-index: 1;
    background-color: var(--color-cream);
    /* Extra cream band above section — covers subpixel seam when zoom ≠ 100% */
    margin-top: -6px;
    padding-top: calc(5.5rem + 6px);
  }

  #o-mne::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -10px;
    height: 10px;
    background-color: var(--color-cream);
    pointer-events: none;
  }

  .about__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    text-align: left;
  }

  .about__media {
    position: relative;
    max-width: 380px;
    margin: 0 auto;
  }

  .about__portrait {
    position: relative;
    width: min(100%, 430px);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    border-radius: var(--radius-full);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    border: 0.4rem solid transparent;
  }

  .about__portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 36%;
  }

  .about__text h2 {
    font-size: var(--text-clamp-h2);
    margin: 0 0 1.5rem;
  }

  .about__lead {
    font-size: var(--text-lg);
    color: var(--color-ink);
    margin: 0 0 2rem;
  }

  .about__body {
    color: var(--color-ink-soft);
    margin: 0 0 2rem;
  }

  .about__body strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .about__values {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .about__values li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: white;
    border-radius: 1rem;
    border: 1.5px solid var(--color-lilac-soft);
    transition:
      transform 220ms ease,
      border-color 220ms ease;
  }

  .about__values li.about__value-item-link {
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .about__value-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1rem 1.25rem;
    margin: 0;
    border-radius: 1rem;
    border: 1.5px solid var(--color-lilac-soft);
    background: white;
    color: inherit;
    cursor: pointer;
    text-align: inherit;
    text-decoration: none;
    transition:
      transform 220ms ease,
      border-color 220ms ease;
  }

  .about__values li.about__value-item-link:hover .about__value-link {
    transform: translateX(4px);
    border-color: var(--color-blush-mid);
  }

  .about__value-link:focus-visible {
    outline: 2px solid var(--color-blush-mid);
    outline-offset: 2px;
  }

  .about__values li:not(.about__value-item-link):hover {
    transform: translateX(4px);
    border-color: var(--color-blush-mid);
  }

  .about__value-icon {
    font-size: var(--text-2xl);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--color-cream);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .about__values strong {
    display: block;
    font-weight: 700;
    color: var(--color-ink);
  }

  .about__values span:not(.about__value-icon) {
    font-size: var(--text-base);
    color: var(--color-ink-soft);
  }

  @media (min-width: 1024px) {
    .about__text h2 {
      margin: 0 0 1rem;
    }

    .about__inner {
      grid-template-columns: 1fr 1.2fr;
      gap: 5rem;
    }

    .about__media {
      max-width: none;
      margin: 0;
    }
  }
</style>
