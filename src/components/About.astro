---
import Icon from "astro-iconify";
---

<section id="o-mne" class="section about" aria-labelledby="about-title">
  <div class="container-x about__inner">
    <div class="about__media reveal">
      <div class="about__portrait-frame">
        <span class="about__portrait-glow" aria-hidden="true"></span>
        <div class="about__portrait">
          <img
            src="/images/about-mom-baby-original.png"
            alt="Maminka s miminkem"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="about__text reveal">
      <header class="section-header">
        <span class="eyebrow">O mně - medailonek</span>
        <h2 id="about-title">Mgr. Aneta Justychová</h2>
      </header>

      <div class="about__divider">
        <span aria-hidden="true">
          <Icon name="twemoji:pink-heart" class="about__divider-icon" />
        </span>
      </div>

      <div class="about__content">
        <p>
          Jsem lektorka cvičení a plavání pro děti a svou práci vnímám jako
          poslání, které propojuje pohyb, radost a blízkost mezi rodičem a
          dítětem.
        </p>

        <p>
          Děti provázím prvními krůčky v objevování vlastního těla i vodního
          prostředí, vždy s důrazem na respekt, bezpečí a přirozený vývoj.
        </p>

        <p>
          Zároveň jsem maminka dcery a syna, díky nimž do své práce přináším
          nejen odborné znalosti, ale i každodenní zkušenosti, empatii a
          pochopení pro potřeby dětí i jejich rodičů.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  #o-mne {
    scroll-margin-top: var(--section-scroll-margin);
    position: relative;
    z-index: 1;
    background-color: var(--color-cream);
    /* Extra cream band above section — covers subpixel seam when zoom ≠ 100% */
    margin-top: -6px;
    padding-top: calc(var(--section-padding-y) + 6px);
  }

  #o-mne::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -10px;
    height: 10px;
    background-color: var(--color-cream);
    pointer-events: none;
  }

  .about__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
    text-align: left;
  }

  .about__media {
    position: relative;
    max-width: 300px;
    margin: 0 auto;
  }

  .about__portrait-frame {
    position: relative;
    width: min(100%, 280px);
    margin: 0 auto;
  }

  .about__portrait-glow {
    position: absolute;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-full);
    background: color-mix(
      in srgb,
      var(--color-blush-deep) 7%,
      var(--color-cream-200) 93%
    );
    left: -15%;
    top: 12%;
    transform: scale(0.9);
    transform-origin: center center;
    z-index: 0;
    pointer-events: none;
  }

  .about__portrait {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-full);
    overflow: hidden;
    box-shadow: 0 12px 40px -16px rgba(123, 90, 160, 0.22);
  }

  .about__portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 36%;
  }

  .about__text {
    max-width: 42rem;
  }

  .about__text .section-header {
    margin-bottom: 0;
  }

  .about__text .section-header h2 {
    font-size: 2rem;
  }

  .about .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .about__divider {
    position: relative;
    margin: var(--space-6) 0 var(--space-8);
    height: 1px;
    background: var(--color-blush-mid);
  }

  .about__divider span {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-cream);
    padding: 0 var(--space-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .about__divider-icon {
    width: 1rem;
    height: 1rem;
  }

  .about__content {
    --location-divider: 1px solid rgba(236, 47, 142, 0.16);
    display: flex;
    flex-direction: column;
    gap: var(--section-title-gap);
  }

  .about__content p {
    margin: 0;
    max-width: 36rem;
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-ink);
  }

  .about__content p + p {
    border-top: var(--location-divider);
    padding-top: var(--space-5);
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .about__text {
      margin-inline: auto;
      text-align: center;
    }

    .about__content {
      align-items: center;
      text-align: center;
      margin-inline: auto;
    }

    .about__content p {
      margin-inline: auto;
    }
  }

  @media (min-width: 1024px) {
    #o-mne {
      scroll-margin-top: calc(-1 * var(--space-10));
    }

    .about__inner {
      grid-template-columns: 1fr 1.2fr;
      gap: 5rem;
    }

    .about__media {
      max-width: none;
      margin: 0;
    }

    .about__portrait-frame {
      width: min(100%, 380px);
    }

    .about__content p {
      font-size: var(--text-lg);
    }

    .about__text .section-header {
      text-align: left;
      margin-left: 0;
      margin-right: auto;
    }

    .about__text .section-header h2 {
      font-size: 2.5rem;
    }
  }
</style>
