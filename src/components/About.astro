---
import { site } from "../data/site";
---

<section id="o-mne" class="section about" aria-labelledby="about-title">
  <div class="container-x about__inner">
    <div class="about__media reveal">
      <div class="about__portrait">
        {/* Illustrative SVG portrait - no real photo for privacy */}
        <svg viewBox="0 0 400 480" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="bg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#d6ecfa"/>
              <stop offset="50%" stop-color="#ece1f7"/>
              <stop offset="100%" stop-color="#ffe1ed"/>
            </linearGradient>
            <linearGradient id="hair-grad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#6b4632"/>
              <stop offset="100%" stop-color="#4a2f20"/>
            </linearGradient>
          </defs>
          <rect width="400" height="480" rx="32" fill="url(#bg-grad)"/>
          {/* Floating shapes */}
          <circle cx="60" cy="80" r="22" fill="white" opacity="0.6"/>
          <circle cx="340" cy="120" r="14" fill="#fcc2d6" opacity="0.7"/>
          <circle cx="370" cy="380" r="28" fill="#a9d4f0" opacity="0.5"/>
          <circle cx="40" cy="400" r="18" fill="#d4bff5" opacity="0.7"/>
          {/* Body */}
          <ellipse cx="200" cy="430" rx="120" ry="60" fill="#fcc2d6"/>
          <rect x="120" y="280" width="160" height="170" rx="80" fill="#fcc2d6"/>
          {/* Neck */}
          <rect x="180" y="240" width="40" height="50" fill="#f7caaa"/>
          {/* Head */}
          <circle cx="200" cy="200" r="68" fill="#fbd5b8"/>
          {/* Hair */}
          <path d="M 132 200 Q 132 130 200 128 Q 268 130 268 200 Q 270 178 258 165 Q 240 145 200 144 Q 160 145 142 165 Q 130 178 132 200 Z" fill="url(#hair-grad)"/>
          {/* Bun */}
          <circle cx="200" cy="135" r="22" fill="url(#hair-grad)"/>
          {/* Eyes (closed, smiling) */}
          <path d="M 175 200 Q 180 196 185 200" stroke="#2a1f38" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <path d="M 215 200 Q 220 196 225 200" stroke="#2a1f38" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          {/* Cheeks */}
          <circle cx="170" cy="218" r="10" fill="#ff9bbf" opacity="0.5"/>
          <circle cx="230" cy="218" r="10" fill="#ff9bbf" opacity="0.5"/>
          {/* Smile */}
          <path d="M 188 230 Q 200 240 212 230" stroke="#2a1f38" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          {/* Heart on chest */}
          <path d="M 200 340 L 188 328 Q 178 318 188 308 Q 200 298 200 312 Q 200 298 212 308 Q 222 318 212 328 Z" fill="#ec2f8e"/>
        </svg>
        <div class="about__badge">
          <span class="about__badge-num">10+</span>
          <span class="about__badge-text">let s dětmi</span>
        </div>
      </div>
    </div>

    <div class="about__text reveal">
      <span class="eyebrow">O mně</span>
      <h2 id="about-title">
        Ahoj, jsem <em>{site.contact.instructorName.split(" ")[0]}</em>
      </h2>
      <p class="about__lead">
        Jsem maminka, instruktorka cvičení a hlavně velký fanoušek pohybu od těch nejmenších věků.
        S dětmi pracuji už přes 10 let a vím, že každé dítě je originál - cvičení proto vždy
        přizpůsobuji konkrétní skupince i náladě.
      </p>
      <p class="about__body">
        Lekce stavím na <strong>klidu, hře a respektu</strong>. Nikoho nikam netlačíme.
        Společně si zazpíváme, vyzkoušíme nové polohy, masírujeme bříška a možná i trochu kutáme po zemi.
        Maminkám i tatínkům dávám prostor, aby si po cvičení popovídali u čaje.
      </p>

      <ul class="about__values">
        <li>
          <span class="about__value-icon" aria-hidden="true">🌿</span>
          <div>
            <strong>Klid a hra</strong>
            <span>Žádný stres ani výkonnostní tlak</span>
          </div>
        </li>
        <li>
          <span class="about__value-icon" aria-hidden="true">🤝</span>
          <div>
            <strong>Malé skupinky</strong>
            <span>Maximálně 8 dvojic na lekci</span>
          </div>
        </li>
        <li>
          <span class="about__value-icon" aria-hidden="true">💛</span>
          <div>
            <strong>Individuální přístup</strong>
            <span>Každé dítě cvičí ve svém tempu</span>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .about__media {
    position: relative;
  }

  .about__portrait {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .about__portrait svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .about__badge {
    position: absolute;
    bottom: -1.5rem;
    right: -1rem;
    background: white;
    border-radius: var(--radius-pill);
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    box-shadow: var(--shadow-pop);
    transform: rotate(-4deg);
  }

  .about__badge-num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-blush-vivid);
    line-height: 1;
  }

  .about__badge-text {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-ink-soft);
    line-height: 1.1;
    max-width: 80px;
  }

  .about__text h2 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin: 0 0 1.25rem;
  }

  .about__text h2 em {
    font-style: italic;
    color: var(--color-blush-vivid);
  }

  .about__lead {
    font-size: 1.15rem;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }

  .about__body {
    color: var(--color-ink-soft);
    margin: 0 0 2rem;
  }

  .about__body strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  .about__values {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .about__values li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: white;
    border-radius: 1rem;
    border: 1.5px solid var(--color-lilac-soft);
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .about__values li:hover {
    transform: translateX(4px);
    border-color: var(--color-blush-mid);
  }

  .about__value-icon {
    font-size: 1.5rem;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--color-cream);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .about__values strong {
    display: block;
    font-weight: 700;
    color: var(--color-ink);
  }

  .about__values span:not(.about__value-icon) {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  @media (max-width: 880px) {
    .about__inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .about__media { max-width: 380px; margin: 0 auto; }
  }
</style>
