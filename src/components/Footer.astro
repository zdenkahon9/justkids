---
import Icon from "astro-iconify";

import { locations } from "../data/locations";
import { site } from "../data/site";
import FacebookIcon from "./FacebookIcon.astro";
import InstagramIcon from "./InstagramIcon.astro";

const navLinks = [
  { href: "#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "#kempy", label: "Kempy & výjezdy" },
  { href: "/recenze", label: "Recenze" },
  { href: "#provozni-rad", label: "Provozní řád" },
];

const year = new Date().getFullYear();
---

<footer id="kontakt" class="footer" aria-labelledby="footer-title">
  <div class="container-x footer__inner">
    <div class="footer__brand">
      <a href="#hero" class="footer__brand-link" aria-label={`${site.name} - na začátek`}>
        <img src="/images/logo.png" alt="" width="56" height="56" />
        <div>
          <h2 id="footer-title">{site.name}</h2>
          <span class="footer__tagline">{site.tagline}</span>
        </div>
      </a>
      <p class="footer__about">
        Hravé cvičení pro miminka a děti od 3 měsíců do 9 let.
        <span class="footer__about-locations">Ve Zdicích, Hořovicích a Broumech.</span>
      </p>

      <div class="footer__social-wrap">
        <p class="footer__social-label">Sledujte nás</p>
        <div class="footer__social">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="footer__social-link footer__social-link--facebook"
          >
            <FacebookIcon width={32} height={32} />
          </a>
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="footer__social-link footer__social-link--instagram"
          >
            <InstagramIcon gradientId="footer-ig-grad" width={32} height={32} />
          </a>
        </div>
      </div>
    </div>

    <div class="footer__col footer__col--kontakt">
      <h3>Kontakt</h3>
      <ul>
        <li class="footer__instructor">{site.contact.instructorName}</li>

        <li class="footer__phone">
          <Icon name="ph:phone" class="footer__phone-icon" aria-hidden="true" />
          <a href={`tel:${site.contact.phone.replace(/\s/g, "")}`}>{site.contact.phone}</a
          >
        </li>
        <li class="footer__email">
          <Icon name="ph:envelope-simple" class="footer__email-icon" aria-hidden="true" />
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
      </ul>
    </div>

    <div class="footer__col footer__col--lokace">
      <h3>Lokace</h3>
      <ul>
        {
          locations.map((l) => (
            <li>
              <a href={l.mapUrl} target="_blank" rel="noopener noreferrer">
                <span class="footer__location-title">
                  <strong>{l.name}</strong>
                  <Icon
                    name="wordpress:external"
                    class="footer__location-external"
                    aria-hidden="true"
                  />
                </span>
                <span>
                  {l.street}, {l.city}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__col footer__col--navigace">
      <h3>Navigace</h3>
      <ul>
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container-x footer__bottom-inner">
      <span>© {year} {site.name}. Všechna práva vyhrazena.</span>
    </div>
  </div>
</footer>

<style>
  /* Base styles (mobile first) */

  .footer {
    scroll-margin-top: var(--nav-height);
    margin-top: var(--space-12);
    background: linear-gradient(
      180deg,
      #fff9f4 0%,
      #ffe1ed 30%,
      #ece1f7 70%,
      #d6ecfa 100%
    );
    border-top: 1px solid var(--color-lilac-soft);
    color: var(--color-ink);
  }

  #kontakt {
    scroll-margin-top: calc(-1 * var(--space-10));
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    padding-block: 2.25rem var(--space-7);
  }

  .footer__brand {
    text-align: left;
  }

  .footer__brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    margin-bottom: var(--space-4);
  }

  .footer__brand-link img {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
  }

  .footer__brand h2 {
    font-size: 2rem;
    margin: 0;
    line-height: var(--line-height-sm);
  }

  .footer__tagline {
    font-family: var(--font-brandmotto);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-blush-deep);
    margin-top: 2px;
    line-height: var(--line-height-xs);
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
  }

  .footer__about {
    color: var(--color-ink);
    margin: 0 0 var(--space-6);
    max-width: 22rem;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    text-align: left;
  }

  .footer__col {
    padding-top: 1.35rem;
    border-top: 1px solid rgba(236, 47, 142, 0.16);
  }

  .footer__social-wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  .footer__social-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-ink);
    text-align: left;
  }

  .footer__social {
    display: flex;
    justify-content: center;
    gap: var(--text-lg);
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: none;
    color: var(--color-ink);
    text-decoration: none;
    flex-shrink: 0;
    transform-origin: center;
    transition:
      transform 220ms ease,
      color 220ms ease,
      filter 220ms ease;
  }

  .footer__social-link :global(svg) {
    display: block;
    width: var(--footer-social-icon-size);
    height: var(--footer-social-icon-size);
  }

  /* Barvy značek (Facebook modrá, Instagram gradient je v SVG) */
  .footer__social-link--facebook {
    color: #1877f2;
  }

  .footer__social-link--instagram :global(svg) {
    transition: filter 220ms ease;
  }

  .footer__social-link:hover {
    transform: translateY(-3px) scale(1.12);
    color: var(--color-blush-vivid);
  }

  .footer__social-link--facebook:hover {
    color: #166fe5;
  }

  .footer__social-link--instagram:hover :global(svg) {
    filter: brightness(0.92);
  }

  .footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: var(--line-height-xl);
    color: var(--color-ink-soft);
    font-weight: 700;
    margin: 0 0 var(--space-5);
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  .footer__col.footer__col--kontakt ul {
    gap: var(--space-3);
  }

  .footer__col.footer__col--lokace ul {
    gap: var(--space-6);
  }

  .footer__col.footer__col--navigace ul {
    gap: var(--space-3);
  }

  .footer__col a {
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    transition: color 220ms ease;
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer__col a:hover {
    color: var(--color-blush-vivid);
  }

  .footer__col a strong {
    font-weight: 600;
  }

  .footer__location-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .footer__location-external {
    width: 1.125em;
    height: 1.125em;
    flex-shrink: 0;
    color: currentColor;
  }

  .footer__location-external :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .footer__col a > span:not(.footer__location-title) {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .footer__instructor {
    color: var(--color-ink);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .footer__phone,
  .footer__email {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer__phone-icon,
  .footer__email-icon {
    width: var(--text-lg);
    height: var(--text-lg);
    flex-shrink: 0;
    color: var(--color-ink);
  }

  .footer__bottom {
    border-top: 1px solid rgba(42, 31, 56, 0.08);
    padding-block: var(--space-4);
    background: rgba(255, 255, 255, 0.4);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  /* Media queries — layout only; spacing & sizes stay from mobile base */

  @media (min-width: 640px) {
    .footer__bottom-inner {
      justify-content: space-between;
      text-align: unset;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    /* Kontakt + Lokace vlevo pod sebou, Navigace vpravo přes obě řádky */
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "brand brand"
        "kontakt navigace"
        "lokace navigace";
      align-items: start;
    }

    .footer__brand {
      grid-area: brand;
    }

    .footer__col--kontakt {
      grid-area: kontakt;
    }

    .footer__col--lokace {
      grid-area: lokace;
    }

    .footer__col--navigace {
      grid-area: navigace;
    }
  }

  @media (min-width: 1024px) {
    .footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      grid-template-areas: none;
    }

    .footer__brand {
      grid-area: auto;
    }

    .footer__col--kontakt,
    .footer__col--lokace,
    .footer__col--navigace {
      grid-area: auto;
    }

    .footer__about {
      max-width: 240px;
      margin: 0 0 var(--space-8);
      font-size: var(--text-sm);
    }

    .footer__about-locations {
      display: block;
    }

    .footer__col a {
      font-size: var(--text-sm);
    }

    .footer__instructor {
      font-size: var(--text-sm);
    }

    .footer__col {
      padding-top: 0;
      border-top: none;
    }

    .footer__instructor,
    .footer__phone,
    .footer__email {
      min-height: 24px;
      display: flex;
      align-items: center;
      line-height: var(--line-height-2xl);
    }
  }
</style>
