---
import { site } from "../data/site";
import { locations } from "../data/locations";

const navLinks = [
  { href: "#o-mne", label: "O mně" },
  { href: "#vekove-kategorie", label: "Věkové kategorie" },
  { href: "#lokace", label: "Kde cvičíme" },
  { href: "#workshopy", label: "Workshopy" },
  { href: "#kempy", label: "Kempy & výjezdy" },
  { href: "#recenze", label: "Recenze" },
  { href: "#provozni-rad", label: "Provozní řád" },
];

const year = new Date().getFullYear();
---

<footer id="kontakt" class="footer" aria-labelledby="footer-title">
  <div class="container-x footer__inner">
    <div class="footer__brand">
      <a
        href="#hero"
        class="footer__brand-link"
        aria-label={`${site.name} - na začátek`}
      >
        <img src="/images/logo.png" alt="" width="56" height="56" />
        <div>
          <h2 id="footer-title">{site.name}</h2>
          <span class="footer__tagline">{site.tagline}</span>
        </div>
      </a>
      <p class="footer__about">
        Hravé cvičení pro miminka a děti od 3 měsíců do 3 let v Hořovicích a ve
        Zdicích.
      </p>

      <div class="footer__social">
        <a
          href={site.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="footer__social-link footer__social-link--facebook"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M 13 22 L 13 13 L 16 13 L 16.5 9.5 L 13 9.5 L 13 7.5 Q 13 6 14.5 6 L 16.5 6 L 16.5 2.5 Q 14 2 12.5 2 Q 9 2 9 6 L 9 9.5 L 6 9.5 L 6 13 L 9 13 L 9 22 Z"
              fill="currentColor"></path>
          </svg>
        </a>
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="footer__social-link footer__social-link--instagram"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <defs>
              <linearGradient
                id="footer-ig-grad"
                x1="0%"
                y1="100%"
                x2="100%"
                y2="0%"
              >
                <stop offset="0%" stop-color="#f09433"></stop>
                <stop offset="25%" stop-color="#e6683c"></stop>
                <stop offset="50%" stop-color="#dc2743"></stop>
                <stop offset="75%" stop-color="#cc2366"></stop>
                <stop offset="100%" stop-color="#bc1888"></stop>
              </linearGradient>
            </defs>
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              fill="none"
              stroke="url(#footer-ig-grad)"
              stroke-width="2"></rect>
            <circle
              cx="12"
              cy="12"
              r="4"
              fill="none"
              stroke="url(#footer-ig-grad)"
              stroke-width="2"></circle>
            <circle cx="17.5" cy="6.5" r="1.2" fill="url(#footer-ig-grad)"
            ></circle>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h3>Navigace</h3>
      <ul>
        {
          navLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer__col">
      <h3>Kontakt</h3>
      <ul>
        <li class="footer__instructor">{site.contact.instructorName}</li>

        <li>
          <a href={`tel:${site.contact.phone.replace(/\s/g, "")}`}
            >{site.contact.phone}</a
          >
        </li>
        <li>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
      </ul>
    </div>

    <div class="footer__col">
      <h3>Lokace</h3>
      <ul>
        {
          locations.map((l) => (
            <li>
              <a href={l.mapUrl} target="_blank" rel="noopener noreferrer">
                <strong>{l.name}</strong>
                <span>{l.street}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container-x footer__bottom-inner">
      <span>© {year} {site.name}. Všechna práva vyhrazena.</span>
      <span class="footer__made"
        >Vyrobeno s láskou pro maminky a tatínky
        <span class="footer__made-heart" aria-hidden="true">
          <svg
            class="footer__made-heart-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            ></path>
          </svg>
        </span></span
      >
    </div>
  </div>
</footer>

<style>
  .footer {
    scroll-margin-top: var(--nav-height);
    margin-top: 4rem;
    background: linear-gradient(
      180deg,
      #fff9f4 0%,
      #ffe1ed 30%,
      #ece1f7 70%,
      #d6ecfa 100%
    );
    border-top: 1px solid var(--color-lilac-soft);
    color: var(--color-ink);
  }

  #kontakt {
    scroll-margin-top: -3rem;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-block: 3rem 2rem;
  }

  .footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    margin-bottom: 1.5rem;
  }

  .footer__brand-link img {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
  }

  .footer__brand h2 {
    font-size: var(--text-2-5xl);
    margin: 0;
    line-height: var(--line-height-sm);
  }

  .footer__tagline {
    font-family: var(--font-brandmotto);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-blush-deep);
    margin-top: 2px;
    line-height: var(--line-height-xs);
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.6);
  }

  .footer__about {
    color: var(--color-ink);
    margin: 0 0 1.5rem;
    max-width: 28rem;
    font-size: var(--text-base);
    text-align: justify;
  }

  .footer__col {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(236, 47, 142, 0.16);
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: white;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-lilac-soft);
    color: var(--color-ink);
    text-decoration: none;
    flex-shrink: 0;
    transform-origin: center;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      background-color 220ms ease;
  }

  .footer__social-link svg {
    display: block;
  }

  /* Barvy značek (Facebook modrá, Instagram gradient je v SVG) */
  .footer__social-link--facebook {
    color: #1877f2;
  }

  .footer__social-link--instagram svg {
    transition: filter 220ms ease;
  }

  .footer__social-link:hover {
    transform: translateY(-3px) scale(1.12);
    border-color: var(--color-blush-mid);
    color: var(--color-blush-vivid);
  }

  .footer__social-link--facebook:hover {
    color: #166fe5;
  }

  .footer__social-link--instagram:hover svg {
    filter: brightness(0.92);
  }

  .footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: var(--line-height-xl);
    color: var(--color-ink-soft);
    font-weight: 700;
    margin: 0 0 1.25rem;
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }

  .footer__col a {
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    transition: color 220ms ease;
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer__col a:hover {
    color: var(--color-blush-vivid);
  }

  .footer__col a strong {
    font-weight: 700;
  }
  .footer__col a span {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  .footer__instructor {
    color: var(--color-ink);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .footer__bottom {
    border-top: 1px solid rgba(42, 31, 56, 0.08);
    padding-block: 1.5rem;
    background: rgba(255, 255, 255, 0.4);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    align-items: center;
    gap: 1rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .footer__made-heart {
    display: inline-flex;
    vertical-align: -0.12em;
    margin-left: 0.15em;
    color: #fda2e6;
  }

  .footer__made-heart-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    #kontakt {
      scroll-margin-top: var(--nav-height);
    }

    .footer__brand-link {
      margin-bottom: 1rem;
    }

    .footer__bottom-inner {
      justify-content: space-between;
      text-align: unset;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .footer__about {
      font-size: var(--text-base);
      text-align: left;
      max-width: 21rem;
    }

    /* Kontakt + Lokace vlevo pod sebou, Navigace vpravo přes obě řádky */
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "brand brand"
        "kontakt navigace"
        "lokace navigace";
      gap: 2rem;
      padding-block: 3rem 2rem;
      align-items: start;
    }

    .footer__brand {
      grid-area: brand;
    }

    .footer__inner > .footer__col:nth-child(2) {
      grid-area: navigace;
    }

    .footer__inner > .footer__col:nth-child(3) {
      grid-area: kontakt;
    }

    .footer__inner > .footer__col:nth-child(4) {
      grid-area: lokace;
    }
  }

  @media (min-width: 1024px) {
    .footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      grid-template-areas: none;
      gap: 3rem;
      padding-block: 4rem 3rem;
    }

    .footer__brand {
      grid-area: auto;
    }

    .footer__inner > .footer__col:nth-child(2),
    .footer__inner > .footer__col:nth-child(3),
    .footer__inner > .footer__col:nth-child(4) {
      grid-area: auto;
    }

    .footer__brand-link {
      margin-bottom: 1.5rem;
    }

    .footer__about {
      max-width: 240px;
      text-align: left;
    }

    .footer__col {
      padding-top: 0;
      border-top: none;
    }
  }
</style>
