---
import Icon from "astro-iconify";
import { reviews } from "../data/reviews";
import ReviewCard from "./ReviewCard.astro";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const HOME_REVIEW_COUNT = 3;
const MOBILE_SLIDE_COUNT = HOME_REVIEW_COUNT + 1;

const accentMap: Record<string, string> = {
  blush: "var(--color-blush-mid)",
  sky: "var(--color-sky-mid)",
  lilac: "var(--color-lilac-mid)",
};

const homeReviews = reviews.slice(0, HOME_REVIEW_COUNT);
---

<section id="recenze" class="section reviews" aria-labelledby="reviews-title">
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Co o nás říkají</span>
      <h2 id="reviews-title">
        Recenze <span class="section-title-accent">od rodičů</span>
      </h2>
      <p class="section-subtitle">
        Pár slov od maminek, které u nás cvičí. Děkujeme za vaši důvěru.
      </p>
    </header>

    <div class="reviews__mobile" aria-roledescription="carousel">
      <ul class="reviews__track" role="list">
        {
          homeReviews.map((r, i) => (
            <ReviewCard
              review={r}
              index={i}
              accent={accentMap[r.accent]}
              clamp
              showMore
              reveal={false}
            />
          ))
        }
        <li class="reviews__slide reviews__slide--cta">
          <article
            class="review review--cta"
            style={`--accent: ${cardAccentDeep("blush-deep")}; --accent-soft: ${cardAccentSoft("blush-deep")};`}
          >
            <span class="review--cta__top-rule" aria-hidden="true"></span>
            <div class="review--cta__illustration" aria-hidden="true">
              <span class="review--cta__icon-ring">
                <Icon
                  name="fluent:chat-multiple-20-regular"
                  class="review--cta__icon-graphic"
                />
              </span>
            </div>
            <p class="review--cta__text">
              Přečtěte si další zkušenosti rodičů.
            </p>
            <span class="review--cta__rule" aria-hidden="true"></span>
            <a class="review--cta__more" href="/recenze">
              Zobrazit všechny recenze
              <span aria-hidden="true">→</span>
            </a>
          </article>
        </li>
      </ul>

      <div class="reviews__dots" role="tablist" aria-label="Recenze">
        {
          Array.from({ length: MOBILE_SLIDE_COUNT }, (_, i) => (
            <button
              type="button"
              class={`reviews__dot${i === 0 ? " is-active" : ""}`}
              role="tab"
              aria-label={
                i < HOME_REVIEW_COUNT ? `Recenze ${i + 1}` : "Všechny recenze"
              }
              aria-selected={i === 0 ? "true" : "false"}
              data-index={i}
            />
          ))
        }
      </div>
    </div>

    <ul class="reviews__grid reviews__grid--desktop" role="list">
      {
        homeReviews.map((r, i) => (
          <ReviewCard
            review={r}
            index={i}
            accent={accentMap[r.accent]}
            clamp
            showMore
          />
        ))
      }
    </ul>

    <div class="reviews__all reveal">
      <a class="btn btn-primary" href="/recenze">
        Zobrazit všechny recenze
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script>
  const mobileQuery = window.matchMedia("(max-width: 767px)");

  const initReviewsCarousel = () => {
    const section = document.querySelector<HTMLElement>(".reviews");
    if (!section || section.dataset.carouselReady === "true") return;
    section.dataset.carouselReady = "true";

    const track = section.querySelector<HTMLElement>(".reviews__track");
    const slider = section.querySelector<HTMLElement>(".reviews__mobile");
    const desktopGrid = section.querySelector<HTMLElement>(
      ".reviews__grid--desktop",
    );
    const dots =
      slider?.querySelectorAll<HTMLButtonElement>(".reviews__dot") ?? [];
    const mobileCards = slider?.querySelectorAll<HTMLElement>(".review") ?? [];
    const desktopCards =
      desktopGrid?.querySelectorAll<HTMLElement>(".review") ?? [];

    const slides = track
      ? [...track.querySelectorAll<HTMLElement>(".reviews__slide")]
      : [];

    if (!track) return;

    const isCarouselActive = () => mobileQuery.matches && track.clientWidth > 0;

    const getClampedCards = () =>
      mobileQuery.matches ? [...mobileCards] : [...desktopCards];

    const getActiveIndex = () => {
      if (slides.length === 0) return 0;

      let activeIndex = 0;
      let smallestOffset = Number.POSITIVE_INFINITY;

      slides.forEach((slide, index) => {
        const offset = Math.abs(slide.offsetLeft - track.scrollLeft);
        if (offset < smallestOffset) {
          smallestOffset = offset;
          activeIndex = index;
        }
      });

      return activeIndex;
    };

    const goToSlide = (index: number) => {
      const slide = slides[index];
      if (!slide) return;

      track.scrollTo({
        left: slide.offsetLeft,
        behavior: "smooth",
      });
    };

    const updateDots = () => {
      if (!isCarouselActive()) return;

      const index = getActiveIndex();

      dots.forEach((dot, i) => {
        const isOn = i === index;
        dot.classList.toggle("is-active", isOn);
        dot.setAttribute("aria-selected", isOn ? "true" : "false");
      });
    };

    const resetToStart = () => {
      if (!isCarouselActive()) return;
      track.scrollLeft = 0;
      updateDots();
    };

    const updateReadMoreButtons = () => {
      getClampedCards().forEach((card) => {
        const text = card.querySelector<HTMLElement>(".review__text");
        const footer = card.querySelector<HTMLElement>(".review__footer");
        const button = card.querySelector<HTMLAnchorElement>(".review__more");
        if (!text || !button) return;

        const hideFooter = () => {
          button.hidden = true;
          if (footer) footer.hidden = true;
        };

        if (!text.classList.contains("review__text--clamp")) {
          hideFooter();
          return;
        }

        const shouldHide = text.scrollHeight <= text.clientHeight + 1;
        button.hidden = shouldHide;
        if (footer) footer.hidden = shouldHide;
      });
    };

    const refreshCarousel = () => {
      if (!isCarouselActive()) return;
      const slide = slides[getActiveIndex()];
      if (slide) track.scrollLeft = slide.offsetLeft;
      updateDots();
      updateReadMoreButtons();
    };

    track.addEventListener("scroll", updateDots, { passive: true });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goToSlide(Number(dot.dataset.index));
      });
    });

    const onViewportChange = () => {
      if (mobileQuery.matches) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            resetToStart();
            updateReadMoreButtons();
          });
        });
        return;
      }

      updateReadMoreButtons();
    };

    mobileQuery.addEventListener("change", onViewportChange);
    window.addEventListener("resize", onViewportChange);

    const resizeObserver = new ResizeObserver(() => {
      refreshCarousel();
      updateReadMoreButtons();
    });
    resizeObserver.observe(track);
    if (desktopGrid) resizeObserver.observe(desktopGrid);

    if (mobileQuery.matches) {
      requestAnimationFrame(() => {
        requestAnimationFrame(resetToStart);
      });
    } else {
      requestAnimationFrame(() => updateReadMoreButtons());
    }
  };

  initReviewsCarousel();
  document.addEventListener("astro:page-load", initReviewsCarousel);
</script>

<style>
  #recenze {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .reviews .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .reviews__mobile {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: var(--space-5);
  }

  .reviews__all {
    display: none;
  }

  .reviews__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    gap: var(--stack-gap);
    justify-content: center;
  }

  /* Vyšší specificita — .reviews__grid { display: grid } jinak přepíše skrytí na mobilu */
  .reviews__grid.reviews__grid--desktop {
    display: none;
  }

  .reviews__track {
    display: flex;
    width: 100%;
    max-width: var(--card-grid-width);
    margin: 0 auto;
    padding: 0;
    gap: 0;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-inline: 0;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  :global(.reviews__track > .reviews__slide) {
    display: flex;
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  :global(.reviews__track > .reviews__slide > .review) {
    flex: 1;
    width: 100%;
  }

  :global(.reviews__track > .reviews__slide:not(:last-child)) {
    margin-right: var(--stack-gap);
  }

  .reviews__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    max-width: var(--card-grid-width);
    margin-inline: auto;
    padding-inline: var(--space-2);
  }

  .reviews__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 18%, white);
    cursor: pointer;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .reviews__dot.is-active {
    background: var(--color-blush-vivid);
    transform: scale(1.15);
  }

  .reviews__dot:focus-visible {
    outline: 2px solid var(--color-blush-vivid);
    outline-offset: 2px;
  }

  .review--cta {
    box-sizing: border-box;
    background: #fefefe;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: none;
  }

  .review--cta__top-rule {
    display: block;
    width: 2.75rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--accent);
    margin: 0 auto var(--space-5);
  }

  .review--cta__illustration {
    display: flex;
    justify-content: center;
    margin: 0 0 var(--space-5);
  }

  .review--cta__icon-ring {
    display: grid;
    place-items: center;
    width: var(--card-icon-size-corner);
    height: var(--card-icon-size-corner);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .review--cta__icon-graphic {
    width: var(--card-icon-graphic-size-corner);
    height: var(--card-icon-graphic-size-corner);
  }

  .review--cta__text {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .review--cta__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: 0 0 var(--space-5);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
  }

  .review--cta__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: center;
    padding: 0;
    border: none;
    background: none;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    cursor: pointer;
  }

  .review--cta__more:hover,
  .review--cta__more:focus-visible {
    text-decoration: underline;
  }

  .review--cta__more:focus-visible {
    outline: 2px solid var(--color-blush-vivid);
    outline-offset: 3px;
    border-radius: var(--radius-full);
  }

  @media (min-width: 768px) {
    .reviews__mobile {
      display: none !important;
    }

    .reviews__grid.reviews__grid--desktop {
      display: grid;
      width: 100%;
      max-width: calc(
        3 * var(--card-grid-width-md) + 2 * var(--stack-gap)
      );
      margin-inline: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      justify-content: center;
    }

    .reviews__all {
      display: flex;
      justify-content: center;
      margin-top: var(--space-9);
    }

    .reviews__all :global(.btn) {
      width: auto;
      max-width: none;
      box-shadow: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .reviews__all :global(.btn-primary:hover) {
        box-shadow: var(--shadow-pop);
      }
    }

    .reviews__all :global(.btn-primary:active) {
      box-shadow: var(--shadow-pop);
      transform: translate3d(0, 0, 0) scale(0.98);
    }
  }
</style>
