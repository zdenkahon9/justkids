---
import { site } from "../data/site";
---

<section id="hero" class="hero" aria-label="Úvod">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__photo"></div>
    <div class="hero__veil"></div>
  </div>

  <div class="container-x hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">
        Hravé cvičení<br />
        s láskou a klidem
      </h1>
      <p class="hero__lead">
        Pro miminka a děti od 3 měsíců do 3 let. Společně objevujeme svět
        pohybu, smyslů a radosti - bez stresu, ve vlastním tempu. Těšíme se na
        vás v
        <strong>Hořovicích</strong> a <strong>Zdicích</strong>.
      </p>

      <div class="hero__cta">
        <a
          href={site.reservationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          data-testid="hero-cta"
        >
          Rezervovat lekci
          <span aria-hidden="true">→</span>
        </a>
        <a href="#vekove-skupiny" class="btn btn-ghost"> Prohlédnout kurzy </a>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__logo-wrap">
        <img
          src="/images/logo.png"
          alt="Logo JustKids"
          width="384"
          height="384"
          class="hero__logo"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <a href="#o-mne" class="hero__scroll" aria-label="Pokračovat dolů">
    <span></span>
  </a>

  <div class="hero__wave" aria-hidden="true">
    <svg
      class="hero__wave-svg"
      viewBox="0 0 1440 100"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        fill="var(--color-cream)"
        d="M0,51 C180,51 340,68 540,68 C720,68 820,51 920,51 C1080,51 1240,81 1440,85 L1440,100 L0,100 Z"
      ></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    --hero-wave-max: 10vh;
    position: relative;
    box-sizing: border-box;
    /* Full viewport height; fixed nav overlaps only the top — do NOT subtract nav from height (that caused the gap under the wave) */
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: 0;
    padding-top: var(--nav-height);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__photo {
    position: absolute;
    inset: -3%;
    background-image: url("/images/hero-balloons.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    will-change: transform;
    animation: hero-drift 22s ease-in-out infinite alternate;
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.06) translate(0, 0);
    }
    to {
      transform: scale(1.08) translate(-1%, -1%);
    }
  }

  /* Soft pastel veil — keeps text readable, blends with brand colors.
     Slightly more saturated under the headline so the white lettering
     contrasts against richer pastels (no gray, no flat cream) */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.45) 100%
      );
  }

  @keyframes float-slow {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-22px) rotate(3deg);
    }
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    width: 100%;
  }

  .hero__copy {
    animation: fade-up 800ms 100ms ease both;
    margin-top: 1rem;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__title {
    margin: 0 0 3rem;
    font-family: "Pacifico", "Caveat", cursive;
    font-weight: 400;
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    line-height: 1.15;
    letter-spacing: 0;
    color: #f5f5f5;
    text-shadow:
      0 2px 18px rgba(42, 31, 56, 0.2),
      0 1px 3px rgba(42, 31, 56, 0.28);
  }

  .hero__lead {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--color-ink-soft);
    max-width: 38rem;
    margin: 0 0 3rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Media side */
  .hero__media {
    display: grid;
    place-items: center;
    animation: fade-up 800ms 250ms ease both;
  }

  .hero__logo-wrap {
    position: relative;
    width: min(100%, 384px);
    aspect-ratio: 1;
  }

  .hero__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 30px 60px rgba(236, 47, 142, 0.35));
    animation: float-slow 8s ease-in-out infinite;
  }

  .hero__wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    line-height: 0;
    pointer-events: none;
    max-height: var(--hero-wave-max);
  }

  .hero__wave-svg {
    display: block;
    width: 100%;
    /* Hard cap 10vh — never ~25vh from vw-based clamps */
    max-height: var(--hero-wave-max);
    height: min(var(--hero-wave-max), clamp(48px, 7.5vw, 108px));
  }

  .hero__scroll {
    position: absolute;
    bottom: calc(min(var(--hero-wave-max), clamp(48px, 7.5vw, 108px)) + 1rem);
    left: 50%;
    z-index: 3;
    transform: translate(-50%, 52px);
    width: 28px;
    height: 44px;
    border: 2px solid rgba(42, 31, 56, 0.25);
    border-radius: 14px;
    display: grid;
    place-items: start center;
    padding-top: 8px;
    transition: border-color 220ms ease;
  }

  .hero__scroll:hover {
    border-color: var(--color-blush-deep);
  }

  .hero__scroll span {
    width: 4px;
    height: 8px;
    background: var(--color-blush-deep);
    border-radius: 2px;
    animation: scroll-down 1.6s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(14px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }

  @media (max-width: 880px) {
    .hero {
      padding: 0;
      padding-top: var(--nav-height);
      min-height: 100svh;
      min-height: 100dvh;
      height: auto;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero__media {
      display: none;
    }
    .hero__lead {
      margin-inline: auto;
    }
    .hero__cta {
      justify-content: center;
    }
    .hero__pills {
      justify-content: center;
    }
    .hero__scroll {
      display: none;
    }
  }
</style>
