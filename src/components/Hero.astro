---
import { Image } from "astro:assets";

import heroBalloons from "../assets/images/hero-balloons.png";
import heroBoy from "../assets/images/hero-boy.png";
import heroGym from "../assets/images/hero-gym.png";
import { site } from "../data/site";
---

<section id="hero" class="hero" aria-label="Úvod">
  <div class="hero__bg" aria-hidden="true">
    <Image
      src={heroBalloons}
      alt=""
      class="hero__photo"
      widths={[480, 768, 1024]}
      sizes="100vw"
      format="webp"
      priority
    />
    <Image
      src={heroGym}
      alt=""
      class="hero__gym"
      widths={[640, 899]}
      sizes="(min-width: 1024px) 58vw, 0px"
      format="webp"
      priority
    />
    <div class="hero__veil"></div>
  </div>

  <div class="container-x hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">
        Pohybem<br />
        <span class="hero__title-accent">k radosti</span>
        <svg
          class="hero__title-flourish"
          viewBox="70 180 1910 450"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M102 603C250 535 410 510 610 512C850 502 1060 527 1240 531C1430 535 1600 510 1730 468C1760 458 1779 447 1796 436C1724 380 1658 325 1673 263C1682 219 1702 198 1737 205C1768 211 1787 235 1801 257C1806 266 1804 278 1804 285C1808 246 1841 207 1876 202C1917 197 1942 219 1947 256C1955 315 1915 358 1879 387C1849 412 1822 430 1796 436C1827 458 1857 477 1891 489"
          ></path>
        </svg>
      </h1>
      <p class="hero__lead">
        Cvičení pro miminka a děti od 3 měsíců do 9 let. Společně objevujeme svět pohybu,
        smyslů a radosti - bez stresu, ve vlastním tempu. Těšíme se na vás ve
        <strong>Zdicích</strong>, <strong>Hořovicích</strong> a <strong>Broumech</strong>.
      </p>

      <div class="hero__cta">
        <a
          href={site.signupFormUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          data-testid="hero-cta"
        >
          Rezervovat lekci
          <span aria-hidden="true">→</span>
        </a>
        <a href="/vekove-kategorie" class="btn btn-ghost"> Prohlédnout kurzy </a>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__figure-wrap">
        <Image
          src={heroBoy}
          alt=""
          class="hero__figure"
          widths={[320, 480, 623]}
          sizes="(min-width: 1024px) min(41vw, 419px), 0px"
          format="webp"
          priority
        />
      </div>
    </div>
  </div>

  <a href="#o-mne" class="hero__scroll" aria-label="Pokračovat dolů">
    <span></span>
  </a>

  <div class="hero__wave" aria-hidden="true">
    <svg
      class="hero__wave-svg"
      viewBox="0 0 1440 100"
      preserveAspectRatio="xMidYMax meet"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        fill="var(--color-cream)"
        d="M0,51 C180,51 340,68 540,68 C720,68 820,51 920,51 C1080,51 1240,81 1440,85 L1440,100 L0,100 Z"
      ></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    /* Uniform scale (meet): height tracks viewBox aspect 100/1440 so steepness does not explode on narrow widths.
       Floor keeps iPhone SE from a paper-thin divider; no hard max — caps would force horizontal gutters with meet */
    --hero-wave-h: max(2.75rem, calc(100svw * 100 / 1440));
    position: relative;
    box-sizing: border-box;
    /* Full viewport height; fixed nav overlaps only the top — do NOT subtract nav from height (that caused the gap under the wave) */
    min-height: 100svh;
    height: auto;
    display: flex;
    align-items: center;
    padding: 0;
    padding-top: var(--nav-height);
    /* Tucks cream under the wave for zoom / subpixel rounding at the next section */
    padding-bottom: var(--space-4);
    overflow: hidden;
    isolation: isolate;
    /* Fills any 1px compositor gap so pink veil / photo never show at section fold */
    background-color: var(--color-cream);
    /* gap under lifted wave — same value on .hero::after + .hero__wave bottom */
    --hero-wave-mobile-lift: 0.75rem;
  }

  /* Cream strip under lifted wave — +2px / bottom:-1 kills subpixel hairline
     (rem/vh vs device px; z-index:-1 photo peeking between layers) */
  .hero::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: calc(var(--hero-wave-mobile-lift) + 2px);
    background: var(--color-cream);
    z-index: 0;
    pointer-events: none;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__photo {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    object-fit: cover;
    object-position: center;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    will-change: transform;
    animation: hero-drift 22s ease-in-out infinite alternate;
  }

  /* Gym photo — desktop only; asset is final, no filters applied */
  .hero__gym {
    display: none;
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.06) translate(0, 0);
    }
    to {
      transform: scale(1.08) translate(-1%, -1%);
    }
  }

  /* Soft pastel veil — keeps text readable, blends with brand colors.
     Slightly more saturated under the headline so the white lettering
     contrasts against richer pastels (no gray, no flat cream) */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.55) 72%,
        rgba(255, 249, 244, 0.95) 100%
      );
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-18);
    align-items: center;
    width: 100%;
    text-align: left;
    margin-top: 5rem;
  }

  .hero__copy {
    container-type: inline-size;
    animation: fade-up 800ms 100ms ease both;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-up-desktop {
    from {
      opacity: 0;
      transform: translate(20px, 32px);
    }
    to {
      opacity: 1;
      transform: translate(20px, 12px);
    }
  }

  .hero__title {
    position: relative;
    isolation: isolate;
    width: fit-content;
    margin: 0 0 var(--space-18);
    padding-left: var(--space-8);
    font-family: var(--font-hero);
    font-weight: 400;
    font-size: clamp(3.4rem, 19cqi, 5.625rem);
    line-height: 1.01;
    letter-spacing: -0.015em;
    color: #f5f5f5;
    text-shadow:
      0 2px 18px rgba(42, 31, 56, 0.2),
      0 1px 3px rgba(42, 31, 56, 0.28);
  }

  .hero__title span {
    display: inline-block;
    margin-left: 16px;
  }

  .hero__title-accent {
    position: relative;
  }

  .hero__title-flourish {
    position: absolute;
    z-index: -1;
    bottom: -0.12em;
    left: -0.02em;
    display: block;
    width: 130%;
    height: auto;
    overflow: visible;
    color: #ff4fa3;
    filter: drop-shadow(0 2px 8px rgba(42, 31, 56, 0.18));
    pointer-events: none;
  }

  .hero__title-flourish path {
    stroke: currentColor;
    stroke-width: 22;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__lead {
    font-size: var(--text-lg);
    color: var(--color-ink);
    max-width: 38rem;
    margin: 0 auto var(--space-18);
    padding-left: var(--space-8);
    text-align: left;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-10);
    margin-bottom: var(--space-18);
    justify-content: center;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Media side */
  .hero__media {
    display: none;
    place-items: center;
    animation: fade-in 800ms 250ms ease both;
  }

  .hero__figure-wrap {
    display: grid;
    place-items: end center;
    width: 100%;
  }

  .hero__figure {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center bottom;
  }

  .hero__wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--hero-wave-mobile-lift);
    z-index: 1;
    line-height: 0;
    pointer-events: none;
  }

  .hero__wave-svg {
    display: block;
    width: 100%;
    height: var(--hero-wave-h);
  }

  .hero__scroll {
    position: absolute;
    bottom: calc(var(--hero-wave-h) + 1rem);
    left: 50%;
    z-index: 3;
    transform: translate(-50%, 52px);
    width: 28px;
    height: 44px;
    border: 2px solid rgba(42, 31, 56, 0.25);
    border-radius: var(--radius-full);
    display: none;
    place-items: start center;
    padding-top: 8px;
    transition: border-color 220ms ease;
  }

  @media (max-width: 639px) {
    .hero__title-flourish {
      bottom: -0.28em;
      left: 0;
      width: 21.5rem;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .hero__title {
      margin: var(--space-15) 0 var(--space-19);
    }

    .hero__lead {
      font-size: var(--text-xl);
      margin: 0 auto var(--space-19);
    }

    .hero__cta {
      gap: var(--space-12);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: unset;
    }

    .hero__gym {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 58%;
      height: 100%;
      object-fit: cover;
      object-position: center right;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 18%,
        rgba(0, 0, 0, 0.55) 38%,
        rgba(0, 0, 0, 0.85) 52%,
        black 68%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 18%,
        rgba(0, 0, 0, 0.55) 38%,
        rgba(0, 0, 0, 0.85) 52%,
        black 68%
      );
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
    }

    .hero::after {
      content: none;
      display: none;
    }

    .hero__wave {
      bottom: 0;
    }

    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
      text-align: unset;
      align-items: stretch;
      min-height: calc(100svh - var(--nav-height) - var(--hero-wave-h));
    }

    .hero__copy {
      align-self: center;
      transform: translate(20px, 12px);
      animation: fade-up-desktop 800ms 100ms ease both;
    }

    .hero__title {
      margin: 0 0 var(--space-16);
      padding-left: 0;
      line-height: 1.01;
    }

    .hero__title span {
      display: inline-block;
      margin-left: 16px;
    }

    .hero__lead {
      margin: 0 0 var(--space-18);
      padding-left: 0;
      text-align: left;
    }

    .hero__cta {
      justify-content: flex-start;
    }

    .hero__pills {
      justify-content: flex-start;
    }

    .hero__media {
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .hero__figure-wrap {
      width: min(100%, 26.2rem);
      transform: translate(-2.8125rem, -6.3125rem);
    }

    .hero__figure {
      width: 100%;
      height: clamp(26.2rem, 62.4svh, 42.65625rem);
      object-fit: contain;
      object-position: center bottom;
    }

    .hero__scroll {
      display: grid;
    }
  }

  .hero__scroll:hover {
    border-color: var(--color-blush-deep);
  }

  .hero__scroll span {
    width: 4px;
    height: 8px;
    background: var(--color-blush-deep);
    border-radius: var(--radius-full);
    animation: scroll-down 1.6s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(14px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 0;
    }
  }
</style>
