---
import { site } from "../data/site";
---

<section id="hero" class="hero atmosphere" aria-label="Úvod">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__balloon hero__balloon--1"></div>
    <div class="hero__balloon hero__balloon--2"></div>
    <div class="hero__balloon hero__balloon--3"></div>
    <div class="hero__balloon hero__balloon--4"></div>
    <svg class="hero__shape" viewBox="0 0 600 600" fill="none" aria-hidden="true">
      <circle cx="300" cy="300" r="240" stroke="rgba(255,79,163,0.25)" stroke-dasharray="3 8" stroke-width="2"/>
      <circle cx="300" cy="300" r="180" stroke="rgba(91,169,221,0.25)" stroke-dasharray="3 8" stroke-width="2"/>
    </svg>
  </div>

  <div class="container-x hero__inner">
    <div class="hero__copy">
      <span class="eyebrow">Pojďte si hrát</span>
      <h1 class="hero__title">
        Hravé cvičení<br />
        s <em>láskou</em> a klidem
      </h1>
      <p class="hero__lead">
        Pro miminka a děti od 3 měsíců do 3 let. V Hořovicích a ve Zdicích.
        Společně objevujeme svět pohybu, smyslů a radosti - bez stresu, ve vlastním tempu.
      </p>

      <div class="hero__cta">
        <a
          href={site.reservationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          data-testid="hero-cta"
        >
          Rezervovat lekci
          <span aria-hidden="true">→</span>
        </a>
        <a href="#vekove-skupiny" class="btn btn-ghost">
          Co cvičíme
        </a>
      </div>

      <ul class="hero__pills" aria-label="Klíčové výhody">
        <li class="pill pill-blush">3 - 36 měsíců</li>
        <li class="pill pill-sky">2 lokace</li>
        <li class="pill pill-lilac">Malé skupinky</li>
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero__logo-wrap">
        <img
          src="/images/logo.png"
          alt="Logo JustKids"
          width="520"
          height="520"
          loading="eager"
          fetchpriority="high"
          class="hero__logo"
        />
        <span class="hero__sticker hero__sticker--1">3-6 měsíců</span>
        <span class="hero__sticker hero__sticker--2">6-12 měsíců</span>
        <span class="hero__sticker hero__sticker--3">1-2 roky</span>
      </div>
    </div>
  </div>

  <a href="#o-mne" class="hero__scroll" aria-label="Pokračovat dolů">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 7rem 0 5rem;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__shape {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(80vw, 700px);
    height: min(80vw, 700px);
    transform: translate(-50%, -50%);
    opacity: 0.6;
    animation: spin 60s linear infinite;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .hero__balloon {
    position: absolute;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    filter: blur(0.5px);
    opacity: 0.85;
  }

  .hero__balloon--1 {
    width: 110px; height: 130px;
    background: radial-gradient(circle at 30% 30%, #ffffff, #ffd1e0 60%, #ff9bbf);
    top: 12%; left: 8%;
    animation: float-slow 9s ease-in-out infinite;
  }
  .hero__balloon--2 {
    width: 80px; height: 95px;
    background: radial-gradient(circle at 30% 30%, #ffffff, #d6ecfa 60%, #a9d4f0);
    top: 28%; right: 14%;
    animation: float-medium 7s ease-in-out infinite;
  }
  .hero__balloon--3 {
    width: 65px; height: 78px;
    background: radial-gradient(circle at 30% 30%, #ffffff, #ece1f7 60%, #d4bff5);
    bottom: 18%; left: 18%;
    animation: drift 11s ease-in-out infinite;
  }
  .hero__balloon--4 {
    width: 55px; height: 65px;
    background: radial-gradient(circle at 30% 30%, #ffffff, #ffe1ed 60%, #fcc2d6);
    bottom: 30%; right: 8%;
    animation: float-slow 10s ease-in-out infinite reverse;
  }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-22px) rotate(3deg); }
  }
  @keyframes float-medium {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-14px) rotate(-3deg); }
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(12px, -12px); }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    width: 100%;
  }

  .hero__copy {
    animation: fade-up 800ms 100ms ease both;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero__title {
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    line-height: 0.98;
    margin: 0 0 1.5rem;
  }

  .hero__title em {
    font-style: italic;
    background: linear-gradient(90deg, #5ba9dd 0%, #b58be0 50%, #ec2f8e 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lead {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--color-ink-soft);
    max-width: 38rem;
    margin: 0 0 2rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Media side */
  .hero__media {
    display: grid;
    place-items: center;
    animation: fade-up 800ms 250ms ease both;
  }

  .hero__logo-wrap {
    position: relative;
    width: min(100%, 480px);
    aspect-ratio: 1;
  }

  .hero__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 30px 60px rgba(236, 47, 142, 0.35));
    animation: float-slow 8s ease-in-out infinite;
  }

  .hero__sticker {
    position: absolute;
    background: white;
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 14px 30px -14px rgba(123, 90, 160, 0.4);
    border: 2px solid;
    white-space: nowrap;
  }
  .hero__sticker--1 {
    top: 8%; left: -5%;
    color: var(--color-sky-deep);
    border-color: var(--color-sky-mid);
    transform: rotate(-8deg);
    animation: float-medium 6s ease-in-out infinite;
  }
  .hero__sticker--2 {
    top: 45%; right: -10%;
    color: var(--color-blush-vivid);
    border-color: var(--color-blush-mid);
    transform: rotate(6deg);
    animation: float-slow 7s ease-in-out infinite;
  }
  .hero__sticker--3 {
    bottom: 6%; left: 8%;
    color: var(--color-lilac-deep);
    border-color: var(--color-lilac-mid);
    transform: rotate(-4deg);
    animation: drift 9s ease-in-out infinite;
  }

  /* Scroll indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: 28px;
    height: 44px;
    border: 2px solid rgba(42, 31, 56, 0.25);
    border-radius: 14px;
    display: grid;
    place-items: start center;
    padding-top: 8px;
    transition: border-color 220ms ease;
  }

  .hero__scroll:hover { border-color: var(--color-blush-deep); }

  .hero__scroll span {
    width: 4px;
    height: 8px;
    background: var(--color-blush-deep);
    border-radius: 2px;
    animation: scroll-down 1.6s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0%   { transform: translateY(0); opacity: 1; }
    80%  { transform: translateY(14px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }

  @media (max-width: 880px) {
    .hero { padding: 7rem 0 4rem; min-height: auto; }
    .hero__inner { grid-template-columns: 1fr; text-align: center; }
    .hero__lead { margin-inline: auto; }
    .hero__cta { justify-content: center; }
    .hero__pills { justify-content: center; }
    .hero__sticker--1 { left: 2%; }
    .hero__sticker--2 { right: -2%; }
    .hero__scroll { display: none; }
  }
</style>
