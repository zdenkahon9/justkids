---
import { courses } from "../data/courses";
---

<section
  id="absolvovane-kurzy"
  class="section courses"
  aria-labelledby="courses-title"
>
  <div class="container-x">
    <header class="courses__header reveal">
      <span class="eyebrow">Vzdělání</span>
      <h2 id="courses-title">
        Absolvované <span class="section-title-accent">kurzy</span>
      </h2>
      <p class="courses__subtitle">
        Pravidelně se vzdělávám, abych vám i vašim dětem mohla nabídnout opravdu
        kvalitní lekce.
      </p>
    </header>

    <ol class="courses__list">
      {
        courses.map((c, i) => (
          <li
            class="courses__item reveal"
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="courses__year">{c.year ?? ""}</div>
            <div class="courses__body">
              <h3>{c.title}</h3>
              {c.detail && <p>{c.detail}</p>}
            </div>
            <div class="courses__check" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22">
                <path
                  d="M 5 12 L 10 17 L 19 7"
                  stroke="currentColor"
                  stroke-width="2.5"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  #absolvovane-kurzy {
    scroll-margin-top: -5.5rem;
  }
  .courses {
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--color-cream-100) 30%,
      var(--color-cream-100) 70%,
      transparent 100%
    );
  }

  .courses__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }

  .courses__header h2 {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    margin: 0 0 1.5rem;
  }

  .courses__header h2 .section-title-accent {
    color: var(--color-sky-deep);
  }

  .courses__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  @media (min-width: 1024px) {
    .courses__header h2 {
      margin: 0 0 1rem;
    }

    .courses__subtitle {
      font-size: 1.0625rem;
    }
  }

  .courses__list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 52rem;
    display: grid;
    gap: 1rem;
  }

  .courses__item {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "year check"
      "body body";
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 1.75rem;
    background: white;
    border-radius: 1.25rem;
    border: 1.5px solid var(--color-lilac-soft);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .courses__item:hover {
    transform: translateX(6px);
    border-color: var(--color-blush-mid);
    box-shadow: var(--shadow-soft);
  }

  .courses__year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-sky-deep);
    min-width: 60px;
    grid-area: year;
  }

  .courses__body h3 {
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .courses__body p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }

  .courses__body {
    grid-area: body;
  }

  .courses__check {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-blush-soft);
    color: var(--color-blush-vivid);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    grid-area: check;
  }

  @media (min-width: 640px) {
    .courses__item {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: none;
    }

    .courses__year {
      grid-area: auto;
      font-size: 1.5rem;
    }

    .courses__body {
      grid-area: auto;
    }

    .courses__check {
      grid-area: auto;
    }
  }
</style>
