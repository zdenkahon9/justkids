---
import Icon from "astro-iconify";
import { rules } from "../data/rules";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";
---

<section id="provozni-rad" class="section rules" aria-labelledby="rules-title">
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Provozní řád</span>
      <h2 id="rules-title">
        Pár pravidel <span class="section-title-accent">pro všechny</span>
      </h2>
      <p class="section-subtitle">
        Pro hladký průběh lekcí a příjemnou atmosféru.
      </p>
    </header>

    <ol class="rules__list">
      {
        rules.map((rule, i) => (
          <li
            class="rules__item"
            style={`--accent: ${cardAccentDeep(rule.accent)}; --accent-soft: ${cardAccentSoft(rule.accent)};`}
          >
            <div
              class="rules__content reveal"
              style={`transition-delay: ${i * 80}ms;`}
            >
              {rule.icon ? (
                <div class="rules__illustration" aria-hidden="true">
                  <span class="rules__icon-ring">
                    <Icon name={rule.icon} class="rules__icon-graphic" />
                  </span>
                </div>
              ) : null}
              <div class="rules__text">
                <h3 class="rules__title">{rule.title.replace(/\n/g, " ")}</h3>
                <p class="rules__detail">{rule.detail}</p>
                <svg
                  class="rules__scribble"
                  viewBox="0 0 140 12"
                  aria-hidden="true"
                >
                  <path
                    d="M6,10 C45,2 95,3 134,9"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    fill="none"></path>
                </svg>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rules {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .rules .section-title-accent {
    color: var(--color-sky-deep);
  }

  /* Mobile-first: kompaktnější header; od 640px globální spacing */
  .rules .section-header {
    --section-header-spacing: var(--space-8);
  }

  @media (min-width: 640px) {
    .rules .section-header {
      --section-header-spacing: var(--space-10);
    }
  }

  .rules__list {
    --rules-icon-size: 4.5rem;
    --rules-icon-graphic-size: 2.125rem;
    --rules-line-blush: color-mix(
      in srgb,
      var(--color-blush-deep) 30%,
      var(--color-ink) 8%
    );
    --rules-line-sky: color-mix(
      in srgb,
      var(--color-sky-deep) 30%,
      var(--color-ink) 8%
    );

    list-style: none;
    position: relative;
    padding: var(--card-padding-y) 0 0;
    margin: 0 auto;
    width: 100%;
    max-width: var(--card-grid-width);
    display: flex;
    flex-direction: column;
  }

  .rules__item {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
  }

  .rules__item:not(:last-child) {
    padding-bottom: var(--space-12);
  }

  .rules__item:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(var(--rules-icon-size) / 2);
    top: var(--rules-icon-size);
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    background: var(--rules-line-blush);
    pointer-events: none;
  }

  .rules__item:last-child .rules__illustration::after {
    content: "";
    position: absolute;
    left: 50%;
    top: var(--rules-icon-size);
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    background: var(--rules-line-sky);
    pointer-events: none;
  }

  .rules__content {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    box-sizing: border-box;
  }

  .rules__illustration {
    position: relative;
    flex-shrink: 0;
    align-self: stretch;
  }

  .rules__text {
    flex: 1;
    min-width: 0;
  }

  .rules__title {
    margin: 0 0 var(--space-4);
    min-width: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .rules__icon-ring {
    display: grid;
    place-items: center;
    width: var(--rules-icon-size);
    height: var(--rules-icon-size);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 280ms ease;
  }

  .rules__icon-graphic {
    width: var(--rules-icon-graphic-size);
    height: var(--rules-icon-graphic-size);
  }

  .rules__detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .rules__scribble {
    display: none;
  }

  @media (min-width: 768px) {
    .rules__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
      max-width: 900px;
    }

    .rules__list::before {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
      width: 1px;
      height: 9rem;
      background: repeating-linear-gradient(
        to bottom,
        rgba(42, 31, 56, 0.22) 0 5px,
        transparent 5px 12px
      );
      pointer-events: none;
    }

    .rules__item:not(:last-child) {
      padding-bottom: 0;
    }

    .rules__item:not(:last-child)::after,
    .rules__item:last-child .rules__illustration::after {
      display: none;
    }

    .rules__item {
      justify-self: center;
      width: 100%;
      max-width: 22rem;
    }

    .rules__content {
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
      text-align: center;
      width: 100%;
    }

    .rules__illustration {
      align-self: auto;
    }

    .rules__scribble {
      display: block;
      width: 7.5rem;
      height: 0.75rem;
      margin: 1.5625rem auto 0;
      color: color-mix(in srgb, var(--accent) 62%, white);
    }
  }

  @media (min-width: 1024px) {
    .rules__detail {
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 1180px) {
    .rules__list {
      max-width: 980px;
      gap: var(--space-8);
    }
  }
</style>
