---
import Icon from "astro-iconify";

import { rules } from "../data/rules";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";
---

<section id="provozni-rad" class="section rules" aria-labelledby="rules-title">
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Provozní řád</span>
      <h2 id="rules-title">
        Pár pravidel <span class="section-title-accent">pro všechny</span>
      </h2>
      <p class="section-subtitle">Pro hladký průběh lekcí a příjemnou atmosféru.</p>
    </header>

    <ol class="rules__list">
      {
        rules.map((rule, i) => (
          <li
            class="rules__item"
            style={`--accent: ${cardAccentDeep(rule.accent)}; --accent-soft: ${cardAccentSoft(rule.accent)}; --rules-row: ${Math.floor(i / 2) + 1};`}
          >
            <div class="rules__content">
              {rule.icon ? (
                <div class="rules__illustration" aria-hidden="true">
                  <span class="rules__icon-ring">
                    {rule.icon === "local:phone-off" ? (
                      <svg
                        class="rules__icon-graphic"
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="5.5" y="1.5" width="9" height="17" rx="2.5" />
                        <circle
                          cx="10"
                          cy="15.4"
                          r="0.7"
                          fill="currentColor"
                          stroke="none"
                        />
                        <path d="M3 2.5 17 17.5" />
                      </svg>
                    ) : (
                      <Icon
                        name={rule.icon}
                        class={`rules__icon-graphic${rule.icon === "material-symbols-light:handshake-outline-rounded" ? " rules__icon-graphic--bold" : ""}${rule.icon === "fluent:hand-open-heart-20-regular" ? " rules__icon-graphic--lg" : ""}`}
                      />
                    )}
                  </span>
                </div>
              ) : null}
              <div class="rules__text">
                <h3 class="rules__title">{rule.title.replace(/\n/g, " ")}</h3>
                <p class="rules__detail">{rule.detail}</p>
                <svg class="rules__scribble" viewBox="0 0 140 12" aria-hidden="true">
                  <path
                    d="M6,10 C45,2 95,3 134,9"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    fill="none"
                  />
                </svg>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rules {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .rules .section-title-accent {
    color: var(--color-sky-deep);
  }

  /* Mobile-first: kompaktnější header; od 640px globální spacing */
  .rules .section-header {
    --section-header-spacing: var(--space-10);
  }

  @media (min-width: 640px) {
    .rules .section-header {
      --section-header-spacing: var(--space-10);
    }
  }

  .rules__list {
    --rules-icon-size: 4.5rem;
    --rules-icon-graphic-size: 2.125rem;
    --rules-line-blush: color-mix(
      in srgb,
      var(--color-blush-deep) 30%,
      var(--color-ink) 8%
    );
    --rules-line-sky: color-mix(in srgb, var(--color-sky-deep) 30%, var(--color-ink) 8%);

    list-style: none;
    position: relative;
    padding: var(--card-padding-y) 0 0;
    margin: 0 auto;
    width: 100%;
    max-width: var(--card-grid-width);
    display: flex;
    flex-direction: column;
  }

  .rules__item {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
  }

  .rules__item:not(:last-child) {
    padding-bottom: var(--space-10);
  }

  .rules__content {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    box-sizing: border-box;
  }

  .rules__illustration {
    position: relative;
    flex-shrink: 0;
    align-self: stretch;
  }

  .rules__text {
    flex: 1;
    min-width: 0;
  }

  .rules__title {
    margin: 0 0 var(--space-4);
    min-width: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .rules__icon-ring {
    display: grid;
    place-items: center;
    width: var(--rules-icon-size);
    height: var(--rules-icon-size);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 280ms ease;
  }

  .rules__icon-graphic {
    width: var(--rules-icon-graphic-size);
    height: var(--rules-icon-graphic-size);
  }

  /* Ztloustnutí „outline“ ikon z Iconify (kreslené výplní, ne tahem):
     přidáme tah v barvě výplně kolem celé kontury */
  .rules__icon-graphic--bold {
    stroke: currentColor;
    stroke-width: 0.4;
    stroke-linejoin: round;
    stroke-linecap: round;
    transform: scale(1.15);
  }

  /* Zvětšení vybrané ikony (vizuální dorovnání velikosti) */
  .rules__icon-graphic--lg {
    transform: scale(1.15);
  }

  .rules__detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .rules__scribble {
    display: none;
  }

  /* ===== Mobil (do 767px): časová osa vlevo, uzlíky = ikony ===== */
  @media (max-width: 767.98px) {
    .rules__list {
      /* menší kruh i ikona */
      --rules-icon-size: 3.5rem;
      --rules-icon-graphic-size: 1.625rem;
      --rules-line-color: color-mix(in srgb, var(--color-ink) 14%, transparent);

      padding-top: 0;
      padding-bottom: 0;
    }

    /* Svislá osa vede skrz středy ikon, ikony ji zakrývají */
    .rules__list::before {
      content: "";
      position: absolute;
      left: calc(var(--rules-icon-size) / 2);
      top: calc(var(--rules-icon-size) / 2);
      bottom: calc(var(--rules-icon-size) / 2);
      width: 1px;
      transform: translateX(-50%);
      background: var(--rules-line-color);
      pointer-events: none;
      z-index: 0;
    }
  }

  /* ===== Desktop (od 768px): timeline se dvěma sloupci, bez karet ===== */
  @media (min-width: 768px) {
    .rules__item:not(:last-child) {
      padding-bottom: 0;
    }

    .rules__list {
      /* mezera mezi sloupci – uprostřed vede osa */
      --rules-col-gap: 7rem;
      --rules-node-size: 0.85rem;
      --rules-line-color: color-mix(in srgb, var(--color-ink) 16%, transparent);

      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--rules-col-gap);
      row-gap: var(--space-12);
      align-items: start;
      max-width: 62rem;
      padding: 0;
    }

    /* prostřední svislá osa */
    .rules__list::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      transform: translateX(-50%);
      width: 1px;
      height: auto;
      background: var(--rules-line-color);
      pointer-events: none;
    }

    /* vypneme případné mobilní spojnice */
    .rules__item:not(:last-child)::after,
    .rules__item:last-child .rules__illustration::after {
      display: none;
    }

    .rules__item {
      grid-row: var(--rules-row);
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
    }

    /* liché řádky vlevo, sudé vpravo */
    .rules__item:nth-child(odd) {
      grid-column: 1;
    }

    .rules__item:nth-child(even) {
      grid-column: 2;
    }

    /* ikona na střed textu (nadpis + detail), ne prázdného bloku */
    .rules__content {
      position: relative;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--space-4);
      box-sizing: border-box;
      text-align: left;
      width: 100%;
    }

    .rules__text {
      flex: 1;
      min-width: 0;
    }

    .rules__illustration {
      position: relative;
      flex-shrink: 0;
      align-self: center;
    }

    .rules__title {
      margin: 0 0 var(--space-2);
      font-size: var(--text-lg);
    }

    .rules__detail {
      margin: 0;
      color: var(--color-ink);
    }

    .rules__scribble {
      display: none;
    }

    /* uzlík na ose – zarovnaný se středem ikony (střed .rules__content) */
    .rules__item:nth-child(odd) .rules__content::before {
      content: "";
      position: absolute;
      top: 50%;
      right: calc(-1 * var(--rules-col-gap) / 2);
      width: var(--rules-node-size);
      height: var(--rules-node-size);
      border-radius: var(--radius-full);
      background: var(--color-blush-deep);
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-blush-deep) 18%, transparent);
      transform: translate(50%, -50%);
      z-index: 2;
    }
  }

  @media (min-width: 1024px) {
    .rules__list {
      --rules-icon-size: 3.5rem;
      --rules-icon-graphic-size: 1.625rem;
      --rules-detail-row: calc(3 * var(--text-lg) * var(--line-height-base));
    }

    .rules__title {
      font-size: var(--text-5xl);
    }

    .rules__detail {
      min-height: var(--rules-detail-row);
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 1180px) {
    .rules__list {
      max-width: 66rem;
      --rules-col-gap: 8rem;
    }
  }
</style>
