---
import Icon from "astro-iconify";
import { ageGroupsHomeCards } from "../data/ageGroupsHome";
import {
  ageGroupsPageWithParents,
  ageGroupsPageWithoutParents,
  ageGroupsPageMeta,
} from "../data/ageGroupsPage";
import { scheduleMeta } from "../data/schedule";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = ageGroupsPageMeta;

const agePageWithParentsSection = ageGroupsHomeCards.find(
  (card) => card.id === "s-rodici",
)!;

const agePageWithoutParentsSection = ageGroupsHomeCards.find(
  (card) => card.id === "bez-rodicu",
)!;

/** Accent karet — cvičení s rodiči */
const agePageCardThemesWithParents = [
  {
    deep: cardAccentDeep("blush-deep"),
    soft: cardAccentSoft("blush-deep"),
  },
  {
    deep: cardAccentDeep("lilac-deep"),
    soft: cardAccentSoft("lilac-deep"),
  },
  {
    deep: cardAccentDeep("sky-deep"),
    soft: cardAccentSoft("sky-deep"),
  },
  {
    deep: cardAccentDeep("cream"),
    soft: "color-mix(in srgb, var(--color-blush-deep) 7%, var(--color-cream-200) 93%)",
  },
] as const;

/** Accent karet — cvičení bez rodičů (stejné pořadí jako s rodiči: blush → lilac → …) */
const agePageCardThemesWithoutParents = [
  {
    deep: cardAccentDeep("blush-deep"),
    soft: cardAccentSoft("blush-deep"),
  },
  {
    deep: cardAccentDeep("lilac-deep"),
    soft: cardAccentSoft("lilac-deep"),
  },
] as const;
---

<section
  id={meta.sectionId}
  class="section age-page"
  aria-labelledby="age-page-title"
>
  <div class="age-page__intro">
    <div class="age-page__intro-nav-bg" aria-hidden="true">
      <div class="age-page__intro-photo"></div>
      <div class="age-page__intro-veil"></div>
    </div>
    <div class="container-x age-page__intro-inner">
      <header class="section-header reveal">
        <h1 id="age-page-title">
          {meta.title}{" "}
          <span class="section-title-accent">{meta.titleAccent}</span>
        </h1>
        <p class="section-subtitle">{meta.subtitle}</p>
      </header>
    </div>
  </div>

  <div class="container-x">
    <div class="age-page__filter reveal">
      <nav
        class="age-page__pill age-page__pill--split"
        aria-label="Přejít na kategorii"
      >
        <a
          href={`#${agePageWithParentsSection.id}`}
          class="age-page__pill-half age-page__pill-half--with-parents"
        >
          S rodiči
        </a>
        <a
          href={`#${agePageWithoutParentsSection.id}`}
          class="age-page__pill-half age-page__pill-half--without-parents"
        >
          Bez rodičů
        </a>
      </nav>

      <div class="age-page__pill age-page__pill--schedule">
        <a href={`#${scheduleMeta.sectionId}`} class="age-page__pill-schedule">
          <span class="age-page__pill-schedule-icon" aria-hidden="true">
            <Icon
              name="lineicons:calendar-days"
              class="age-page__pill-schedule-graphic"
            />
          </span>
          Rozvrh lekcí
        </a>
      </div>
    </div>

    <h2
      id={agePageWithParentsSection.id}
      class="age-page__group-heading reveal"
      style={`--accent: ${cardAccentDeep(agePageWithParentsSection.accent)};`}
    >
      <span class="age-page__group-heading-icon" aria-hidden="true">
        <Icon
          name={agePageWithParentsSection.icon}
          class="age-page__group-heading-graphic"
        />
      </span>
      {agePageWithParentsSection.title}
    </h2>

    <ul class="age-page__grid">
      {
        ageGroupsPageWithParents.map((g, i) => (
          <li>
            <article
              class="age-page__card reveal"
              style={`--accent: ${agePageCardThemesWithParents[i].deep}; --accent-soft: ${agePageCardThemesWithParents[i].soft}; transition-delay: ${i * 80}ms;`}
            >
              <svg
                class="age-page__blob"
                viewBox="-32 0 132 100"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M100 0 H-32 L0 0 A100 100 0 0 1 100 90 Z" />
              </svg>
              <div class="age-page__body">
                <div class="age-page__content">
                  <h3 class="age-page__heading">{g.title}</h3>
                  <div class="age-page__age-block">
                    <div class="age-page__age-row">
                      <span class="age-page__age">{g.range}</span>
                      <div class="age-page__illustration" aria-hidden="true">
                        <span class="age-page__icon-ring">
                          <Icon name={g.icon} class="age-page__icon-graphic" />
                        </span>
                      </div>
                    </div>
                    {g.groupsLabel ? (
                      <p class="age-page__groups">{g.groupsLabel}</p>
                    ) : null}
                  </div>
                  <span class="age-page__rule" aria-hidden="true" />
                  <p class="age-page__summary">{g.description}</p>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <h2
      id={agePageWithoutParentsSection.id}
      class="age-page__group-heading reveal"
      style={`--accent: ${cardAccentDeep(agePageWithoutParentsSection.accent)};`}
    >
      <span class="age-page__group-heading-icon" aria-hidden="true">
        <Icon
          name={agePageWithoutParentsSection.icon}
          class="age-page__group-heading-graphic"
        />
      </span>
      {agePageWithoutParentsSection.title}
    </h2>

    <ul class="age-page__grid">
      {
        ageGroupsPageWithoutParents.map((g, i) => (
          <li>
            <article
              class="age-page__card reveal"
              style={`--accent: ${agePageCardThemesWithoutParents[i].deep}; --accent-soft: ${agePageCardThemesWithoutParents[i].soft}; transition-delay: ${i * 80}ms;`}
            >
              <svg
                class="age-page__blob"
                viewBox="-32 0 132 100"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M100 0 H-32 L0 0 A100 100 0 0 1 100 90 Z" />
              </svg>
              <div class="age-page__body">
                <div class="age-page__content">
                  <h3 class="age-page__heading">{g.title}</h3>
                  <div class="age-page__age-block">
                    <div class="age-page__age-row">
                      <span class="age-page__age">{g.range}</span>
                      <div class="age-page__illustration" aria-hidden="true">
                        <span class="age-page__icon-ring">
                          <Icon name={g.icon} class="age-page__icon-graphic" />
                        </span>
                      </div>
                    </div>
                    {g.groupsLabel ? (
                      <p class="age-page__groups">{g.groupsLabel}</p>
                    ) : null}
                  </div>
                  <span class="age-page__rule" aria-hidden="true" />
                  <p class="age-page__summary">{g.description}</p>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .age-page {
    --age-page-anchor-offset: calc(var(--nav-height) + var(--space-10));
    --age-page-anchor-offset-groups: calc(var(--nav-height) + var(--space-2));
    padding-top: 0;
    scroll-margin-top: var(--nav-height);
    background-color: var(--color-cream);
  }

  /* Mini page-hero — pod navbarom rovnaká vrstva ako v hero (balonky + veil) */
  .age-page__intro {
    position: relative;
    background-color: var(--color-cream);
  }

  .age-page__intro-nav-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /*
   * Hero photo/veil live on a ~100svh canvas; cover on a nav-height strip alone
   * zooms to a different crop. Mirror hero dimensions, clip only the top strip.
   */
  .age-page__intro-photo {
    position: absolute;
    left: -3%;
    right: -3%;
    top: -3svh;
    height: 106svh;
    background-image: url("/images/hero-balloons.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    transform-origin: center top;
  }

  .age-page__intro-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100svh;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.55) 72%,
        rgba(255, 249, 244, 0.95) 100%
      );
  }

  .age-page__intro-inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-height) + var(--section-header-spacing));
  }

  .age-page__intro .section-header {
    margin-bottom: var(--section-header-spacing);
  }

  .age-page .section-header h1 {
    font-size: var(--text-clamp-h2);
    margin: 0 0 2rem;
  }

  .age-page .section-title-accent {
    color: var(--color-blush-vivid);
  }

  @media (max-width: 639px) {
    .age-page {
      --section-header-spacing: 3rem;
    }

    .age-page .section-header {
      --section-header-spacing: 3rem;
    }
  }

  .age-page__filter {
    position: relative;
    z-index: 10;
    width: min(100%, var(--card-grid-width));
    margin: 0 auto var(--space-9);
  }

  /* Pill — společný základ pro obě pilulky (stejné parametry) */
  .age-page__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--radius-full);
    border: 1.5px solid rgba(42, 31, 56, 0.12);
    background: #fefefe;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    white-space: nowrap;
    padding: 1rem 1.625rem;
    min-height: calc(2rem + 1em * var(--line-height-base));
  }

  .age-page__pill--split {
    padding: 0;
    align-items: stretch;
  }

  .age-page__pill + .age-page__pill {
    margin-top: var(--space-4);
  }

  /* První pilulka rozdělená na dvě poloviny */
  .age-page__pill-half {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: 1rem 1.625rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 220ms ease;
  }

  .age-page__pill-half + .age-page__pill-half {
    position: relative;
    border-left: none;
  }

  .age-page__pill-half + .age-page__pill-half::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: calc(100% - 0.875rem);
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    pointer-events: none;
  }

  .age-page__pill-half--with-parents {
    color: var(--color-blush-deep);
    --accent-soft: var(--color-blush-soft);
    --age-page-pill-scroll-offset: var(--age-page-anchor-offset-groups);
  }

  .age-page__pill-half--without-parents {
    color: var(--color-sky-deep);
    --accent-soft: var(--color-sky-soft);
    --age-page-pill-scroll-offset: var(--age-page-anchor-offset-groups);
  }

  .age-page__pill-half:hover,
  .age-page__pill-half:focus-visible,
  .age-page__pill-half:active {
    background: var(--accent-soft);
    outline: none;
  }

  .age-page__pill--schedule {
    padding: 0;
    align-items: stretch;
  }

  /* Druhá pilulka — Rozvrh lekcí */
  .age-page__pill-schedule {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    gap: 0.6rem;
    width: 100%;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: 1rem 1.625rem;
    color: var(--color-lilac-deep);
    --accent-soft: var(--color-lilac-soft);
    font: inherit;
    font-weight: 600;
    line-height: var(--line-height-base);
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 220ms ease;
  }

  .age-page__pill-schedule:hover,
  .age-page__pill-schedule:focus-visible,
  .age-page__pill-schedule:active {
    background: var(--accent-soft);
    outline: none;
  }

  .age-page__pill-schedule-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-lilac-deep);
  }

  .age-page__pill-schedule-graphic {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .age-page__pill-schedule-graphic :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .age-page__filter + .age-page__group-heading,
  .age-page__grid + .age-page__group-heading {
    scroll-margin-top: var(--age-page-anchor-offset-groups);
  }

  .age-page__group-heading {
    scroll-margin-top: var(--age-page-anchor-offset);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: min(100%, var(--card-grid-width));
    margin: 0 auto var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-2-5xl);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .age-page__grid + .age-page__group-heading {
    margin-top: var(--space-10);
  }

  .age-page__group-heading-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--accent);
  }

  .age-page__group-heading-graphic {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    transform: translateY(-0.125rem);
  }

  /* Mobile-first: stejný layout karet jako AgeGroupsHome */
  .age-page__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .age-page__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
  }

  .age-page__blob {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    width: 9.9rem;
    height: 7.5rem;
    display: block;
    pointer-events: none;
  }

  .age-page__blob path {
    fill: var(--accent-soft);
  }

  .age-page__body {
    position: relative;
    z-index: 1;
  }

  .age-page__age-row {
    --age-icon-nudge: -0.05rem;
    position: relative;
    padding-right: calc(var(--card-icon-size-corner) + var(--space-4));
  }

  .age-page__illustration {
    position: absolute;
    top: 50%;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--card-icon-size-corner);
    pointer-events: none;
    transform: translateY(calc(-50% + var(--age-icon-nudge)));
  }

  .age-page__icon-ring {
    display: grid;
    place-items: center;
    width: var(--card-icon-size-corner);
    height: var(--card-icon-size-corner);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .age-page__icon-graphic {
    width: var(--card-icon-graphic-size-corner);
    height: var(--card-icon-graphic-size-corner);
  }

  .age-page__heading {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .age-page__age-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: 0;
  }

  .age-page__age-block:not(:has(.age-page__groups)) {
    margin-bottom: var(--space-4);
  }

  /* Stejná rezerva jako groups řádek (rule zarovnání napříč kartami) */
  .age-page__age-block:not(:has(.age-page__groups))::after {
    content: "";
    display: block;
    height: calc(var(--text-base) * var(--line-height-xl));
  }

  .age-page__age {
    display: block;
    width: 100%;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--accent);
  }

  .age-page__groups {
    margin: 0 0 var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink-muted);
  }

  .age-page__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: 0 0 var(--space-5);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
  }

  .age-page__summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .age-page__filter,
    .age-page__group-heading {
      width: min(100%, calc(2 * var(--card-grid-width-md) + var(--stack-gap)));
    }

    .age-page__grid {
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--card-grid-width-md));
      justify-content: center;
    }
  }

  @media (min-width: 1180px) {
    .age-page__grid {
      max-width: calc(2 * var(--card-grid-width-md) + var(--stack-gap));
      margin-inline: auto;
    }
  }
</style>

<script>
  const readCssVarLength = (el: Element, varName: string) => {
    const probe = document.createElement("div");
    probe.style.position = "absolute";
    probe.style.visibility = "hidden";
    probe.style.pointerEvents = "none";
    probe.style.height = `var(${varName})`;
    el.appendChild(probe);
    const px = probe.getBoundingClientRect().height;
    probe.remove();
    return px;
  };

  const setupAgePagePillScroll = () => {
    const agePage = document.querySelector<HTMLElement>(".age-page");
    if (!agePage || agePage.dataset.pillScrollReady === "true") return;
    agePage.dataset.pillScrollReady = "true";

    agePage
      .querySelectorAll<HTMLAnchorElement>(
        '.age-page__pill-half[href^="#"], .age-page__pill-schedule[href^="#"]',
      )
      .forEach((link) => {
        link.addEventListener("click", (event) => {
          const href = link.getAttribute("href");
          if (!href?.startsWith("#")) return;

          const target = document.querySelector(href);
          if (!target) return;

          event.preventDefault();

          if (link.classList.contains("age-page__pill-schedule")) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            history.replaceState(null, "", href);
            return;
          }

          const offset = readCssVarLength(
            link,
            "--age-page-pill-scroll-offset",
          );
          const top =
            target.getBoundingClientRect().top + window.scrollY - offset;

          window.scrollTo({ top, behavior: "smooth" });
          history.replaceState(null, "", href);
        });
      });
  };

  setupAgePagePillScroll();
  document.addEventListener("astro:page-load", setupAgePagePillScroll);
</script>
