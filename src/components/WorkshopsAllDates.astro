---
import { Icon } from "astro-icon/components";

import { site } from "../data/site";
import { workshopsPage, workshopsPageMeta } from "../data/WorkshopsPage";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";
import { sortWorkshopDates } from "../utils/sortWorkshopDates";
import FacebookIcon from "./FacebookIcon.astro";
import InstagramIcon from "./InstagramIcon.astro";

const pageMeta = workshopsPageMeta;

const allDateSlots = sortWorkshopDates(
  workshopsPage.flatMap((workshop) =>
    (workshop.dates ?? []).map((date) => ({
      ...date,
      workshopTitle: workshop.title,
      accentDeep: cardAccentDeep(workshop.accent),
      accentSoft: cardAccentSoft(workshop.accent),
    })),
  ),
);

/** Stejné termíny jako v kartách WorkshopsPage (desktop ≥1024px) */
const categories = workshopsPage
  .filter((workshop) => workshop.dates?.length)
  .map((workshop) => ({
    id: workshop.id,
    title: workshop.title,
    accentDeep: cardAccentDeep(workshop.accent),
    accentSoft: cardAccentSoft(workshop.accent),
    dates: sortWorkshopDates(workshop.dates ?? []),
  }));
---

<section
  id={pageMeta.allDatesSectionId}
  class="section workshops-page__all-dates"
  aria-labelledby="workshops-all-dates-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <h2 id="workshops-all-dates-title">
        {pageMeta.allDatesTitle}{" "}
        <span class="section-title-accent">{pageMeta.allDatesTitleAccent}</span>
      </h2>
    </header>

    <ul class="workshops-page__dates-grid reveal">
      <li>
        <article class="workshops-page__date-card">
          <div class="workshops-page__date-body">
            {
              allDateSlots.length ? (
                <ul class="workshops-page__date-slots">
                  {allDateSlots.map((date, dateIndex) => (
                    <li class="workshops-page__date-slot">
                      {dateIndex > 0 ? (
                        <span class="workshops-page__date-slot-rule" aria-hidden="true" />
                      ) : null}
                      <a
                        class="workshops-page__date-slot-row"
                        href={date.href ?? site.signupFormUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        style={`--accent: ${date.accentDeep}; --accent-soft: ${date.accentSoft};`}
                        aria-label={`Rezervovat ${date.workshopTitle}, ${date.day}. ${date.month}, ${date.time}, ${date.venueName}`}
                      >
                        <div
                          class="workshops-page__date-slot-date"
                          style={`--accent: ${date.accentDeep}; --accent-soft: ${date.accentSoft};`}
                          aria-hidden="true"
                        >
                          <span class="workshops-page__date-slot-day">{date.day}</span>
                          <span class="workshops-page__date-slot-month">
                            {date.month}
                          </span>
                        </div>
                        <div class="workshops-page__date-slot-body">
                          <p class="workshops-page__date-slot-venue">{date.venueName}</p>
                          <p class="workshops-page__date-slot-time">{date.time}</p>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null
            }
          </div>
        </article>
      </li>
    </ul>

    <div class="workshops-cats reveal">
      <div class="workshops-cats__grid">
        {
          categories.map((category) => (
            <article
              class="workshops-cats__card"
              style={`--accent: ${category.accentDeep}; --accent-soft: ${category.accentSoft};`}
            >
              <header class="workshops-cats__card-head">
                <h3 class="workshops-cats__card-title">
                  <span>{category.title}</span>
                </h3>
                <span class="workshops-home__topic-rule" aria-hidden="true" />
              </header>

              <div class="workshops-cats__card-body">
                <ul class="workshops-cats__slots">
                  {category.dates.map((date, dateIndex) => (
                    <li class="workshops-cats__slot">
                      {dateIndex > 0 ? (
                        <hr class="workshops-page__divider" aria-hidden="true" />
                      ) : null}
                      <div class="workshops-cats__slot-link">
                        <span class="workshops-cats__slot-date" aria-hidden="true">
                          <span class="workshops-cats__slot-day">{date.day}</span>
                          <span class="workshops-cats__slot-month">{date.month}</span>
                        </span>
                        <span class="workshops-cats__slot-info">
                          <span class="workshops-cats__slot-venue">{date.venueName}</span>
                          <span class="workshops-cats__slot-time">{date.time}</span>
                        </span>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="workshops-cats__banner">
        <span class="workshops-cats__banner-icon" aria-hidden="true">
          <Icon
            is:inline
            name="lineicons:calendar-days"
            class="workshops-cats__banner-icon-graphic"
          />
        </span>
        <div class="workshops-cats__banner-copy">
          <p class="workshops-cats__banner-title">Nenašli jste vhodný termín?</p>
          <p class="workshops-cats__banner-text">
            Sledujte nás, pravidelně přidáváme nové workshopy.
          </p>
        </div>
        <div class="workshops-cats__banner-social">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="workshops-cats__banner-social-link workshops-cats__banner-social-link--facebook"
          >
            <FacebookIcon width={32} height={32} />
          </a>
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="workshops-cats__banner-social-link"
          >
            <InstagramIcon gradientId="all-dates-ig-grad" width={32} height={32} />
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .workshops-page__all-dates {
    scroll-margin-top: var(--section-scroll-margin);
    padding-bottom: 0;
    background-color: var(--color-cream);
  }

  .workshops-page__all-dates .section-title-accent {
    color: var(--color-lilac-deep);
  }

  .workshops-page__dates-grid {
    list-style: none;
    padding: 0;
    margin: 0 auto var(--space-17);
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .workshops-page__date-card {
    --workshops-page-date-card-radius: var(--radius-card);
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--workshops-page-date-card-radius);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
  }

  .workshops-page__date-workshop {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .workshops-page__date-workshop-rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-4);
    border: none;
    background: rgba(42, 31, 56, 0.12);
  }

  .workshops-page__date-workshop-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .workshops-page__date-workshop-icon-graphic {
    width: var(--space-13);
    height: var(--space-13);
  }

  .workshops-page__date-workshop-label {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--color-ink);
  }

  .workshops-page__date-slots {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .workshops-page__date-slot-rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-1) 0 var(--space-1);
    border: none;
    background: rgba(42, 31, 56, 0.12);
  }

  .workshops-page__date-slot-row {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    box-sizing: border-box;
    height: calc(
      4 * var(--text-base) * var(--line-height-base) + 0.25rem + 2 * var(--space-4)
    );
    padding: var(--space-4) 0;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-2xl);
    transition: background 180ms ease;
  }

  .workshops-page__date-slot-row:hover,
  .workshops-page__date-slot-row:focus-visible {
    background: var(--accent-soft);
    outline: none;
  }

  .workshops-page__date-slot:last-child .workshops-page__date-slot-row {
    padding-bottom: 0;
  }

  .workshops-page__date-slot-date {
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 4rem;
    min-height: 4rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    text-align: center;
  }

  .workshops-page__date-slot-day {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--line-height-xs);
  }

  .workshops-page__date-slot-month {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--line-height-base);
  }

  .workshops-page__date-slot-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .workshops-page__date-slot-venue {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-page__date-slot-time {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink-soft);
  }

  @media (min-width: 768px) {
    .workshops-page__dates-grid {
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--card-grid-width-md));
      justify-content: center;
    }
  }

  @media (min-width: 1180px) {
    .workshops-page__dates-grid {
      max-width: calc(2 * var(--card-grid-width-md) + var(--stack-gap));
      margin-inline: auto;
    }
  }

  /* ---------- Desktop ≥1024px: kategorie + filtry + banner ---------- */
  /* Pod 1024px schované — platí původní mřížka termínů */
  .workshops-cats {
    display: none;
  }

  @media (min-width: 1024px) {
    .workshops-page__dates-grid {
      display: none;
    }

    .workshops-cats {
      display: grid;
      grid-template-columns: repeat(3, minmax(240px, 300px));
      column-gap: var(--space-12);
      row-gap: var(--space-15);
      justify-content: center;
      width: fit-content;
      max-width: 100%;
      margin-inline: auto;
      margin-bottom: var(--space-17);
    }

    /* Mřížka tří sloupců */
    .workshops-cats__grid {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      align-items: stretch;
      min-height: 400px;
    }

    .workshops-cats__card {
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      padding: var(--space-15) var(--space-12);
      border: var(--card-border);
      border-radius: var(--radius-card);
      background: #fefefe;
    }

    .workshops-cats__card-head {
      margin-bottom: var(--space-12);
    }

    .workshops-cats__card-title {
      margin: 0;
      padding-top: var(--space-4);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: 600;
      line-height: var(--line-height-lg);
      color: var(--color-ink);
      text-align: center;
    }

    .workshops-cats__card:first-child .workshops-cats__card-title {
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
    }

    .workshops-cats__card .workshops-home__topic-rule {
      display: block;
      width: 2.75rem;
      height: 2px;
      border-radius: var(--radius-full);
      background: var(--accent);
      margin: var(--space-6) auto 0;
    }

    .workshops-cats__slots {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }

    .workshops-cats__slot .workshops-page__divider {
      border: none;
      height: 1px;
      margin: var(--space-8) 0 var(--space-8);
      background: rgba(42, 31, 56, 0.12);
    }

    .workshops-cats__slot-link {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--space-8);
      box-sizing: border-box;
      min-height: 5rem;
      padding: var(--space-6) var(--space-4);
      border-radius: var(--radius-2xl);
      background: var(--accent-soft);
    }

    .workshops-cats__slot-date {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      box-sizing: border-box;
      width: 3.25rem;
      min-height: 3.25rem;
      padding-right: var(--space-6);
      border-radius: var(--radius-2xl);
      color: var(--accent);
      text-align: center;
    }

    .workshops-cats__slot-date::after {
      content: "";
      position: absolute;
      top: 0.25rem;
      right: 0;
      bottom: 0.25rem;
      width: 1px;
      background: var(--accent);
    }

    .workshops-cats__slot-day {
      font-family: var(--font-body);
      font-size: var(--text-xl);
      font-weight: 700;
      line-height: var(--line-height-xs);
    }

    .workshops-cats__slot-month {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      font-weight: 600;
    }

    .workshops-cats__slot-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      min-width: 0;
    }

    .workshops-cats__slot-venue {
      font-family: var(--font-body);
      font-size: var(--text-base);
      font-weight: 600;
      line-height: var(--line-height-lg);
      color: var(--color-ink);
    }

    .workshops-cats__slot-time {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      font-weight: 400;
      color: var(--color-ink-soft);
    }

    /* Banner „Nenašli jste termín?“ */
    .workshops-cats__banner {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-10);
      padding: var(--space-12) var(--space-14);
      border-radius: var(--radius-card);
      background: var(--color-lilac-soft);
    }

    .workshops-cats__banner-icon {
      display: grid;
      place-items: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: var(--radius-2xl);
      background: #fefefe;
      color: var(--color-lilac-deep);
    }

    .workshops-cats__banner-icon-graphic {
      display: block;
      width: var(--space-15);
      height: var(--space-15);
    }

    .workshops-cats__banner-icon-graphic :global(svg) {
      display: block;
      width: 100%;
      height: 100%;
    }

    .workshops-cats__banner-copy {
      min-width: 0;
    }

    .workshops-cats__banner-title {
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 600;
      color: var(--color-ink);
    }

    .workshops-cats__banner-text {
      margin: 0;
      font-family: var(--font-body);
      font-size: var(--text-sm);
      font-weight: 400;
      color: var(--color-ink-soft);
    }

    .workshops-cats__banner-social {
      display: flex;
      align-items: center;
      gap: var(--space-8);
    }

    .workshops-cats__banner-social-link {
      display: inline-flex;
      transition: transform 200ms ease;
    }

    .workshops-cats__banner-social-link :global(svg) {
      display: block;
      width: var(--footer-social-icon-size);
      height: var(--footer-social-icon-size);
    }

    .workshops-cats__banner-social-link:hover {
      transform: translateY(-2px);
    }

    .workshops-cats__banner-social-link--facebook {
      color: #1877f2;
    }
  }
</style>

<script>
  const WORKSHOPS_CATS_DESKTOP_MQ = "(min-width: 1024px)";

  const syncWorkshopsCatsFirstCardTitle = () => {
    const grid = document.querySelector<HTMLElement>(".workshops-cats__grid");
    if (!grid) return;

    const firstTitle = grid.querySelector<HTMLElement>(
      ".workshops-cats__card:first-child .workshops-cats__card-title",
    );
    const otherTitles = grid.querySelectorAll<HTMLElement>(
      ".workshops-cats__card:not(:first-child) .workshops-cats__card-title",
    );

    if (!firstTitle || otherTitles.length === 0) return;

    firstTitle.style.minHeight = "";

    const cats = grid.closest<HTMLElement>(".workshops-cats");
    if (!window.matchMedia(WORKSHOPS_CATS_DESKTOP_MQ).matches) return;
    if (!cats || getComputedStyle(cats).display === "none") return;

    let maxHeight = 0;
    otherTitles.forEach((title) => {
      maxHeight = Math.max(maxHeight, title.getBoundingClientRect().height);
    });

    if (maxHeight > 0) {
      firstTitle.style.minHeight = `${maxHeight}px`;
    }
  };

  const setupWorkshopsCatsFirstCardTitleSync = () => {
    const grid = document.querySelector<HTMLElement>(".workshops-cats__grid");
    if (!grid || grid.dataset.firstCardTitleSyncReady === "true") return;
    grid.dataset.firstCardTitleSyncReady = "true";

    const run = () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(syncWorkshopsCatsFirstCardTitle);
      });
    };

    run();
    window.addEventListener("resize", run, { passive: true });
    document.fonts?.ready.then(run);

    grid
      .querySelectorAll<HTMLElement>(
        ".workshops-cats__card:not(:first-child) .workshops-cats__card-title",
      )
      .forEach((title) => {
        const observer = new ResizeObserver(run);
        observer.observe(title);
      });
  };

  setupWorkshopsCatsFirstCardTitleSync();
  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector<HTMLElement>(".workshops-cats__grid");
    if (grid) delete grid.dataset.firstCardTitleSyncReady;
    setupWorkshopsCatsFirstCardTitleSync();
  });
</script>
