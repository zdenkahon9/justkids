---
import { site } from "../data/site";
---

<section class="section contact-cta" aria-labelledby="contact-cta-title">
  <div class="container-x">
    <div class="contact-cta__card reveal">
      <div class="contact-cta__copy">
        <span class="eyebrow">Kontakt</span>
        <h2 id="contact-cta-title">
          Máte dotaz? <em>Napište nám</em>
        </h2>
        <p>
          Veškeré kontaktní údaje a odkazy najdete v zápatí stránky.
          Klidně mi napište mail nebo zavolejte - ráda vám se vším poradím.
        </p>
      </div>

      <div class="contact-cta__actions">
        <a
          href={`mailto:${site.contact.email}`}
          class="btn btn-primary"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M 3 7 L 12 13 L 21 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linejoin="round"/>
          </svg>
          {site.contact.email}
        </a>

        <a href="#kontakt" class="btn btn-ghost contact-cta__scroll">
          Zobrazit všechny kontakty
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .contact-cta__card {
    background: linear-gradient(135deg, #fff9f4 0%, #ffe1ed 50%, #ece1f7 100%);
    border: 2px solid var(--color-lilac-soft);
    border-radius: var(--radius-card);
    padding: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    box-shadow: var(--shadow-soft);
  }

  .contact-cta__copy h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin: 0 0 0.85rem;
  }

  .contact-cta__copy h2 em {
    font-style: italic;
    color: var(--color-blush-vivid);
  }

  .contact-cta__copy p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }

  .contact-cta__actions {
    display: grid;
    gap: 0.75rem;
    justify-items: stretch;
  }

  .contact-cta__actions .btn {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 720px) {
    .contact-cta__card {
      grid-template-columns: 1fr;
    }
  }
</style>
