---
import { locations } from "../data/locations";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const mapEmbed = (lat: number, lng: number) =>
  `https://www.google.com/maps?q=${lat},${lng}&z=16&hl=cs&output=embed`;
---

<section
  id="lokace"
  class="section locations"
  aria-labelledby="locations-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Kde nás najdete</span>
      <h2 id="locations-title">
        Navštivte <span class="section-title-accent">nás</span>
      </h2>
      <p class="section-subtitle">
        Cvičíme ve dvou příjemných studiích na Berounsku – ve Zdicích a v
        Hořovicích.
      </p>
    </header>

    <div class="locations__grid">
      {
        locations.map((l, i) => (
          <article
            class="location reveal"
            style={`--accent: ${cardAccentDeep(l.accent)}; --accent-soft: ${cardAccentSoft(l.accent)}; transition-delay: ${i * 100}ms`}
          >
            <div class="location__details">
              <div class="location__summary">
                <div class="location__head">
                  <div class="location__icon" aria-hidden="true">
                    <svg
                      class="card-icon-graphic"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="var(--accent)"
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                      />
                      <circle cx="12" cy="9" r="2.75" fill="#fff" />
                    </svg>
                  </div>
                  <div class="location__head-text">
                    <h3>{l.name}</h3>
                    <address class="location__address">
                      {l.street}, {l.zip} {l.city}
                    </address>
                  </div>
                </div>
              </div>

              <div class="location__panel">
                <div class="location__expandable">
                  <div class="location__parking">
                    <span class="location__parking-label">
                      <span class="location__p-mark" aria-hidden="true">
                        P
                      </span>
                      Parkování
                    </span>
                    <p>{l.parking}</p>
                  </div>

                  <a
                    href={l.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="location__nav-link"
                  >
                    Navigovat v Google Maps
                    <svg
                      class="location__extern-icon"
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"
                      />
                      <path
                        fill="currentColor"
                        d="M5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </div>

            <div class="location__map-shell">
              <iframe
                class="location__map-frame"
                src={mapEmbed(l.mapCoords.lat, l.mapCoords.lng)}
                title={`Mapa: ${l.name}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              />
              <a
                href={l.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="location__map-overlay"
              >
                Otevřít v Mapách
                <svg
                  class="location__extern-icon"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"
                  />
                  <path
                    fill="currentColor"
                    d="M5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
   * Mobile-first: jedna řada, karty max 512px; od 768px dva pružné sloupce.
   */
  .locations__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--stack-gap);
    align-items: start;
    justify-items: center;
  }

  @media (max-width: 767px) {
    .locations__grid > .location {
      width: 100%;
      max-width: 32rem; /* 512px */
      box-sizing: border-box;
    }
  }

  @media (min-width: 768px) {
    .locations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: stretch;
    }

    .locations__grid > .location {
      max-width: none;
    }
  }

  #lokace {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .locations .section-title-accent {
    color: var(--color-lilac-deep);
  }

  /* Divider matches .footer__col (mobile / tablet): light pink line */
  .location {
    --location-divider: 1px solid rgba(236, 47, 142, 0.16);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    background: #fefefe;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: var(--card-border);
    box-shadow: none;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .location__map-shell {
    position: relative;
    flex-shrink: 0;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    margin-top: auto;
    height: clamp(10rem, 26vw, 13rem);
    background: color-mix(in srgb, var(--color-cream-100) 82%, transparent);
    border-top: var(--location-divider);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 12px 28px -16px rgba(42, 31, 56, 0.06);
  }

  .location__map-frame {
    border: 0;
    width: 100%;
    height: 100%;
    display: block;
    /* Slightly softer than raw Google embed — easier on long viewing */
    filter: contrast(0.97) saturate(0.94);
  }

  .location__map-overlay {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xl);
    background: #fff;
    color: #1a73e8;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .location__map-overlay:hover {
    background: #f8f9fa;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
  }

  .location__extern-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .location__details {
    position: relative;
    flex: 0 1 auto;
    width: 100%;
    min-height: 0;
    border: 0;
    padding: var(--card-padding);
    padding-bottom: var(--space-6);
    box-sizing: border-box;
  }

  .location__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    flex: 1 1 auto;
    min-height: 0;
  }

  .location__summary {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.75rem;
    padding: 0;
  }

  .location__expandable {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 0;
  }

  .location__head {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    width: 100%;
    margin-bottom: 0;
    padding-top: 0.5rem;
  }

  .location__icon {
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    width: var(--card-icon-size);
    height: var(--card-icon-size);
    border-radius: var(--radius-full);
    background: #fff;
    border: none;
    display: grid;
    place-items: center;
    align-self: start;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 0 0 6px color-mix(in srgb, var(--accent) 12%, white),
      0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .location__head-text {
    flex: 1;
    min-width: 0;
  }

  .location__head-text h3 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    margin: 0 0 0.35rem;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .location__address {
    font-style: normal;
    margin: 0;
    font-size: var(--text-base);
    min-height: 3rem;
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  .location__parking {
    padding: 0;
    padding-top: 1.25rem;
    margin-bottom: 1.25rem;
    border-top: var(--location-divider);

    & > p {
      min-height: 3rem;
    }
  }

  .location__parking-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }

  .location__p-mark {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-sky-deep);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 800;
    line-height: var(--line-height-xs);
  }

  .location__parking p {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  #lokace .location__nav-link {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: var(--location-divider);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-blush-vivid);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition: border-color 180ms ease;
    align-self: flex-start;
  }

  #lokace .location__nav-link:hover {
    border-bottom-color: var(--color-blush-vivid);
  }

  @media (prefers-contrast: more) {
    .location__map-frame {
      filter: none;
    }
  }

  .location:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 55px -18px
      color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .location:hover .location__icon {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .location:hover {
      transform: none;
    }

    .location:hover .location__icon {
      transform: none;
    }
  }

  /*
   * Sekce #lokace: od viewportu 1180px dvě karty po 490px, gap zůstává var(--stack-gap).
   * Selektor s #lokace přebije pravidlo .locations__grid z @media (min-width: 768px).
   */
  @media (min-width: 1180px) {
    #lokace .locations__grid {
      grid-template-columns: repeat(2, 490px);
      justify-content: center;
      width: fit-content;
      max-width: calc(490px + var(--stack-gap) + 490px);
      margin-inline: auto;
    }

    #lokace .locations__grid > .location {
      width: 490px;
      max-width: 490px;
      min-width: 490px;
      box-sizing: border-box;
    }
  }
</style>
