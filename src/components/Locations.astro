---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { ROUTE_IDS } from "../config/routes";
import { locations, locationsMeta } from "../data/locations";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const mapImages = import.meta.glob<{ default: ImageMetadata }>("../assets/maps/*.png", {
  eager: true,
});

const locationMapImage = (id: string) => {
  const image = mapImages[`../assets/maps/${id}.png`]?.default;
  if (!image) throw new Error(`Missing generated map image for location "${id}".`);
  return image;
};

const splitLocationName = (name: string) => {
  const [first, ...rest] = name.split(" ");
  return { first, rest: rest.join(" ") };
};
---

<section
  id={ROUTE_IDS.home.locations}
  class="section locations"
  aria-labelledby="locations-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Kde nás najdete</span>
      <h2 id="locations-title">
        Navštivte <span class="section-title-accent">nás</span>
      </h2>
      <p class="section-subtitle locations__subtitle">
        {locationsMeta.subtitleLead}{" "}
        <span class="locations__subtitle-cities">{locationsMeta.subtitleCities}</span>
      </p>
    </header>

    <div class="locations-tabs">
      <div class="locations__panel reveal">
        <div
          class="locations__card"
          style={`--accent: ${cardAccentDeep(locations[0].accent)}; --accent-soft: ${cardAccentSoft(locations[0].accent)}`}
        >
          <div
            class="locations-tabs__switcher"
            role="tablist"
            aria-label="Vyberte pobočku"
          >
            {
              locations.map((l, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`location-tab-${l.id}`}
                  class="locations-tabs__tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`location-panel-${l.id}`}
                  tabindex={i === 0 ? 0 : -1}
                  data-accent={cardAccentDeep(l.accent)}
                  data-accent-soft={cardAccentSoft(l.accent)}
                  style={`--accent: ${cardAccentDeep(l.accent)}; --accent-soft: ${cardAccentSoft(l.accent)}`}
                >
                  {l.city}
                </button>
              ))
            }
          </div>
          <span class="locations__rule" aria-hidden="true"></span>
          <div class="locations__body">
            <div class="locations-tabs__panels">
              {
                locations.map((l, i) => {
                  const nameParts = splitLocationName(l.name);

                  return (
                    <div
                      class="locations-tabs__panel"
                      id={`location-panel-${l.id}`}
                      role="tabpanel"
                      aria-labelledby={`location-tab-${l.id}`}
                    >
                      <article
                        class="location reveal"
                        style={`--accent: ${cardAccentDeep(l.accent)}; --accent-soft: ${cardAccentSoft(l.accent)}; transition-delay: ${i * 100}ms`}
                      >
                        <div class="location__details">
                          <div class="location__head">
                            <div class="location__head-text">
                              <h3>
                                <span class="location__name-first">
                                  {nameParts.first}
                                </span>
                                <span class="location__name-rest">{nameParts.rest}</span>
                              </h3>
                              <address class="location__address">
                                <span class="location__address-street">{l.street}</span>
                                <span class="location__address-sep">,&nbsp;</span>
                                <span class="location__address-locality">
                                  {l.zip} {l.city}
                                </span>
                              </address>
                            </div>
                          </div>
                          <span class="location__rule" aria-hidden="true" />
                        </div>

                        <a
                          href={l.mapUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="location__map-link"
                          aria-label={`Otevřít trasu do ${l.name} v Google Maps (nové okno)`}
                        >
                          <span class="location__map-action">
                            Navigovat v Google Maps
                            <svg
                              class="location__extern-icon"
                              viewBox="0 0 24 24"
                              width="16"
                              height="16"
                              aria-hidden="true"
                            >
                              <path
                                fill="currentColor"
                                d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"
                              />
                              <path
                                fill="currentColor"
                                d="M5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"
                              />
                            </svg>
                          </span>
                          <span class="location__map-shell">
                            <Image
                              class="location__map-frame"
                              src={locationMapImage(l.id)}
                              alt=""
                              widths={[326, 652]}
                              sizes="(min-width: 1024px) 326px, (min-width: 768px) 728px, min(calc(100vw - 3rem), 412px)"
                              format="webp"
                              loading="lazy"
                            />
                          </span>
                        </a>
                      </article>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Mobile-first: stejná architektura jako Schedule — jedna karta, pill, divider, body.
   * Od 1024px desktop grid — 3 karty vedle sebe (pružné sloupce).
   */
  #lokace {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .locations .section-title-accent {
    color: var(--color-lilac-deep);
  }

  .locations__subtitle-cities {
    display: block;
  }

  .locations-tabs {
    width: min(100%, var(--card-grid-width));
    margin-inline: auto;
  }

  .locations__panel {
    width: 100%;
    margin: 0;
  }

  .locations__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    width: 100%;
  }

  .locations__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-10);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
    transition: background 220ms ease;
  }

  .locations-tabs__switcher {
    display: flex;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--radius-pill);
    border: 1.5px solid rgba(42, 31, 56, 0.12);
    background: transparent;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    white-space: nowrap;
    padding: 0;
    min-height: calc(2rem + 1em * var(--line-height-base));
  }

  .locations-tabs__tab {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: var(--space-8) 0;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      box-shadow 180ms ease;
  }

  .locations-tabs__tab[aria-selected="true"] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .locations-tabs__tab[aria-selected="false"]:hover {
    background: color-mix(in srgb, var(--color-ink) 4%, #fefefe);
  }

  .locations-tabs__tab:focus-visible {
    position: relative;
    z-index: 1;
    outline: none;
    box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--accent) 58%, white);
  }

  .locations__body {
    position: relative;
    z-index: 1;
  }

  .locations-tabs__panels .locations-tabs__panel {
    display: none;
    width: 100%;
    box-sizing: border-box;
  }

  .locations__card:has(
      .locations-tabs__switcher .locations-tabs__tab:nth-child(1)[aria-selected="true"]
    )
    .locations-tabs__panels
    .locations-tabs__panel:nth-child(1),
  .locations__card:has(
      .locations-tabs__switcher .locations-tabs__tab:nth-child(2)[aria-selected="true"]
    )
    .locations-tabs__panels
    .locations-tabs__panel:nth-child(2),
  .locations__card:has(
      .locations-tabs__switcher .locations-tabs__tab:nth-child(3)[aria-selected="true"]
    )
    .locations-tabs__panels
    .locations-tabs__panel:nth-child(3) {
    display: block;
  }

  /* locations__rule = accent tabů; mapa = location-divider */
  .location {
    --location-divider: 1px solid rgba(236, 47, 142, 0.16);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    overflow: visible;
    box-shadow: none;
  }

  .locations__body .location {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    border: none;
    border-radius: 0;
    background: transparent;
    overflow: visible;
  }

  .locations__body .location__details {
    width: 100%;
    padding: 0;
    box-sizing: border-box;
  }

  .locations__body .location__head {
    padding-top: 0;
  }

  .locations__body .location__map-shell {
    width: calc(100% + 2 * var(--card-padding-x));
    max-width: none;
    margin-inline: calc(-1 * var(--card-padding-x));
    margin-top: 0;
    margin-bottom: calc(-1 * var(--card-padding-y));
    height: 13rem;
    max-height: 13rem;
  }

  @media (min-width: 768px) {
    .locations__subtitle-cities {
      display: inline;
    }

    .locations-tabs {
      width: min(100%, calc(2 * var(--card-grid-width-md) + var(--stack-gap)));
    }
  }

  @media (min-width: 1024px) {
    .locations-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-12);
      width: 100%;
      max-width: none;
      margin-inline: unset;
      justify-items: stretch;
      align-items: start;
    }

    .locations__panel {
      display: contents;
    }

    .locations__card {
      display: contents;
    }

    .locations-tabs__switcher,
    .locations__rule {
      display: none;
    }

    .locations__body {
      display: contents;
    }

    .locations-tabs__panels {
      display: contents;
    }

    .locations-tabs__panels .locations-tabs__panel {
      display: block !important;
    }

    .location {
      background: #fefefe;
      border-radius: var(--radius-card);
      overflow: hidden;
      border: var(--card-border);
      transition:
        transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 280ms ease;
    }

    .locations__body .location {
      border: var(--card-border);
      border-radius: var(--radius-card);
      background: #fefefe;
      overflow: hidden;
    }

    .locations__body .location__details {
      padding: var(--card-padding);
      padding-bottom: 0;
    }

    .locations__body .location__head {
      padding-top: var(--space-4);
    }

    .locations__body .location__map-shell,
    .location__map-shell {
      width: 100%;
      max-width: 100%;
      margin-inline: unset;
      margin-top: auto;
      margin-bottom: 0;
      height: clamp(11rem, 24vw, 14rem);
      max-height: none;
    }

    .location__map-link {
      margin-top: 0;
    }

    .location__map-action {
      margin-inline: var(--card-padding-x);
    }
  }

  .location__map-link {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .location__map-action {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
    color: var(--color-blush-deep);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--line-height-base);
    border-bottom: 1.5px solid transparent;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .location__map-link:hover .location__map-action {
    color: var(--color-blush-vivid);
    border-bottom-color: currentColor;
  }

  .location__map-link:focus-visible {
    outline: none;
  }

  .location__map-link:focus-visible .location__map-action {
    border-radius: var(--radius-sm);
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .location__map-shell {
    position: relative;
    flex-shrink: 0;
    align-self: stretch;
    background: color-mix(in srgb, var(--color-cream-100) 82%, transparent);
    border-top: var(--location-divider);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 12px 28px -16px rgba(42, 31, 56, 0.06);
  }

  .location__map-frame {
    border: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    /* Slightly softer than raw Google embed — easier on long viewing */
    filter: contrast(0.97) saturate(0.94);
  }

  .location__extern-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .location__details {
    position: relative;
    flex: 0 1 auto;
    width: 100%;
    min-height: 0;
    border: 0;
    padding: var(--card-padding);
    padding-bottom: var(--space-12);
    box-sizing: border-box;
  }

  .location__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-10);
    border: none;
    background: rgba(42, 31, 56, 0.12);
  }

  .location__head {
    width: 100%;
    margin-bottom: 0;
    padding-top: var(--space-4);
  }

  .location__head-text {
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 767px) {
    .location__head-text,
    .location__head-text .location__address {
      text-align: center;
    }

    .location__address {
      justify-content: center;
    }
  }

  .location__head-text h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    margin: 0 0 var(--space-3);
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .location__name-first::after {
    content: " ";
  }

  .location__address {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0;
    font-style: normal;
    margin: 0;
    font-size: var(--text-base);
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  @media (min-width: 1024px) and (max-width: 1179px) {
    .location__head-text {
      text-align: center;
    }

    .location__head-text h3 {
      margin: 0 0 var(--space-6);
    }

    .location__name-first::after {
      content: none;
    }

    .location__name-first,
    .location__name-rest {
      display: block;
    }

    .location__address {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .location__address-sep {
      display: none;
    }

    .location__address-street,
    .location__address-locality {
      display: block;
    }
  }

  @media (min-width: 1180px) {
    .locations-tabs {
      max-width: 64rem;
      margin-inline: auto;
    }

    .location__head-text {
      text-align: center;
    }

    .location__head-text h3 {
      margin: 0 0 var(--space-6);
    }

    .location__address {
      justify-content: center;
    }
  }

  @media (prefers-contrast: more) {
    .location__map-frame {
      filter: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    @media (min-width: 1024px) {
      .location:has(.location__map-link:hover),
      .location:focus-within {
        transform: translateY(-4px);
        box-shadow: 0 26px 55px -18px color-mix(in srgb, var(--accent) 45%, transparent);
      }
    }
  }

  @media (min-width: 1024px) {
    .location:has(.location__map-link:active) {
      transform: translateY(-2px) scale(0.99);
      box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--accent) 35%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    @media (hover: hover) and (pointer: fine) {
      @media (min-width: 1024px) {
        .location:has(.location__map-link:hover),
        .location:focus-within {
          transform: none;
        }
      }
    }

    @media (min-width: 1024px) {
      .location:has(.location__map-link:active) {
        transform: none;
      }
    }
  }
</style>

<script>
  const setupLocationsTabs = () => {
    document
      .querySelectorAll<HTMLElement>(".locations-tabs__switcher")
      .forEach((switcher) => {
        if (switcher.dataset.tabsReady === "true") return;
        switcher.dataset.tabsReady = "true";

        const card = switcher.closest<HTMLElement>(".locations__card");
        const tabs = Array.from(
          switcher.querySelectorAll<HTMLButtonElement>("[role='tab']"),
        );

        const selectTab = (selectedTab: HTMLButtonElement, moveFocus = false) => {
          tabs.forEach((tab) => {
            const isSelected = tab === selectedTab;
            tab.setAttribute("aria-selected", String(isSelected));
            tab.tabIndex = isSelected ? 0 : -1;
          });

          const accent = selectedTab.dataset.accent;
          const accentSoft = selectedTab.dataset.accentSoft;
          if (card && accent) card.style.setProperty("--accent", accent);
          if (card && accentSoft) card.style.setProperty("--accent-soft", accentSoft);
          if (moveFocus) selectedTab.focus();
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener("click", () => selectTab(tab));
          tab.addEventListener("keydown", (event) => {
            let nextIndex: number | undefined;

            if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
            if (event.key === "ArrowLeft") {
              nextIndex = (index - 1 + tabs.length) % tabs.length;
            }
            if (event.key === "Home") nextIndex = 0;
            if (event.key === "End") nextIndex = tabs.length - 1;

            if (nextIndex === undefined) return;
            event.preventDefault();
            selectTab(tabs[nextIndex], true);
          });
        });

        const selectedTab = tabs.find(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        if (selectedTab) selectTab(selectedTab);
      });
  };

  setupLocationsTabs();
  document.addEventListener("astro:page-load", setupLocationsTabs);
</script>
