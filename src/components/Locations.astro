---
import { locations } from "../data/locations";

const mapEmbed = (lat: number, lng: number) =>
  `https://www.google.com/maps?q=${lat},${lng}&z=16&hl=cs&output=embed`;
---

<section
  id="lokace"
  class="section locations"
  aria-labelledby="locations-title"
>
  <div class="container-x">
    <header class="locations__header reveal">
      <span class="eyebrow">Kde nás najdete</span>
      <h2 id="locations-title">
        Navštivte <span class="section-title-accent">nás</span>
      </h2>
      <p class="locations__subtitle">
        Cvičíme ve dvou příjemných studiích na Berounsku – ve Zdicích a v
        Hořovicích.
      </p>
    </header>

    <div class="locations__layout">
      <div class="locations__grid">
        {
          locations.map((l, i) => (
            <article
              class={`location location--${l.accent} reveal`}
              style={`transition-delay: ${i * 100}ms`}
            >
              <details class="location__details" open>
                <summary class="location__summary">
                  <div class="location__head">
                    <div class="location__icon" aria-hidden="true">
                      <svg
                        class="location__pin"
                        viewBox="0 0 24 24"
                        width="30"
                        height="30"
                        aria-hidden="true"
                      >
                        <path
                          fill="var(--accent-color)"
                          d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                        />
                        <circle cx="12" cy="9" r="2.75" fill="#fff" />
                      </svg>
                    </div>
                    <div class="location__head-text">
                      <h3>{l.id === "zdice" ? "Fitcentrum Zdice" : l.name}</h3>
                      <address class="location__address">
                        {l.street}, {l.zip} {l.city}
                      </address>
                    </div>
                  </div>
                </summary>

                <div class="location__panel">
                  <div class="location__expandable">
                    <div class="location__parking">
                      <span class="location__parking-label">
                        <span class="location__p-mark" aria-hidden="true">
                          P
                        </span>
                        Parkování
                      </span>
                      <p>{l.parking}</p>
                    </div>

                    <a
                      href={l.mapUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="location__nav-link"
                    >
                      Navigovat v Google Maps
                      <svg
                        class="location__extern-icon"
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        aria-hidden="true"
                      >
                        <path
                          fill="currentColor"
                          d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"
                        />
                        <path
                          fill="currentColor"
                          d="M5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"
                        />
                      </svg>
                    </a>
                  </div>

                  <div class="location__map-shell">
                    <iframe
                      class="location__map-frame"
                      src={mapEmbed(l.mapCoords.lat, l.mapCoords.lng)}
                      title={`Mapa: ${l.name}`}
                      loading="lazy"
                      referrerpolicy="no-referrer-when-downgrade"
                      allowfullscreen
                    />
                    <a
                      href={l.mapUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="location__map-overlay"
                    >
                      Otevřít v Mapách
                      <svg
                        class="location__extern-icon"
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        aria-hidden="true"
                      >
                        <path
                          fill="currentColor"
                          d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"
                        />
                        <path
                          fill="currentColor"
                          d="M5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              </details>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Mobile-first: jedna řada, karty max 512px; od 768px dva pružné sloupce.
   */
  .locations__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
    justify-items: center;
  }

  @media (max-width: 767px) {
    .locations__grid > .location {
      width: 100%;
      max-width: 32rem; /* 512px */
      box-sizing: border-box;
    }
  }

  @media (min-width: 768px) {
    .locations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: stretch;
    }

    .locations__grid > .location {
      max-width: none;
    }
  }

  #lokace {
    scroll-margin-top: -5.5rem;
  }

  .locations__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }

  .locations__header h2 {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    margin: 0 0 1.5rem;
  }

  .locations__header h2 .section-title-accent {
    color: var(--color-lilac-deep);
  }

  .locations__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  /* Divider matches .footer__col (mobile / tablet): light pink line */
  .location {
    --location-divider: 1px solid rgba(236, 47, 142, 0.16);
    --accent-color: var(--color-blush-deep);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    background: #fefefe;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--color-lilac-deep) 20%, transparent);
    box-shadow: none;
    transition:
      transform 280ms ease,
      box-shadow 280ms ease;
  }

  .location--blush {
    --accent-color: var(--color-blush-vivid);
  }
  .location--sky {
    --accent-color: var(--color-sky-deep);
  }
  .location--lilac {
    --accent-color: var(--color-lilac-deep);
  }

  .location__map-shell {
    position: relative;
    flex-shrink: 0;
    margin-top: auto;
    height: clamp(10rem, 26vw, 13rem);
    background: color-mix(in srgb, var(--color-cream-100) 82%, transparent);
    border-top: var(--location-divider);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 12px 28px -16px rgba(42, 31, 56, 0.06);
  }

  .location__map-frame {
    border: 0;
    width: 100%;
    height: 100%;
    display: block;
    /* Slightly softer than raw Google embed — easier on long viewing */
    filter: contrast(0.97) saturate(0.94);
  }

  .location__map-overlay {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: #fff;
    color: #1a73e8;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .location__map-overlay:hover {
    background: #f8f9fa;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
  }

  .location__extern-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .location__details {
    position: relative;
    flex: 0 1 auto;
    width: 100%;
    min-height: 0;
    border: 0;
    padding: 0;
  }

  .location__panel {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .location__summary {
    list-style: none;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.75rem;
    padding: 1.35rem 1.5rem 1.25rem;
    cursor: default;
    user-select: auto;
    -webkit-tap-highlight-color: transparent;
  }

  .location__summary::-webkit-details-marker {
    display: none;
  }

  .location__summary:focus {
    outline: none;
  }

  .location__summary:focus-visible {
    outline: 2px solid var(--color-lilac-deep);
    outline-offset: 3px;
    border-radius: 0.35rem;
  }

  .location__expandable {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 0 1.5rem 1.5rem;
  }

  .location__head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 0;
    padding-top: 0.5rem;
  }

  .location__icon {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    align-self: start;
  }

  .location__pin {
    display: block;
    width: 1.85rem;
    height: auto;
    filter: drop-shadow(
        0 3px 8px color-mix(in srgb, var(--accent-color) 45%, transparent)
      )
      drop-shadow(
        0 10px 28px color-mix(in srgb, var(--accent-color) 38%, transparent)
      );
  }

  .location__head-text {
    min-width: 0;
  }

  .location__head-text h3 {
    font-size: 1.5rem;
    margin: 0 0 0.35rem;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .location__address {
    font-style: normal;
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    min-height: 3rem;
    color: var(--color-ink-soft);
  }

  .location__parking {
    padding: 0;
    padding-top: 1.25rem;
    margin-bottom: 1.25rem;
    border-top: var(--location-divider);

    & > p {
      min-height: 3rem;
    }
  }

  .location__parking-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-soft);
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }

  .location__p-mark {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.2rem;
    background: var(--color-sky-deep);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
  }

  .location__parking p {
    margin: 0;
    font-size: 1rem;
    color: var(--color-ink);
    line-height: 1.5;
  }

  #lokace .location__nav-link {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: var(--location-divider);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-blush-vivid);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition: border-color 180ms ease;
    align-self: flex-start;
  }

  #lokace .location__nav-link:hover {
    border-bottom-color: var(--color-blush-vivid);
  }

  @media (prefers-contrast: more) {
    .location__map-frame {
      filter: none;
    }
  }

  @media (min-width: 1024px) {
    .locations__header h2 {
      margin: 0 0 1rem;
    }

    .location:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 56px -12px
        color-mix(in srgb, var(--color-lilac-deep) 56%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
      .location:hover {
        transform: none;
      }
    }
  }

  /*
   * Sekce #lokace: od viewportu 1180px dvě karty po 450px, gap zůstává 1.5rem z .locations__grid.
   * Selektor s #lokace přebije pravidlo .locations__grid z @media (min-width: 768px).
   */
  @media (min-width: 1180px) {
    #lokace .locations__grid {
      grid-template-columns: repeat(2, 490px);
      justify-content: center;
      width: fit-content;
      max-width: calc(450px + 1.5rem + 490px);
      margin-inline: auto;
    }

    #lokace .locations__grid > .location {
      width: 490px;
      max-width: 490px;
      min-width: 490px;
      box-sizing: border-box;
    }
  }
</style>

<script>
  /** Panely lokací jsou vždy rozbalené; po zavření (např. klávesnicí) znovu otevřeme */
  function initLocationDetailsPanel() {
    const root = document.getElementById("lokace");
    if (!root) return;

    const detailsList =
      root.querySelectorAll<HTMLDetailsElement>(".location__details");

    detailsList.forEach((details) => {
      details.open = true;
      details.addEventListener("toggle", () => {
        if (!details.open) {
          details.open = true;
        }
      });
    });
  }

  initLocationDetailsPanel();
</script>
