---
import { locations } from "../data/locations";
---

<section
  id="lokace"
  class="section locations"
  aria-labelledby="locations-title"
>
  <div class="container-x">
    <header class="locations__header reveal">
      <span class="eyebrow">Kde nás najdete</span>
      <h2 id="locations-title">
        Cvičíme na <span class="section-title-accent">dvou místech</span>
      </h2>
    </header>

    <div class="locations__grid">
      {
        locations.map((l, i) => (
          <article
            class={`location location--${l.accent} reveal`}
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="location__top">
              <div class="location__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path
                    d="M 12 22 C 12 22 4 14 4 9 C 4 4.5 7.5 1 12 1 C 16.5 1 20 4.5 20 9 C 20 14 12 22 12 22 Z M 12 12 C 13.6 12 15 10.6 15 9 C 15 7.4 13.6 6 12 6 C 10.4 6 9 7.4 9 9 C 9 10.6 10.4 12 12 12 Z"
                    fill="currentColor"
                  />
                </svg>
              </div>
              <div class="location__city">{l.city}</div>
            </div>

            <h3>{l.name}</h3>
            <address class="location__address">
              <span>{l.street}</span>
              <span>
                {l.zip} {l.city}
              </span>
            </address>

            <div class="location__parking">
              <span class="location__parking-label">
                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  aria-hidden="true"
                >
                  <rect
                    x="4"
                    y="4"
                    width="16"
                    height="16"
                    rx="3"
                    fill="currentColor"
                    opacity="0.15"
                  />
                  <text
                    x="12"
                    y="17"
                    text-anchor="middle"
                    font-family="sans-serif"
                    font-weight="800"
                    font-size="12"
                    fill="currentColor"
                  >
                    P
                  </text>
                </svg>
                Parkování
              </span>
              <p>{l.parking}</p>
            </div>

            <a
              href={l.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="location__map-link"
            >
              Otevřít v mapě
              <svg
                viewBox="0 0 24 24"
                width="14"
                height="14"
                aria-hidden="true"
              >
                <path
                  d="M 7 17 L 17 7 M 9 7 L 17 7 L 17 15"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>

            <div class="location__decor" aria-hidden="true" />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .locations__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }

  .locations__header h2 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .locations__header h2 .section-title-accent {
    color: var(--color-lilac-deep);
  }

  .locations__header p {
    color: var(--color-ink-soft);
    margin: 0;
  }

  .locations__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .location {
    --bg: var(--color-cream-100);
    --accent-color: var(--color-blush-deep);

    position: relative;
    background: var(--bg);
    border-radius: var(--radius-card);
    padding: 2.25rem;
    border: 2px solid transparent;
    overflow: hidden;
    transition:
      transform 280ms ease,
      box-shadow 280ms ease;
  }

  .location--blush {
    --bg: linear-gradient(165deg, #fff9f4 0%, #ffe1ed 100%);
    --accent-color: var(--color-blush-vivid);
  }
  .location--sky {
    --bg: linear-gradient(165deg, #fff9f4 0%, #d6ecfa 100%);
    --accent-color: var(--color-sky-deep);
  }
  .location--lilac {
    --bg: linear-gradient(165deg, #fff9f4 0%, #ece1f7 100%);
    --accent-color: var(--color-lilac-deep);
  }

  .location:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 50px -20px
      color-mix(in srgb, var(--accent-color) 40%, transparent);
  }

  .location__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .location__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: white;
    color: var(--accent-color);
    display: grid;
    place-items: center;
  }

  .location__city {
    font-family: var(--font-script);
    font-size: 1.5rem;
    color: var(--accent-color);
    line-height: 1;
  }

  .location h3 {
    font-size: 1.6rem;
    margin: 0 0 0.65rem;
  }

  .location__address {
    font-style: normal;
    color: var(--color-ink-soft);
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .location__parking {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    margin-bottom: 1.25rem;
  }

  .location__parking-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-color);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .location__parking p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink);
    line-height: 1.5;
  }

  .location__map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-color);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition: border-color 220ms ease;
  }

  .location__map-link:hover {
    border-bottom-color: var(--accent-color);
  }

  .location__decor {
    position: absolute;
    bottom: -40px;
    right: -40px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, white, transparent 70%);
    opacity: 0.4;
    pointer-events: none;
  }
</style>
