---
import { locations, locationsMeta } from "../data/locations";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const mapEmbed = (lat: number, lng: number) =>
  `https://www.google.com/maps?q=${lat},${lng}&z=16&hl=cs&output=embed`;

const splitLocationName = (name: string) => {
  const [first, ...rest] = name.split(" ");
  return { first, rest: rest.join(" ") };
};
---

<section id="lokace" class="section locations" aria-labelledby="locations-title">
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Kde nás najdete</span>
      <h2 id="locations-title">
        Navštivte <span class="section-title-accent">nás</span>
      </h2>
      <p class="section-subtitle locations__subtitle">
        {locationsMeta.subtitleLead}{" "}
        <span class="locations__subtitle-cities">{locationsMeta.subtitleCities}</span>
      </p>
    </header>

    <div class="locations-tabs">
      <div class="locations__panel reveal">
        <article
          class="locations__card"
          style={`--accent: ${cardAccentDeep(locations[0].accent)}; --accent-soft: ${cardAccentSoft(locations[0].accent)}`}
        >
          <div class="locations-tabs__switcher" aria-label="Vybrat pobočku">
            {
              locations.map((l, i) => (
                <details
                  name="locations"
                  class="locations-tabs__item"
                  open={i === 0 ? true : undefined}
                  data-accent={cardAccentDeep(l.accent)}
                  data-accent-soft={cardAccentSoft(l.accent)}
                  style={`--accent: ${cardAccentDeep(l.accent)}; --accent-soft: ${cardAccentSoft(l.accent)}`}
                >
                  <summary
                    class="locations-tabs__tab"
                    aria-controls={`location-panel-${i}`}
                  >
                    {l.city}
                  </summary>
                </details>
              ))
            }
          </div>
          <span class="locations__rule" aria-hidden="true"></span>
          <div class="locations__body">
            <div class="locations-tabs__panels">
              {
                locations.map((l, i) => {
                  const nameParts = splitLocationName(l.name);

                  return (
                    <div
                      class="locations-tabs__panel"
                      id={`location-panel-${i}`}
                      role="region"
                      aria-label={l.city}
                    >
                      <article
                        class="location reveal"
                        style={`--accent: ${cardAccentDeep(l.accent)}; --accent-soft: ${cardAccentSoft(l.accent)}; transition-delay: ${i * 100}ms`}
                      >
                        <div class="location__details">
                          <div class="location__summary">
                            <div class="location__head">
                              <div class="location__head-text">
                                <h3>
                                  <>
                                    <span class="location__name-first">
                                      {nameParts.first}
                                    </span>
                                    <span class="location__name-rest">
                                      {nameParts.rest}
                                    </span>
                                  </>
                                </h3>
                                <address class="location__address">
                                  <>
                                    <span class="location__address-street">
                                      {l.street}
                                    </span>
                                    <span class="location__address-sep">, </span>
                                    <span class="location__address-locality">
                                      {l.zip} {l.city}
                                    </span>
                                  </>
                                </address>
                              </div>
                            </div>
                          </div>

                          <span class="location__rule" aria-hidden="true" />

                          <div class="location__panel">
                            <div class="location__expandable">
                              <a
                                href={l.mapUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="location__nav-link"
                              >
                                Navigovat v Google Maps
                                <svg
                                  class="location__extern-icon"
                                  viewBox="0 0 24 24"
                                  width="16"
                                  height="16"
                                  aria-hidden="true"
                                >
                                  <path
                                    fill="currentColor"
                                    d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"
                                  />
                                  <path
                                    fill="currentColor"
                                    d="M5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"
                                  />
                                </svg>
                              </a>
                            </div>
                          </div>
                        </div>

                        <div class="location__map-shell">
                          <iframe
                            class="location__map-frame"
                            src={mapEmbed(l.mapCoords.lat, l.mapCoords.lng)}
                            title={`Mapa: ${l.name}`}
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            allowfullscreen
                          />
                          <a
                            href={l.mapUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="location__map-overlay"
                          >
                            Otevřít v Mapách
                            <svg
                              class="location__extern-icon"
                              viewBox="0 0 24 24"
                              width="16"
                              height="16"
                              aria-hidden="true"
                            >
                              <path
                                fill="currentColor"
                                d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"
                              />
                              <path
                                fill="currentColor"
                                d="M5 5h6V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2v6H5V5z"
                              />
                            </svg>
                          </a>
                        </div>
                      </article>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Mobile-first: stejná architektura jako Schedule — jedna karta, pill, divider, body.
   * Od 1024px desktop grid — 3 karty vedle sebe (pružné sloupce).
   */
  #lokace {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .locations .section-title-accent {
    color: var(--color-lilac-deep);
  }

  .locations__subtitle-cities {
    display: block;
  }

  .locations-tabs {
    width: min(100%, var(--card-grid-width));
    margin-inline: auto;
  }

  .locations__panel {
    width: 100%;
    margin: 0;
  }

  .locations__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    width: 100%;
  }

  .locations__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-10);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
    transition: background 220ms ease;
  }

  .locations-tabs__switcher {
    display: flex;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--radius-pill);
    border: 1.5px solid rgba(42, 31, 56, 0.12);
    background: transparent;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    white-space: nowrap;
    padding: 0;
    min-height: calc(2rem + 1em * var(--line-height-base));
  }

  .locations-tabs__item {
    display: block;
    flex: 1;
    min-width: 0;
  }

  .locations-tabs__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: var(--space-8) 0;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .locations-tabs__tab::-webkit-details-marker {
    display: none;
  }

  .locations-tabs__tab::marker {
    content: "";
  }

  details[open] > .locations-tabs__tab {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  details:not([open]) > .locations-tabs__tab:hover,
  details:not([open]) > .locations-tabs__tab:focus-visible {
    background: color-mix(in srgb, var(--color-ink) 4%, #fefefe);
    outline: none;
  }

  .locations__body {
    position: relative;
    z-index: 1;
  }

  .locations-tabs__panels .locations-tabs__panel {
    display: none;
    width: 100%;
    box-sizing: border-box;
  }

  .locations__card:has(.locations-tabs__switcher .locations-tabs__item:nth-child(1)[open])
    .locations-tabs__panels
    .locations-tabs__panel:nth-child(1),
  .locations__card:has(.locations-tabs__switcher .locations-tabs__item:nth-child(2)[open])
    .locations-tabs__panels
    .locations-tabs__panel:nth-child(2),
  .locations__card:has(.locations-tabs__switcher .locations-tabs__item:nth-child(3)[open])
    .locations-tabs__panels
    .locations-tabs__panel:nth-child(3) {
    display: block;
  }

  /* locations__rule = accent (taby); location__rule = šedý; mapa = location-divider */
  .location {
    --location-divider: 1px solid rgba(236, 47, 142, 0.16);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
    overflow: visible;
    box-shadow: none;
  }

  .locations__body .location {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    border: none;
    border-radius: 0;
    background: transparent;
    overflow: visible;
  }

  .locations__body .location__details {
    width: 100%;
    padding: 0;
    box-sizing: border-box;
  }

  .locations__body .location__head {
    padding-top: 0;
  }

  .locations__body .location__map-shell {
    width: calc(100% + 2 * var(--card-padding-x));
    max-width: none;
    margin-inline: calc(-1 * var(--card-padding-x));
    margin-top: var(--space-10);
    margin-bottom: calc(-1 * var(--card-padding-y));
    height: 13rem;
    max-height: 13rem;
  }

  @media (min-width: 768px) {
    .locations__subtitle-cities {
      display: inline;
    }

    .locations-tabs {
      width: min(100%, calc(2 * var(--card-grid-width-md) + var(--stack-gap)));
    }
  }

  @media (min-width: 1024px) {
    .locations-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-12);
      width: 100%;
      max-width: none;
      margin-inline: unset;
      justify-items: stretch;
      align-items: start;
    }

    .locations__panel {
      display: contents;
    }

    .locations__card {
      display: contents;
    }

    .locations-tabs__switcher,
    .locations__rule {
      display: none;
    }

    .locations__body {
      display: contents;
    }

    .locations-tabs__panels {
      display: contents;
    }

    .locations-tabs__panels .locations-tabs__panel {
      display: block !important;
    }

    .location {
      background: #fefefe;
      border-radius: var(--radius-card);
      overflow: hidden;
      border: var(--card-border);
      transition:
        transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 280ms ease;
    }

    .locations__body .location {
      border: var(--card-border);
      border-radius: var(--radius-card);
      background: #fefefe;
      overflow: hidden;
    }

    .locations__body .location__details {
      padding: var(--card-padding);
      padding-bottom: var(--space-12);
    }

    .locations__body .location__head {
      padding-top: var(--space-4);
    }

    .locations__body .location__map-shell,
    .location__map-shell {
      width: 100%;
      max-width: 100%;
      margin-inline: unset;
      margin-top: auto;
      margin-bottom: 0;
      height: clamp(11rem, 24vw, 14rem);
      max-height: none;
    }
  }

  .location__map-shell {
    position: relative;
    flex-shrink: 0;
    align-self: stretch;
    background: color-mix(in srgb, var(--color-cream-100) 82%, transparent);
    border-top: var(--location-divider);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 12px 28px -16px rgba(42, 31, 56, 0.06);
  }

  .location__map-frame {
    border: 0;
    width: 100%;
    height: 100%;
    display: block;
    /* Slightly softer than raw Google embed — easier on long viewing */
    filter: contrast(0.97) saturate(0.94);
  }

  .location__map-overlay {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-pill);
    background: #fff;
    color: #1a73e8;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .location__map-overlay:hover {
    background: #f8f9fa;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
  }

  .location__extern-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .location__details {
    position: relative;
    flex: 0 1 auto;
    width: 100%;
    min-height: 0;
    border: 0;
    padding: var(--card-padding);
    padding-bottom: var(--space-12);
    box-sizing: border-box;
  }

  .location__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    flex: 1 1 auto;
    min-height: 0;
  }

  .location__summary {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--space-6);
    padding: 0;
  }

  .location__expandable {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 0;
  }

  .location__head {
    width: 100%;
    margin-bottom: 0;
    padding-top: var(--space-4);
  }

  .location__head-text {
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 767px) {
    .location__head-text,
    .location__head-text .location__address {
      text-align: center;
    }
  }

  .location__head-text h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    margin: 0 0 var(--space-3);
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .location__name-first::after {
    content: " ";
  }

  .location__address {
    font-style: normal;
    margin: 0;
    font-size: var(--text-base);
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  @media (min-width: 1024px) and (max-width: 1179px) {
    .location__head-text {
      text-align: center;
    }

    .location__head-text h3 {
      margin: 0 0 var(--space-6);
    }

    .location__name-first::after {
      content: none;
    }

    .location__name-first,
    .location__name-rest {
      display: block;
    }

    .location__address {
      text-align: center;
    }

    .location__address-sep {
      display: none;
    }

    .location__address-street,
    .location__address-locality {
      display: block;
    }
  }

  @media (min-width: 1180px) {
    .locations-tabs {
      max-width: 64rem;
      margin-inline: auto;
    }

    .location__head-text {
      text-align: center;
    }

    .location__head-text h3 {
      margin: 0 0 var(--space-6);
    }

    .location__address {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: var(--space-none);
    }

    .location__address-sep {
      display: none;
    }

    .location__address-street::after {
      content: ",\00a0";
    }
  }

  .location__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-10);
    border: none;
    background: rgba(42, 31, 56, 0.12);
  }

  #lokace .location__nav-link {
    margin-top: auto;
    /* padding-top: var(--space-10); */
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-blush-deep);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition: border-color 180ms ease;
    align-self: flex-start;
  }

  #lokace .location__nav-link:hover {
    border-bottom-color: var(--color-blush-vivid);
  }

  @media (prefers-contrast: more) {
    .location__map-frame {
      filter: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    @media (min-width: 1024px) {
      .location:hover {
        transform: translateY(-4px);
        box-shadow: 0 26px 55px -18px color-mix(in srgb, var(--accent) 45%, transparent);
      }
    }
  }

  @media (min-width: 1024px) {
    .location:active {
      transform: translateY(-2px) scale(0.99);
      box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--accent) 35%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    @media (hover: hover) and (pointer: fine) {
      @media (min-width: 1024px) {
        .location:hover {
          transform: none;
        }
      }
    }

    @media (min-width: 1024px) {
      .location:active {
        transform: none;
      }
    }
  }
</style>

<script>
  const setupLocationsTabs = () => {
    const switcher = document.querySelector<HTMLElement>(".locations-tabs__switcher");
    if (!switcher || switcher.dataset.tabsReady === "true") return;
    switcher.dataset.tabsReady = "true";

    const card = switcher.closest<HTMLElement>(".locations__card");
    const items = switcher.querySelectorAll<HTMLDetailsElement>(".locations-tabs__item");

    const syncAccent = (item: HTMLDetailsElement) => {
      const accent = item.dataset.accent;
      const accentSoft = item.dataset.accentSoft;
      if (card && accent) {
        card.style.setProperty("--accent", accent);
      }
      if (card && accentSoft) {
        card.style.setProperty("--accent-soft", accentSoft);
      }
    };

    items.forEach((item) => {
      item.addEventListener("toggle", () => {
        if (item.open) syncAccent(item);
      });
    });

    const openItem = switcher.querySelector<HTMLDetailsElement>(
      ".locations-tabs__item[open]",
    );
    if (openItem) syncAccent(openItem);
  };

  setupLocationsTabs();
  document.addEventListener("astro:page-load", setupLocationsTabs);
</script>
