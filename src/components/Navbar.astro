---
import { Image } from "astro:assets";

import logo from "../assets/images/logo.png";
import type { NavLink } from "../config/routes";
import NavbarInteractive from "./NavbarInteractive";

type Props = {
  links: readonly NavLink[];
  mobileLinks?: readonly NavLink[];
  reservationUrl: string;
  brand: string;
  logoHref?: string;
  variant?: "default" | "solid";
};
---

<NavbarInteractive client:idle {...Astro.props}>
  <Image src={logo} alt="" width={52} densities={[2, 3]} format="webp" priority />
</NavbarInteractive>
