---
import { Icon } from "astro-icon/components";

import { ROUTE_IDS } from "../config/routes";
import { campFeatureIcons, camps, campsMeta } from "../data/camps";
import { site } from "../data/site";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";
---

<section id={ROUTE_IDS.home.camps} class="section camps" aria-labelledby="camps-title">
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Pojďte s námi ven</span>
      <h2 id="camps-title">
        Kempy pro rodiče <span class="section-title-accent">s dětmi</span>
      </h2>
      <p class="section-subtitle">
        Společně strávený čas plný pohybu, tvoření a zábavy pro děti i rodiče.
      </p>
    </header>

    <ol class="camps__list">
      {
        camps.map((c, i) => (
          <li
            class={`camp camp--${c.accent} reveal`}
            style={`--accent: ${cardAccentDeep(c.accent)}; --accent-soft: ${cardAccentSoft(c.accent)}; transition-delay: ${i * 100}ms`}
          >
            <div class="camp__body">
              <p class="camp__location-badge">
                <Icon
                  is:inline
                  name="ph:map-pin"
                  class="camp__location-icon"
                  aria-hidden="true"
                />
                {c.city}
              </p>
              <h3>{c.title}</h3>
              <div class="camp__icons" aria-hidden="true">
                {campFeatureIcons.map((item) => (
                  <span
                    class="camp__icon-ring"
                    style={`--accent: ${item.accentDeep}; --accent-soft: ${item.accentSoft};`}
                  >
                    <Icon
                      is:inline
                      name={item.icon}
                      class="camp__icon-graphic card-icon-graphic"
                    />
                  </span>
                ))}
              </div>
              <span class="camp__rule" aria-hidden="true" />
              <div class="camp__daily">
                <p class="camp__daily-badge">{campsMeta.dailyLabel}</p>
                <ul class="camp__daily-list" aria-label={campsMeta.dailyLabel}>
                  {campsMeta.dailyProgram.map((item) => (
                    <li class="camp__daily-item">{item}</li>
                  ))}
                </ul>
              </div>
              <span class="camp__rule" aria-hidden="true" />
              <div class="camp__meta">
                <p class="camp__meta-row">
                  <Icon
                    is:inline
                    name="lineicons:calendar-days"
                    class="camp__meta-icon"
                    aria-hidden="true"
                  />
                  {c.dateRange}
                </p>
                <p class="camp__meta-row">
                  <Icon
                    is:inline
                    name="ph:clock"
                    class="camp__meta-icon"
                    aria-hidden="true"
                  />
                  {c.time}
                </p>
                <p class="camp__meta-row camp__meta-row--venue">
                  <Icon
                    is:inline
                    name="fluent:home-heart-24-regular"
                    class="camp__meta-icon"
                    aria-hidden="true"
                  />
                  <span class="camp__meta-venue">
                    <span>{c.venue.name}</span>
                    {c.venue.address ? (
                      <span class="camp__meta-venue-address">{c.venue.address}</span>
                    ) : null}
                  </span>
                </p>
                <p class="camp__meta-row camp__meta-row--audience">
                  <Icon
                    is:inline
                    name="fluent:people-24-regular"
                    class="camp__meta-icon"
                    aria-hidden="true"
                  />
                  <span class="camp__meta-audience">
                    <span>{c.audience.primary}</span>
                    <span>{c.audience.secondary}</span>
                  </span>
                </p>
              </div>
            </div>

            <div class="camp__footer">
              <p class="camp__price">
                <span class="camp__price-label">{campsMeta.priceLabel}</span>
                <span class="camp__price-value">{c.price}</span>
              </p>
              <div class="camp__cta">
                <a
                  href={site.signupFormUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                >
                  {campsMeta.signupLabel}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  #kempy {
    scroll-margin-top: var(--section-scroll-margin);
  }
  .camps {
    --card-icon-size: 4.125rem;
    --card-icon-graphic-size: 1.875rem;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--color-cream) 30%,
      var(--color-cream) 70%,
      transparent 100%
    );
  }

  .camps .section-title-accent {
    color: var(--color-lilac-deep);
  }

  @media (max-width: 1023px) {
    #camps-title .section-title-accent {
      display: block;
    }
  }

  .camps__list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: 100%;
    max-width: var(--card-grid-width);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--stack-gap);
    justify-content: center;
  }

  .camp {
    --accent-color: var(--color-blush-vivid);

    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    overflow: visible;
    background: white;
    border-radius: var(--radius-card);
    border: var(--card-border);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .camp--blush {
    --accent-color: var(--color-blush-vivid);
  }
  .camp--sky {
    --accent-color: var(--accent);
  }
  .camp--lilac {
    --accent-color: var(--color-lilac-deep);
  }

  @media (hover: hover) and (pointer: fine) {
    .camp:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 40px -18px
        color-mix(in srgb, var(--accent-color) 40%, transparent);
    }
  }

  @media (hover: hover) and (pointer: fine) and (max-width: 1023px) {
    .camp:hover {
      border-color: color-mix(in srgb, var(--accent-color) 40%, white);
    }
  }

  @media (min-width: 1024px) {
    .camp {
      border: 1px solid color-mix(in srgb, var(--color-ink) 10%, #fefefe);
    }

    @media (hover: hover) and (pointer: fine) {
      .camp:hover {
        border-color: color-mix(in srgb, var(--color-ink) 10%, #fefefe);
        box-shadow: 0 24px 48px -16px rgba(42, 31, 56, 0.1);
      }
    }
  }

  .camp__body {
    padding: var(--card-padding);
    text-align: center;
  }

  .camp__body h3 {
    font-size: var(--text-h3);
    margin: 0 0 var(--space-10);
    line-height: var(--line-height-xl);
  }

  .camp__location-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0 0 var(--space-8);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-full);
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: var(--line-height-sm);
  }

  .camp__location-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .camp__icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-10);
  }

  .camp__icon-ring {
    display: grid;
    place-items: center;
    width: var(--card-icon-size);
    height: var(--card-icon-size);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    flex-shrink: 0;
  }

  .camp__icon-graphic {
    width: var(--card-icon-graphic-size);
    height: var(--card-icon-graphic-size);
  }

  .camp__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-14);
    border: none;
    background: color-mix(in srgb, var(--accent-color) 30%, var(--color-ink) 8%);
    transition: background 220ms ease;
  }

  .camp__daily + .camp__rule {
    background: rgba(42, 31, 56, 0.12);
  }

  .camp__daily {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
  }

  .camp__daily-badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent-color);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: var(--line-height-sm);
    text-transform: uppercase;
  }

  .camp__daily-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .camp__daily-item {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .camp__daily-item + .camp__daily-item::before {
    content: "";
    flex-shrink: 0;
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-full);
    background: var(--accent-color);
  }

  .camp__meta {
    text-align: left;
  }

  .camp__meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    margin: 0 0 var(--space-12);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .camp__meta-row:last-child {
    margin-bottom: 0;
  }

  .camp__meta-row--audience,
  .camp__meta-row--venue {
    align-items: center;
  }

  .camp__meta-audience,
  .camp__meta-venue {
    display: flex;
    flex-direction: column;
  }

  .camp__meta-venue-address {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .camp__meta-icon {
    flex-shrink: 0;
    width: var(--space-13);
    height: var(--space-13);
    color: var(--accent-color);
  }

  .camp__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    margin-top: auto;
    padding: var(--space-12) var(--card-padding);
    background: var(--accent-soft);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    text-align: center;
  }

  .camp__cta {
    /* DOČASNĚ SKRYTO (mobil i počítač) — pro vrácení smaž řádek display: none */
    display: none;
    position: relative;
    z-index: 1;
    justify-content: center;
    width: 100%;
  }

  .camp__price {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-6);
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--line-height-lg);
    color: var(--accent-color);
  }

  .camp__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    min-width: max-content;
    box-shadow: none;
  }

  @media (min-width: 768px) {
    .camp__cta :global(.btn) {
      width: auto;
      max-width: none;
      min-width: 0;
    }
  }

  .camp .camp__cta :global(.btn-primary) {
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .camp .camp__cta :global(.btn-primary::before) {
    background: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .camp .camp__cta :global(.btn-primary:hover) {
      box-shadow: 0 22px 50px -16px color-mix(in srgb, var(--accent) 60%, transparent);
    }
  }

  .camp .camp__cta :global(.btn-primary:active) {
    box-shadow: 0 22px 50px -16px color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translate3d(0, 0, 0) scale(0.98);
  }

  @media (min-width: 920px) {
    .camps__list {
      --camp-card-width: var(--card-grid-width-md);
      width: fit-content;
      max-width: calc(2 * var(--camp-card-width) + var(--stack-gap));
      grid-template-columns: repeat(2, var(--camp-card-width));
      gap: var(--stack-gap);
      margin-inline: auto;
    }
  }

  @media (min-width: 1180px) {
    .camps__list {
      --camp-card-width: var(--card-grid-width);
    }
  }
</style>
