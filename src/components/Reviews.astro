---
import { reviews } from "../data/reviews";

const accentMap: Record<string, string> = {
  blush: "var(--color-blush-mid)",
  sky: "var(--color-sky-mid)",
  lilac: "var(--color-lilac-mid)",
};
---

<section id="recenze" class="section reviews" aria-labelledby="reviews-title">
  <div class="container-x">
    <header class="reviews__header reveal">
      <span class="eyebrow">Co o nás říkají</span>
      <h2 id="reviews-title">
        Recenze <span class="section-title-accent">od rodičů</span>
      </h2>
      <p>
        Pár slov od maminek, které u nás cvičí. Děkujeme za vaši důvěru.
      </p>
    </header>

    <ul class="reviews__grid">
      {reviews.map((r, i) => (
        <li
          class="review reveal"
          style={`--accent: ${accentMap[r.accent]}; transition-delay: ${i * 90}ms;`}
        >
          <div class="review__quote-mark" aria-hidden="true">"</div>

          {r.rating && (
            <div class="review__stars" aria-label={`Hodnocení ${r.rating} z 5`}>
              {Array.from({ length: 5 }, (_, k) => (
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class={k < (r.rating ?? 0) ? "is-on" : ""}>
                  <path
                    d="M 12 2 L 14.5 8.5 L 21 9 L 16 13.5 L 17.5 20 L 12 16.5 L 6.5 20 L 8 13.5 L 3 9 L 9.5 8.5 Z"
                    fill="currentColor"
                  />
                </svg>
              ))}
            </div>
          )}

          <blockquote class="review__text">{r.text}</blockquote>

          <div class="review__author">
            <span class="review__author-avatar" aria-hidden="true">
              {r.author.charAt(0)}
            </span>
            <div>
              <strong>{r.author}</strong>
              <span>{r.childAge}</span>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }

  .reviews__header h2 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .reviews__header h2 .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .reviews__header p { color: var(--color-ink-soft); margin: 0; }

  .reviews__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .review {
    position: relative;
    background: white;
    border-radius: var(--radius-card);
    padding: 2.25rem 1.75rem 1.75rem;
    border: 2px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 280ms ease, box-shadow 280ms ease;
  }

  .review:hover {
    transform: translateY(-4px) rotate(0.4deg);
    box-shadow: 0 20px 50px -16px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .review__quote-mark {
    position: absolute;
    top: -0.5rem;
    left: 1.25rem;
    width: 48px;
    height: 48px;
    background: var(--accent);
    color: white;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 0;
    padding-top: 8px;
    box-shadow: 0 8px 22px -8px color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .review__stars {
    display: inline-flex;
    gap: 2px;
    color: rgba(42, 31, 56, 0.15);
  }

  .review__stars svg.is-on {
    color: #f5b400;
  }

  .review__text {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.02rem;
    line-height: 1.55;
    font-style: italic;
    quotes: "„" "" "" "";
  }

  .review__text::before { content: open-quote; }
  .review__text::after  { content: close-quote; }

  .review__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(42, 31, 56, 0.12);
  }

  .review__author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 35%, white);
    color: color-mix(in srgb, var(--accent) 70%, var(--color-ink));
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .review__author strong {
    display: block;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.1;
  }

  .review__author span {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
</style>
