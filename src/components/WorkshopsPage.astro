      box-shadow: 0 26px 55px -18px color-mix(in srgb, var(--accent) 45%, transparent);
    }

    .workshop:hover .workshop__icon {
      transform: translate(-50%, -50%) scale(1.05);
    }

    .workshop__date-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 36px -14px color-mix(in srgb, var(--accent) 40%, transparent);
    }

    .workshop .workshops-page__cta :global(.btn-primary:hover) {
      box-shadow: 0 22px 50px -16px color-mix(in srgb, var(--accent) 60%, transparent);
    }
  }
</style>

<script>
  const readCssVarLength = (el: Element, varName: string) => {
    const probe = document.createElement("div");
    probe.style.position = "absolute";
    probe.style.visibility = "hidden";
    probe.style.pointerEvents = "none";
    probe.style.height = `var(${varName})`;
    el.appendChild(probe);
    const px = probe.getBoundingClientRect().height;
    probe.remove();
    return px;
  };

  const setupWorkshopsPageNav = () => {
    const page = document.querySelector<HTMLElement>(".workshops-page");
    if (!page || page.dataset.navReady === "true") return;
    page.dataset.navReady = "true";

    const scrollEl = page.querySelector<HTMLElement>("[data-workshops-nav-scroll]");
    const thumbEl = page.querySelector<HTMLElement>("[data-workshops-nav-thumb]");
    const scrollbarEl = thumbEl?.closest<HTMLElement>(".workshops-page__nav-scrollbar");

    const updateNavScrollbar = () => {
      if (!scrollEl || !thumbEl || !scrollbarEl) return;

      const { scrollWidth, clientWidth, scrollLeft } = scrollEl;
      const trackWidth = scrollbarEl.clientWidth;
      const overflow = scrollWidth - clientWidth;

      if (overflow <= 1) {
        scrollbarEl.classList.add("is-hidden");
        thumbEl.style.width = "100%";
        thumbEl.style.transform = "translateX(0)";
        return;
      }

      scrollbarEl.classList.remove("is-hidden");
      const thumbWidth = Math.max((clientWidth / scrollWidth) * trackWidth, 40);
      const maxThumbTravel = trackWidth - thumbWidth;
      const thumbOffset = (scrollLeft / overflow) * maxThumbTravel;

      thumbEl.style.width = `${thumbWidth}px`;
      thumbEl.style.transform = `translateX(${thumbOffset}px)`;
    };

    scrollEl?.addEventListener("scroll", updateNavScrollbar, {
      passive: true,
    });
    window.addEventListener("resize", updateNavScrollbar, { passive: true });
    updateNavScrollbar();

    page
      .querySelectorAll<HTMLAnchorElement>(
        '.workshops-page__pill-link[href^="#"], .workshops-page__pill-all-dates[href^="#"]',
      )
      .forEach((link) => {
        link.addEventListener("click", (event) => {
          const href = link.getAttribute("href");
          if (!href?.startsWith("#")) return;

          const target = document.querySelector(href);
          if (!target) return;

          event.preventDefault();

          if (link.classList.contains("workshops-page__pill-all-dates")) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            history.replaceState(null, "", href);
            return;
          }

          const offset = readCssVarLength(link, "--workshops-page-scroll-offset");
          const top = target.getBoundingClientRect().top + window.scrollY - offset;

          window.scrollTo({ top, behavior: "smooth" });
          history.replaceState(null, "", href);
        });
      });
  };

  setupWorkshopsPageNav();

  const setupWorkshopsTermsAccordions = () => {
    document.querySelectorAll<HTMLElement>("[data-workshop-terms]").forEach((terms) => {
      if (terms.dataset.termsReady === "true") return;
      terms.dataset.termsReady = "true";

      const toggle = terms.querySelector<HTMLButtonElement>(".workshop__terms-toggle");
      const dates = terms.querySelector<HTMLElement>(".workshop__dates");
      if (!toggle || !dates) return;

      const syncToggle = () => {
        const expanded = terms.classList.contains("is-expanded");
        toggle.setAttribute("aria-expanded", String(expanded));
        dates.setAttribute("aria-hidden", String(!expanded));
      };

      toggle.addEventListener("click", () => {
        terms.classList.toggle("is-expanded");
        syncToggle();
      });

      syncToggle();
    });
  };

  setupWorkshopsTermsAccordions();
  document.addEventListener("astro:page-load", setupWorkshopsPageNav);
  document.addEventListener("astro:page-load", setupWorkshopsTermsAccordions);
</script>
