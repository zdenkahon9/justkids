  .workshops-page__cta {
    /* DOČASNĚ SKRYTO (mobil i počítač) — pro vrácení změň display zpět na flex */
    display: none;
    justify-content: center;
    width: 100%;
  }

  .workshops-page__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    min-width: max-content;
    box-shadow: none;
  }

  .workshop .workshops-page__cta :global(.btn-primary) {
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .workshop .workshops-page__cta :global(.btn-primary::before) {
    background: var(--accent);
  }

  .workshop .workshops-page__cta :global(.btn-primary:active) {
    box-shadow: 0 22px 50px -16px color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translate3d(0, 0, 0) scale(0.98);
