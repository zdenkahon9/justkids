---
import { Icon } from "astro-icon/components";

import { site } from "../data/site";
import { workshopIconById, workshops, workshopsHomeMeta } from "../data/WorkshopsHome";
import { workshopsPageMeta } from "../data/WorkshopsPage";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";
import { sortWorkshopDates } from "../utils/sortWorkshopDates";

const workshopsPageGridId = "workshops-page-grid";

const meta = workshopsHomeMeta;
const pageMeta = workshopsPageMeta;
---

<section
  id={pageMeta.sectionId}
  class="section workshops-page"
  aria-labelledby="workshops-title"
>
  <div class="workshops-page__intro">
    <div class="workshops-page__intro-nav-bg" aria-hidden="true">
      <div class="workshops-page__intro-photo"></div>
      <div class="workshops-page__intro-veil"></div>
    </div>
    <div class="container-x workshops-page__intro-inner">
      <header class="section-header reveal">
        <div class="workshops-page__head">
          <h1 id="workshops-title">
            {meta.title}{" "}
            <span class="section-title-accent">{meta.titleAccent}</span>
          </h1>
          <p class="section-subtitle">{pageMeta.subtitle}</p>
        </div>
      </header>
    </div>
  </div>

  <div class="container-x">
    <div class="workshops-page__filter reveal">
      <div class="workshops-page__nav">
        <div class="workshops-page__nav-scroll" data-workshops-nav-scroll>
          <nav class="workshops-page__nav-track" aria-label="Přejít na workshop">
            {
              workshops.map((w) => (
                <div
                  class="workshops-page__pill workshops-page__pill--nav"
                  style={`--accent: ${cardAccentDeep(w.accent)}; --accent-soft: ${cardAccentSoft(w.accent)};`}
                >
                  <a href={`#${w.id}`} class="workshops-page__pill-link">
                    {w.title}
                  </a>
                </div>
              ))
            }
          </nav>
        </div>
        <div class="workshops-page__nav-scrollbar" aria-hidden="true">
          <span class="workshops-page__nav-scrollbar-thumb" data-workshops-nav-thumb
          ></span>
        </div>
      </div>

      <div class="workshops-page__pill workshops-page__pill--all-dates">
        <a href={`#${pageMeta.allDatesSectionId}`} class="workshops-page__pill-all-dates">
          <span class="workshops-page__pill-all-dates-icon" aria-hidden="true">
            <Icon
              is:inline
              name="lineicons:calendar-days"
              class="workshops-page__pill-all-dates-graphic"
            />
          </span>
          {pageMeta.showAllDatesLabel}
        </a>
      </div>
    </div>

    <ul id={workshopsPageGridId} class="workshops__grid">
      {
        workshops.map((w) => (
          <li
            id={w.id}
            class="workshop"
            style={`--accent: ${cardAccentDeep(w.accent)}; --accent-soft: ${cardAccentSoft(w.accent)}`}
          >
            <span class="workshop__icon" aria-hidden="true">
              <Icon
                is:inline
                name={workshopIconById[w.id] ?? "streamline-sharp:health-care-2"}
                class="workshop__icon-graphic"
              />
            </span>
            <div class="workshop__header">
              <div class="workshop__lead">
                <h3>{w.title}</h3>
              </div>
              {w.ageRange ? <span class="workshop__age">{w.ageRange}</span> : null}
            </div>
            <span class="workshops-page__rule" aria-hidden="true" />

            {/* summary → WorkshopsHome (data v WorkshopsHome.ts), zatím bez renderu */}
            {/* <p class="workshop__summary">{w.summary}</p> */}

            <div class="workshop__details">
              <p class="workshop__highlights-label">Co vás čeká</p>
              <ul class="workshop__highlights">
                {w.highlights.map((item) => (
                  <li>
                    <Icon
                      is:inline
                      name="ph:check-circle-fill"
                      class="workshop__highlight-icon"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <hr class="workshops-page__divider" aria-hidden="true" />
              {w.price ? (
                <>
                  <div class="workshop__price">
                    <p class="workshop__price-label">{pageMeta.priceLabel}</p>
                    <p class="workshop__price-value">
                      {w.price ?? pageMeta.defaultPrice}
                    </p>
                  </div>
                  <hr class="workshops-page__divider" aria-hidden="true" />
                </>
              ) : null}
              {w.dates?.length ? (
                <>
                  <div class="workshop__terms" data-workshop-terms>
                    <button
                      type="button"
                      class="workshop__terms-toggle"
                      aria-expanded="false"
                      aria-controls={`workshop-dates-${w.id}`}
                    >
                      <span
                        class="workshop__terms-label"
                        id={`workshop-terms-label-${w.id}`}
                      >
                        {pageMeta.termsLabel}
                      </span>
                      <svg
                        class="workshop__terms-chevron"
                        width="20"
                        height="20"
                        viewBox="0 0 12 12"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                      >
                        <path
                          d="M2.5 4.25L6 7.75L9.5 4.25"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul
                      id={`workshop-dates-${w.id}`}
                      class="workshop__dates"
                      role="region"
                      aria-labelledby={`workshop-terms-label-${w.id}`}
                    >
                      {sortWorkshopDates(w.dates ?? []).map((date) => (
                        <li>
                          <a
                            class="workshop__date-card"
                            href={date.href ?? site.signupFormUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Rezervovat ${w.title}, ${date.day}. ${date.month}, ${date.time}, ${date.venueName}`}
                          >
                            <div class="workshop__date-card-date" aria-hidden="true">
                              <span class="workshop__date-day">{date.day}</span>
                              <span class="workshop__date-month">{date.month}</span>
                            </div>
                            <div class="workshop__date-card-body">
                              <p class="workshop__date-venue">{date.venueName}</p>
                              <p class="workshop__date-time">{date.time}</p>
                            </div>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <hr class="workshops-page__divider" aria-hidden="true" />
                  <div class="workshops-page__cta">
                    <a
                      class="btn btn-primary"
                      href={site.signupFormUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {pageMeta.signupLabel}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </>
              ) : null}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .workshops-page {
    --workshops-page-anchor-offset: calc(
      var(--nav-height) + var(--space-9) - var(--space-1)
    );
    --section-header-spacing: 3rem;
    padding-top: 0;
    scroll-margin-top: var(--nav-height);
    background-color: var(--color-cream);
  }

  /* Mini page-hero — pod navbarom stejná vrstva jako na AgeGroupsPage */
  .workshops-page__intro {
    position: relative;
    background-color: var(--color-cream);
  }

  .workshops-page__intro-nav-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .workshops-page__intro-photo {
    position: absolute;
    left: -3%;
    right: -3%;
    top: -3svh;
    height: 106svh;
    background-image: url("/images/hero-balloons.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    transform-origin: center top;
  }

  .workshops-page__intro-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100svh;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.55) 72%,
        rgba(255, 249, 244, 0.95) 100%
      );
  }

  .workshops-page__intro-inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-height) + var(--section-header-spacing));
  }

  .workshops-page__intro .section-header {
    margin-bottom: 4rem;
  }

  .workshops-page .section-header h1 {
    font-size: var(--text-clamp-h2);
    margin: 0 0 var(--space-8);
  }

  /* Mobile-first: centrovaný nadpis + podnadpis; od 640px průhledný obal */
  .workshops-page__head {
    display: inline-grid;
    grid-template-columns: minmax(0, max-content);
    justify-items: stretch;
    max-width: 100%;
    margin-inline: auto;
    text-align: center;
  }

  .workshops-page__head h1,
  .workshops-page .section-subtitle {
    grid-column: 1;
  }

  .workshops-page .section-subtitle {
    width: 0;
    min-width: 100%;
    white-space: pre-line;
    text-wrap: pretty;
  }

  .workshops-page .section-title-accent {
    color: var(--color-sky-deep);
  }

  .workshops-page__filter {
    position: relative;
    z-index: 10;
    width: min(100%, var(--card-grid-width));
    margin: 0 auto var(--space-12);
  }

  .workshops-page__nav {
    margin-bottom: 0;
  }

  .workshops-page__nav-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .workshops-page__nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .workshops-page__nav-track {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
    width: max-content;
    min-width: 100%;
    padding-bottom: var(--space-1);
  }

  /* Pill — stejný vizuál jako .age-page__pill na AgeGroupsPage */
  .workshops-page__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--radius-pill);
    border: 1.5px solid rgba(42, 31, 56, 0.12);
    background: #fefefe;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    white-space: nowrap;
    padding: var(--space-4) 1.625rem;
    min-height: calc(2rem + 1em * var(--line-height-base));
  }

  .workshops-page__nav + .workshops-page__pill {
    margin-top: var(--space-4);
  }

  .workshops-page__pill--nav {
    width: auto;
    flex: 0 0 auto;
    padding: 0;
    align-items: stretch;
  }

  .workshops-page__pill-link {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: var(--space-4) 1.625rem;
    color: var(--accent);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    --workshops-page-scroll-offset: var(--workshops-page-anchor-offset);
    transition: background-color 220ms ease;
  }

  .workshops-page__pill-link:hover,
  .workshops-page__pill-link:focus-visible,
  .workshops-page__pill-link:active {
    background: var(--accent-soft);
    outline: none;
  }

  .workshops-page__nav-scrollbar {
    position: relative;
    height: 0.25rem;
    margin-top: var(--space-3);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    overflow: hidden;
  }

  .workshops-page__nav-scrollbar-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    min-width: 2.5rem;
    border-radius: inherit;
    background: color-mix(in srgb, var(--color-ink) 28%, transparent);
    transform: translateX(0);
    transition: transform 80ms linear;
    will-change: transform, width;
  }

  .workshops-page__nav-scrollbar.is-hidden .workshops-page__nav-scrollbar-thumb {
    width: 100% !important;
    transform: translateX(0) !important;
    opacity: 0.35;
  }

  .workshops-page__pill--all-dates {
    padding: 0;
    align-items: stretch;
    background: transparent;
  }

  .workshops-page__pill-all-dates {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    gap: var(--space-2);
    width: 100%;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: var(--space-4) 1.625rem;
    background: #fefefe;
    color: var(--color-ink);
    --workshops-page-scroll-offset: var(--workshops-page-anchor-offset);
    font: inherit;
    font-weight: 600;
    line-height: var(--line-height-base);
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .workshops-page__pill-all-dates:hover,
  .workshops-page__pill-all-dates:focus-visible,
  .workshops-page__pill-all-dates:active {
    background: var(--color-lilac-deep);
    color: #fefefe;
    outline: none;
  }

  .workshops-page__pill-all-dates-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-lilac-deep);
    transition: color 220ms ease;
  }

  .workshops-page__pill-all-dates:hover .workshops-page__pill-all-dates-icon,
  .workshops-page__pill-all-dates:focus-visible .workshops-page__pill-all-dates-icon,
  .workshops-page__pill-all-dates:active .workshops-page__pill-all-dates-icon {
    color: #fefefe;
  }

  .workshops-page__pill-all-dates-graphic {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .workshops-page__pill-all-dates-graphic :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  #workshops-page-grid {
    scroll-margin-top: var(--workshops-page-anchor-offset);
  }

  /* Mobile-first: responzivní mřížka karet */
  .workshops__grid {
    --workshop-card-width: var(--card-grid-width);
    --workshop-icon-size: calc(var(--card-icon-size-corner) - var(--space-1));
    --workshop-icon-graphic-size: calc(var(--footer-social-icon-size) + var(--space-1));
    --workshop-icon-overlap: calc(var(--workshop-icon-size) / 2);
    list-style: none;
    padding: var(--workshop-icon-overlap) 0 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--workshop-card-width));
    gap: calc(var(--stack-gap) + var(--workshop-icon-overlap));
    justify-content: center;
  }

  .workshop {
    --workshop-title: #2d3748;
    --workshop-body: #4a5568;
    scroll-margin-top: calc(var(--workshops-page-anchor-offset) + var(--space-6));
    position: relative;
    overflow: visible;
    background: #fefefe;
    border-radius: var(--radius-card);
    padding: calc(var(--card-padding-y) + var(--workshop-icon-overlap))
      var(--card-padding-x) var(--card-padding-y);
    box-shadow: none;
    border: var(--card-border);
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshop__age,
  /* .workshop__summary, */
  .workshop__details,
  .workshop__highlights-label,
  .workshop__terms,
  .workshop__terms-label,
  .workshop__dates,
  .workshop__price,
  .workshops-page__divider,
  .workshops-page__cta,
  .workshop__more,
  .workshops-page__rule {
    position: relative;
    z-index: 1;
  }

  .workshop__header {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 0;
  }

  /* Nadpis pod překryvnou ikonou */
  .workshop__lead {
    width: 100%;
    margin: 0 0 var(--space-3);
    box-sizing: border-box;
  }

  /* Ikona napůl nad kartou, napůl uvnitř */
  .workshop__icon {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--workshop-icon-size);
    height: var(--workshop-icon-size);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    transform: translate(-50%, -50%);
    transition: transform 280ms ease;
  }

  .workshop__icon-graphic {
    width: var(--workshop-icon-graphic-size);
    height: var(--workshop-icon-graphic-size);
  }

  .workshop__lead h3 {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--line-height-xl);
    text-align: center;
    color: var(--color-ink);
  }

  .workshops-page__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-7) 0 var(--space-7);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
    transition: background 220ms ease;
  }

  .workshop__age {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--line-height-lg);
    color: var(--accent);
  }

  /* .workshop__summary {
    margin: 0 0 var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-ink);
  } */

  .workshop__details {
    padding-inline: 0;
    border-radius: var(--radius-pill);
  }

  .workshop__highlights-label {
    margin: 0 0 var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--line-height-base);
    color: var(--accent);
  }

  .workshop__terms-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }

  .workshop__terms-label {
    margin: 0;
    flex: 1;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--line-height-base);
    color: inherit;
  }

  .workshop__terms.is-expanded .workshop__terms-toggle {
    margin-bottom: var(--space-8);
  }

  .workshop__terms-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .workshop__price-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--line-height-base);
    color: var(--accent);
  }

  .workshop__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .workshop__highlights > li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-page__divider {
    border: none;
    height: 1px;
    margin: var(--space-7) 0 var(--space-7);
    background: rgba(42, 31, 56, 0.12);
  }

  /* DOČASNĚ SKRYTO — divider pod nejbližšími termíny (nad skrytým tlačítkem).
     Pro vrácení smaž celé toto pravidlo. */
  .workshops-page__divider:has(+ .workshops-page__cta) {
    display: none;
  }

  .workshop__price {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
  }

  .workshop__price-value {
    margin: 0;
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--line-height-lg);
    text-align: right;
    color: var(--color-ink);
  }

  .workshop__highlight-icon {
    flex-shrink: 0;
    width: var(--text-3xl);
    height: var(--text-3xl);
    color: var(--accent);
  }

  .workshop__terms-chevron {
    display: block;
    flex-shrink: 0;
    width: var(--text-xl);
    height: var(--text-xl);
    transition: transform 220ms ease;
  }

  .workshop__terms.is-expanded .workshop__terms-chevron {
    transform: rotate(180deg);
  }

  .workshop__dates {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: none;
    flex-direction: column;
    gap: var(--space-3);
  }

  .workshop__terms.is-expanded .workshop__dates {
    display: flex;
    margin-top: 0;
  }

  .workshop__date-card {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: 0;
