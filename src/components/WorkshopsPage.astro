      min-height: calc(
        7 * max(var(--text-3xl), calc(var(--text-lg) * var(--line-height-base))) + 6 *
          var(--space-4)
      );
    }

    /* 3. karta je v 2. řádku → menší offset, ať po scrollu vyjede výš
       a schová spodní okraje karet z řádku nad ní */
    .workshops__grid .workshop:nth-child(3) {
      scroll-margin-top: calc(var(--nav-height) + var(--space-8));
    }

    .workshop__highlights-label,
    .workshop__terms-label,
    .workshop__price-label {
      font-size: var(--text-xl);
    }

    .workshop__highlights > li > span {
