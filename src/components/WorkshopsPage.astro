---
import Icon from "astro-iconify";
import { workshops, workshopsHomeMeta } from "../data/WorkshopsHome";
import { workshopsPageMeta } from "../data/WorkshopsPage";
import { site } from "../data/site";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = workshopsHomeMeta;
const pageMeta = workshopsPageMeta;

/** Iconify názvy (sada:id) — mapování podle id z WorkshopsHome.ts */
const workshopIconById: Record<string, string> = {
  "prvni-pomoc-u-deti": "fluent:briefcase-medical-24-regular",
  "handling-a-psychomotoricky-vyvoj": "streamline-sharp:health-care-2",
  "psychomotoricky-vyvoj-prevence": "ph:brain",
};
---

<section
  id={pageMeta.sectionId}
  class="section workshops-page"
  aria-labelledby="workshops-title"
>
  <div class="workshops-page__intro">
    <div class="workshops-page__intro-nav-bg" aria-hidden="true">
      <div class="workshops-page__intro-photo"></div>
      <div class="workshops-page__intro-veil"></div>
    </div>
    <div class="container-x workshops-page__intro-inner">
      <header class="section-header reveal">
        <h1 id="workshops-title">
          {meta.title}{" "}
          <span class="section-title-accent">{meta.titleAccent}</span>
        </h1>
        <p class="section-subtitle">{pageMeta.subtitle}</p>
      </header>
    </div>
  </div>

  <div class="container-x">
    <ul class="workshops__grid">
      {
        workshops.map((w, i) => (
          <li
            class="workshop reveal"
            style={`--accent: ${cardAccentDeep(w.accent)}; --accent-soft: ${cardAccentSoft(w.accent)}; transition-delay: ${i * 80}ms`}
          >
            <span class="workshop__icon" aria-hidden="true">
              <Icon
                name={workshopIconById[w.id] ?? "streamline:health-care-2"}
                class="workshop__icon-graphic"
              />
            </span>
            <div class="workshop__header">
              <div class="workshop__lead">
                <h3>{w.title}</h3>
              </div>
              {w.ageRange ? (
                <span class="workshop__age">{w.ageRange}</span>
              ) : null}
            </div>
            <span class="workshops-page__rule" aria-hidden="true" />

            {/* summary → WorkshopsHome (data v WorkshopsHome.ts), zatím bez renderu */}
            {/* <p class="workshop__summary">{w.summary}</p> */}

            <div class="workshop__details">
              <p class="workshop__highlights-label">Co vás čeká</p>
              <ul class="workshop__highlights">
                {w.highlights.map((item) => (
                  <li>
                    <Icon
                      name="ph:check-circle-fill"
                      class="workshop__highlight-icon"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <hr class="workshops-page__divider" aria-hidden="true" />
              {w.price ? (
                <>
                  <div class="workshop__price">
                    <p class="workshop__price-label">{pageMeta.priceLabel}</p>
                    <p class="workshop__price-value">{w.price}</p>
                  </div>
                  <hr class="workshops-page__divider" aria-hidden="true" />
                </>
              ) : null}
              {w.dates?.length ? (
                <>
                  <p class="workshop__terms-label">{pageMeta.termsLabel}</p>
                  <ul class="workshop__dates">
                    {w.dates.map((date) => (
                      <li>
                        <a
                          class="workshop__date-card"
                          href={date.href ?? site.reservationUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Rezervovat ${w.title}, ${date.day}. ${date.month}, ${date.time}, ${date.venueName}`}
                        >
                          <div
                            class="workshop__date-card-date"
                            aria-hidden="true"
                          >
                            <span class="workshop__date-day">{date.day}</span>
                            <span class="workshop__date-month">
                              {date.month}
                            </span>
                          </div>
                          <div class="workshop__date-card-body">
                            <p class="workshop__date-venue">{date.venueName}</p>
                            <p class="workshop__date-time">{date.time}</p>
                            <p class="workshop__date-spots">
                              {pageMeta.spotsLabel}
                            </p>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <hr class="workshops-page__divider" aria-hidden="true" />
                  <div class="workshops-page__cta">
                    <a
                      class="btn btn-primary"
                      href={site.reservationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {pageMeta.signupLabel}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </>
              ) : null}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="workshops-page__footer reveal">
      <a class="btn btn-ghost workshops-page__back-btn" href="/">
        <span aria-hidden="true">←</span> Zpět na hlavní stránku
      </a>
    </div>
  </div>
</section>

<style>
  .workshops-page {
    padding-top: 0;
    scroll-margin-top: var(--nav-height);
    background-color: var(--color-cream);
  }

  /* Mini page-hero — pod navbarom stejná vrstva jako na AgeGroupsPage */
  .workshops-page__intro {
    position: relative;
    background-color: var(--color-cream);
  }

  .workshops-page__intro-nav-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .workshops-page__intro-photo {
    position: absolute;
    left: -3%;
    right: -3%;
    top: -3svh;
    height: 106svh;
    background-image: url("/images/hero-balloons.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    transform-origin: center top;
  }

  .workshops-page__intro-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100svh;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.55) 72%,
        rgba(255, 249, 244, 0.95) 100%
      );
  }

  .workshops-page__intro-inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-height) + var(--section-header-spacing));
  }

  .workshops-page__intro .section-header {
    margin-bottom: var(--section-header-spacing);
  }

  .workshops-page .section-header h1 {
    font-size: var(--text-clamp-h2);
    margin: 0 0 var(--h2-title-gap);
  }

  .workshops-page .section-title-accent {
    color: var(--color-sky-deep);
  }

  @media (max-width: 639px) {
    .workshops-page {
      --section-header-spacing: 3rem;
      padding-bottom: 0;
    }

    .workshops-page .section-header {
      --section-header-spacing: 3rem;
    }
  }

  /* Mobile-first: responzivní mřížka karet */
  .workshops__grid {
    --workshop-card-width: var(--card-grid-width);
    --workshop-icon-size: calc(var(--card-icon-size-corner) - var(--space-1));
    --workshop-icon-graphic-size: calc(
      var(--footer-social-icon-size) + var(--space-1)
    );
    --workshop-icon-overlap: calc(var(--workshop-icon-size) / 2);
    list-style: none;
    padding: var(--workshop-icon-overlap) 0 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--workshop-card-width));
    gap: calc(var(--stack-gap) + var(--workshop-icon-overlap));
    justify-content: center;
  }

  .workshop {
    --workshop-title: #2d3748;
    --workshop-body: #4a5568;
    position: relative;
    overflow: visible;
    background: #fefefe;
    border-radius: var(--radius-card);
    padding: calc(var(--card-padding-y) + var(--workshop-icon-overlap))
      var(--card-padding-x) var(--card-padding-y);
    box-shadow: none;
    border: var(--card-border);
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshop:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 55px -18px
      color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .workshop:hover .workshop__icon {
    transform: translate(-50%, -50%) scale(1.05);
  }

  .workshop__age,
  /* .workshop__summary, */
  .workshop__details,
  .workshop__highlights-label,
  .workshop__terms-label,
  .workshop__dates,
  .workshop__price,
  .workshops-page__divider,
  .workshops-page__cta,
  .workshop__more,
  .workshops-page__rule {
    position: relative;
    z-index: 1;
  }

  .workshop__header {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin: 0;
  }

  /* Nadpis pod překryvnou ikonou */
  .workshop__lead {
    width: 100%;
    margin: 0 0 var(--space-3);
    box-sizing: border-box;
  }

  /* Ikona napůl nad kartou, napůl uvnitř */
  .workshop__icon {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--workshop-icon-size);
    height: var(--workshop-icon-size);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    transform: translate(-50%, -50%);
    transition: transform 280ms ease;
  }

  .workshop__icon-graphic {
    width: var(--workshop-icon-graphic-size);
    height: var(--workshop-icon-graphic-size);
  }

  .workshop__lead h3 {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--line-height-xl);
    text-align: center;
    color: var(--color-ink);
  }

  .workshops-page__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-7) 0 var(--space-7);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
    transition: background 220ms ease;
  }

  .workshop__age {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--line-height-lg);
    color: var(--accent);
  }

  /* .workshop__summary {
    margin: 0 0 var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-ink);
  } */

  .workshop__details {
    padding-inline: 0;
    border-radius: var(--radius-xl);
  }

  .workshop__highlights-label,
  .workshop__terms-label {
    margin: 0 0 var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--line-height-base);
    color: var(--accent);
  }

  .workshop__price-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--line-height-base);
    color: var(--accent);
  }

  .workshop__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .workshop__highlights > li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-page__divider {
    border: none;
    height: 1px;
    margin: var(--space-7) 0 var(--space-7);
    background: rgba(42, 31, 56, 0.12);
  }

  .workshop__price {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
  }

  .workshop__price-value {
    margin: 0;
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--line-height-lg);
    text-align: right;
    color: var(--color-ink);
  }

  .workshop__highlight-icon {
    flex-shrink: 0;
    width: var(--text-xl);
    height: var(--text-xl);
    color: var(--accent);
  }

  .workshop__dates {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .workshop__date-card {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: 0;
    border-radius: var(--radius-card);
    border: var(--card-border);
    background: #fefefe;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .workshop__date-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -14px
      color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .workshop__date-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .workshop__date-card-date {
    flex: 0 0 4.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    padding: var(--space-4) var(--space-3);
    background: var(--accent-soft);
    color: var(--accent);
    text-align: center;
  }

  .workshop__date-month {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: var(--line-height-base);
  }

  .workshop__date-day {
    font-family: var(--font-body);
    font-size: var(--text-2-5xl);
    font-weight: 700;
    line-height: 1;
  }

  .workshop__date-card-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.125rem;
    padding: var(--space-4) var(--space-5);
  }

  .workshop__date-time,
  .workshop__date-venue {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshop__date-spots {
    margin: var(--space-1) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  .workshops-page__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  .workshops-page__cta {
    display: flex;
    justify-content: center;
  }

  .workshops-page__cta :global(.btn) {
    width: 100%;
    padding: 1.125rem 1.375rem;
    border-radius: var(--radius-full);
    box-shadow: none;
  }

  .workshop .workshops-page__cta :global(.btn-primary) {
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .workshop .workshops-page__cta :global(.btn-primary::before) {
    background: var(--accent);
  }

  .workshop .workshops-page__cta :global(.btn-primary:hover),
  .workshop .workshops-page__cta :global(.btn-primary:active) {
    box-shadow: 0 22px 50px -16px
      color-mix(in srgb, var(--accent) 60%, transparent);
  }

  @media (min-width: 768px) {
    .workshops__grid {
      --workshop-card-width: var(--card-grid-width-md);
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--workshop-card-width));
      justify-content: center;
    }
  }

  @media (min-width: 1180px) {
    .workshops__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
