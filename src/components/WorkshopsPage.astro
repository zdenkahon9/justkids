  /* ---------- Media queries ---------- */

  @media (min-width: 640px) {
    .workshops-page__head {
      display: contents;
    }

    .workshops-page__head h1,
    .workshops-page .section-subtitle {
      grid-column: auto;
    }

    .workshops-page .section-subtitle {
      width: auto;
      min-width: 0;
      max-width: 28rem;
      margin-inline: auto;
      text-wrap: wrap;
