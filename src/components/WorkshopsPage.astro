---
import Icon from "astro-iconify";
import { workshops, workshopsHomeMeta } from "../data/WorkshopsHome";
import { workshopsPageMeta } from "../data/WorkshopsPage";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = workshopsHomeMeta;
const pageMeta = workshopsPageMeta;

/** Iconify názvy (sada:id) — mapování podle id z WorkshopsHome.ts */
const workshopIconById: Record<string, string> = {
  "prvni-pomoc-u-deti": "streamline:medical-bag",
  "handling-a-psychomotoricky-vyvoj": "streamline:health-care-2",
  "psychomotoricky-vyvoj-prevence": "streamline:brain",
};
---

<section
  id={pageMeta.sectionId}
  class="section workshops-page"
  aria-labelledby="workshops-title"
>
  <div class="workshops-page__intro">
    <div class="workshops-page__intro-nav-bg" aria-hidden="true">
      <div class="workshops-page__intro-photo"></div>
      <div class="workshops-page__intro-veil"></div>
    </div>
    <div class="container-x workshops-page__intro-inner">
      <header class="section-header reveal">
        <span class="eyebrow">{meta.eyebrow}</span>
        <h2 id="workshops-title">
          {meta.title}{" "}
          <span class="section-title-accent">{meta.titleAccent}</span>
        </h2>
        <p class="section-subtitle">{meta.subtitle}</p>
      </header>
    </div>
  </div>

  <div class="container-x">
    <ul class="workshops__grid">
      {
        workshops.map((w, i) => (
          <li
            class="workshop reveal"
            style={`--accent: ${cardAccentDeep(w.accent)}; --accent-soft: ${cardAccentSoft(w.accent)}; transition-delay: ${i * 80}ms`}
          >
            <svg
              class="workshop__blob"
              viewBox="-32 0 132 100"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M100 0 H-32 L0 0 A100 100 0 0 1 100 90 Z" />
            </svg>

            <div class="workshop__header">
              <div class="workshop__lead">
                <span class="workshop__icon" aria-hidden="true">
                  <Icon
                    name={workshopIconById[w.id] ?? "streamline:health-care-2"}
                    class="card-icon-graphic"
                  />
                </span>
                <h3>{w.title}</h3>
              </div>
              <span class="workshop__rule" aria-hidden="true" />
            </div>

            <span class="workshop__age" aria-hidden={!w.ageRange}>
              {w.ageRange}
            </span>

            <p class="workshop__summary">{w.summary}</p>

            <div class="workshop__details">
              <ul class="workshop__highlights">
                {w.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="workshops-page__footer reveal">
      <a class="btn btn-ghost workshops-page__back-btn" href="/">
        <span aria-hidden="true">←</span> Zpět na hlavní stránku
      </a>
    </div>
  </div>
</section>

<style>
  .workshops-page {
    padding-top: 0;
    scroll-margin-top: var(--nav-height);
    background-color: var(--color-cream);
  }

  /* Mini page-hero — pod navbarom stejná vrstva jako na AgeGroupsPage */
  .workshops-page__intro {
    position: relative;
    background-color: var(--color-cream);
  }

  .workshops-page__intro-nav-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .workshops-page__intro-photo {
    position: absolute;
    left: -3%;
    right: -3%;
    top: -3svh;
    height: 106svh;
    background-image: url("/images/hero-balloons.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    transform-origin: center top;
  }

  .workshops-page__intro-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100svh;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.55) 72%,
        rgba(255, 249, 244, 0.95) 100%
      );
  }

  .workshops-page__intro-inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-height) + var(--section-header-spacing));
  }

  .workshops-page__intro .section-header {
    margin-bottom: var(--section-header-spacing);
  }

  .workshops-page .section-title-accent {
    color: var(--color-blush-vivid);
  }

  /* Mobile-first: jednotný subgrid uvnitř karty; mění se jen počet sloupců */
  .workshops__grid {
    --workshop-card-width: var(--card-grid-width);
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--workshop-card-width));
    grid-auto-rows: auto auto auto auto;
    gap: var(--stack-gap);
    justify-content: center;
  }

  .workshop {
    --workshop-title: #2d3748;
    --workshop-body: #4a5568;
    position: relative;
    overflow: hidden;
    background: #fefefe;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    box-shadow: none;
    border: var(--card-border);
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshop:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 55px -18px
      color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .workshop:hover .workshop__icon {
    transform: scale(1.05);
  }

  /* Blob vpravo nahoře — roh zaobluje overflow + border-radius karty */
  .workshop__blob {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    width: 9.9rem;
    height: 7.5rem;
    display: block;
    pointer-events: none;
  }

  .workshop__blob path {
    fill: var(--accent-soft);
  }

  .workshop__age,
  .workshop__summary,
  .workshop__details,
  .workshop__more {
    position: relative;
    z-index: 1;
  }

  .workshop__header {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
    margin: 0 0 0.5rem 0;
    grid-row: 1;
    align-self: start;
  }

  /* Stejná výška leadu; ikona + h3 vertikálně uprostřed na všech kartách */
  .workshop__lead {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    width: 100%;
    height: 5.875rem;
    min-height: 5.875rem;
    box-sizing: border-box;
  }

  /* Krátký pruh pod ikonou i nadpisem — barva karty přes --accent */
  .workshop__rule {
    display: block;
    width: 2.75rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }

  /* Stejný kruh jako age-home / age-page ikona — barva přes --accent */
  .workshop__icon {
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    width: var(--card-icon-size);
    height: var(--card-icon-size);
    border-radius: var(--radius-full);
    background: #fff;
    border: none;
    color: var(--accent);
    display: grid;
    place-items: center;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 0 0 6px color-mix(in srgb, var(--accent) 12%, white),
      0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .workshop__lead h3 {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .workshop__age {
    display: block;
    width: 100%;
    margin: -0.75rem 0 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: var(--line-height-2xl);
    text-align: center;
    color: var(--accent);
    grid-row: 2;
    align-self: start;
  }

  .workshop__age:empty {
    visibility: hidden;
  }

  .workshop__summary {
    margin: 0 0 0.75rem 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-ink);
    grid-row: 3;
    align-self: start;
  }

  .workshop__details {
    padding: var(--space-4);
    border-radius: var(--radius-xl);
    background: var(--accent-soft);
    grid-row: 4;
    align-self: start;
  }

  .workshop__highlights {
    list-style-type: disc;
    list-style-position: outside;
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .workshop__highlights > li {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-ink);
  }

  .workshops-page__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  /* Mobilní section-header — stejný breakpoint jako global.css (639px) */
  @media (max-width: 639px) {
    .workshops-page .section-header {
      text-align: center;
    }
  }

  @media (min-width: 768px) {
    .workshops__grid {
      --workshop-card-width: var(--card-grid-width-md);
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--workshop-card-width));
      justify-content: center;
    }
  }

  @media (min-width: 1180px) {
    .workshops__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
