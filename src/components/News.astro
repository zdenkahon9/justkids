---
import { news } from "../data/news";

const formatter = new Intl.DateTimeFormat("cs-CZ", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const sorted = [...news].sort((a, b) => (a.date < b.date ? 1 : -1));
---

<section id="novinky" class="section news" aria-labelledby="news-title">
  <div class="container-x">
    <header class="news__header reveal">
      <span class="eyebrow">Co je nového</span>
      <h2 id="news-title">
        <span class="section-title-accent">Novinky</span> a aktuality
      </h2>
      <p>Otevřené kurzy, prázdninové programy nebo změny rozvrhu - tady najdete všechno aktuální.</p>
    </header>

    {sorted.length === 0 ? (
      <p class="news__empty">Zatím tu nic nového není - sledujte nás na sítích.</p>
    ) : (
      <ul class="news__grid">
        {sorted.map((n, i) => (
          <li
            class="news-card reveal"
            style={`transition-delay: ${i * 80}ms`}
          >
            <time datetime={n.date} class="news-card__date">
              {formatter.format(new Date(n.date))}
            </time>
            <h3 class="news-card__title">{n.title}</h3>
            <p class="news-card__text">{n.text}</p>
            {n.link && (
              <a
                href={n.link.href}
                class="news-card__link"
                {...(n.link.href.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {n.link.label}
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path d="M 3 8 L 13 8 M 9 4 L 13 8 L 9 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            )}
            <div class="news-card__decor" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .news__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }

  .news__header h2 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .news__header h2 .section-title-accent {
    color: var(--color-lilac-deep);
  }

  .news__header p { color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%); margin: 0; }

  .news__empty {
    text-align: center;
    color: var(--color-ink-muted);
    padding: 3rem;
    background: var(--color-cream-100);
    border-radius: var(--radius-card);
  }

  .news__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .news-card {
    position: relative;
    background: white;
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    border: 1.5px solid var(--color-lilac-soft);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 280ms ease, border-color 280ms ease, box-shadow 280ms ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-blush-mid);
    box-shadow: var(--shadow-soft);
  }

  .news-card__date {
    display: inline-block;
    font-family: var(--font-script);
    font-size: 1.15rem;
    color: var(--color-blush-vivid);
    line-height: 1;
    margin-bottom: 0.85rem;
  }

  .news-card__title {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .news-card__text {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .news-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-blush-vivid);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
    align-self: flex-start;
    border-bottom: 1.5px solid transparent;
    padding-bottom: 2px;
    transition: gap 220ms ease, border-color 220ms ease;
  }

  .news-card__link:hover {
    gap: 0.7rem;
    border-bottom-color: var(--color-blush-vivid);
  }

  .news-card__decor {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .news-card__decor span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-lilac-mid);
  }

  .news-card__decor span:nth-child(2) { background: var(--color-blush-mid); }
  .news-card__decor span:nth-child(3) { background: var(--color-sky-mid); }
</style>
