---
import { workshops } from "../data/workshops";
import { site } from "../data/site";

const accentMap: Record<string, string> = {
  blush: "var(--color-blush-mid)",
  sky: "var(--color-sky-mid)",
  lilac: "var(--color-lilac-mid)",
};
---

<section id="workshopy" class="section workshops" aria-labelledby="workshops-title">
  <div class="container-x">
    <header class="workshops__header reveal">
      <span class="eyebrow">Speciální akce</span>
      <h2 id="workshops-title">
        Workshopy <span class="section-title-accent">pro rodiče</span>
      </h2>
      <p>
        Krátké akce mimo pravidelné lekce. Naučíte se konkrétní dovednost a odnesete si ji domů.
      </p>
    </header>

    <ul class="workshops__grid">
      {workshops.map((w, i) => (
        <li
          class="workshop reveal"
          style={`--accent: ${accentMap[w.accent]}; transition-delay: ${i * 80}ms;`}
        >
          <div class="workshop__top">
            <span class="workshop__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22">
                <path
                  d="M 12 2 L 14.5 8.5 L 21 9 L 16 13.5 L 17.5 20 L 12 16.5 L 6.5 20 L 8 13.5 L 3 9 L 9.5 8.5 Z"
                  fill="currentColor"
                />
              </svg>
            </span>
            <span class="workshop__duration">{w.duration}</span>
          </div>

          <h3>{w.title}</h3>
          <p class="workshop__summary">{w.summary}</p>

          <dl class="workshop__meta">
            <div>
              <dt>Pro koho</dt>
              <dd>{w.forWhom}</dd>
            </div>
            {w.upcoming && (
              <div>
                <dt>Termín</dt>
                <dd>{w.upcoming}</dd>
              </div>
            )}
          </dl>

          <a
            href={site.reservationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="workshop__cta"
          >
            Mám zájem
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .workshops__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }

  .workshops__header h2 {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .workshops__header h2 .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .workshops__header p { color: var(--color-ink-soft); margin: 0; }

  .workshops__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .workshop {
    position: relative;
    background: white;
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    border: 2px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 280ms ease;
  }

  .workshop:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px -16px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .workshop__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .workshop__icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 35%, white);
    color: color-mix(in srgb, var(--accent) 70%, var(--color-ink));
    display: grid;
    place-items: center;
  }

  .workshop__duration {
    font-family: var(--font-script);
    font-size: 1.25rem;
    color: var(--color-blush-vivid);
    line-height: 1;
  }

  .workshop h3 {
    font-size: 1.4rem;
    margin: 0;
  }

  .workshop__summary {
    color: var(--color-ink-soft);
    margin: 0;
    font-size: 0.95rem;
  }

  .workshop__meta {
    display: grid;
    gap: 0.65rem;
    margin: 0.25rem 0 0;
  }

  .workshop__meta div { margin: 0; }

  .workshop__meta dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .workshop__meta dd {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .workshop__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 30%, white);
    color: color-mix(in srgb, var(--accent) 70%, var(--color-ink));
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    align-self: flex-start;
    transition: background-color 220ms ease, transform 220ms ease;
  }

  .workshop__cta:hover {
    background: color-mix(in srgb, var(--accent) 50%, white);
    transform: translateX(2px);
  }
</style>
