---
/**
 * Gallery: pouze ilustrace + abstraktní motivy.
 * Žádné reálné fotografie dětí (GDPR).
 */
---

<section
  id="galerie"
  class="section gallery atmosphere"
  aria-labelledby="gallery-title"
>
  <div class="container-x">
    <header class="gallery__header reveal">
      <span class="eyebrow">Atmosféra</span>
      <h2 id="gallery-title">
        Tak to u nás <span class="section-title-accent">vypadá</span>
      </h2>
      <p class="gallery__subtitle">
        Hravé, klidné a barevné. Pro ochranu soukromí dětí používáme jen
        ilustrace - skutečnou atmosféru zažijete naživo.
      </p>
    </header>

    <div class="gallery__grid">
      {/* Tile 1: Balloon */}
      <div class="tile tile--1 reveal">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="bal1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#fff"></stop>
              <stop offset="100%" stop-color="#fcc2d6"></stop>
            </linearGradient>
          </defs>
          <rect width="200" height="200" fill="#ffe1ed"></rect>
          <ellipse cx="100" cy="90" rx="55" ry="65" fill="url(#bal1)"></ellipse>
          <path
            d="M 100 155 Q 95 165 100 200"
            stroke="#ec2f8e"
            stroke-width="2"
            fill="none"></path>
          <circle cx="80" cy="75" r="12" fill="white" opacity="0.6"></circle>
        </svg>
        <span class="tile__caption">Hra a radost</span>
      </div>

      {/* Tile 2: Stars/sparkles */}
      <div class="tile tile--2 reveal">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="200" height="200" fill="#d6ecfa"></rect>
          <path
            d="M 100 50 L 110 90 L 150 100 L 110 110 L 100 150 L 90 110 L 50 100 L 90 90 Z"
            fill="#5ba9dd"
            opacity="0.5"></path>
          <path
            d="M 50 40 L 55 55 L 70 60 L 55 65 L 50 80 L 45 65 L 30 60 L 45 55 Z"
            fill="white"></path>
          <path
            d="M 160 150 L 165 165 L 180 170 L 165 175 L 160 190 L 155 175 L 140 170 L 155 165 Z"
            fill="white"></path>
        </svg>
        <span class="tile__caption">Klid a soustředění</span>
      </div>

      {/* Tile 3: Footprints */}
      <div class="tile tile--3 reveal">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="200" height="200" fill="#ece1f7"></rect>
          <ellipse cx="70" cy="80" rx="20" ry="28" fill="#b58be0"></ellipse>
          <circle cx="60" cy="55" r="5" fill="#b58be0"></circle>
          <circle cx="68" cy="48" r="4" fill="#b58be0"></circle>
          <circle cx="78" cy="48" r="4" fill="#b58be0"></circle>
          <circle cx="86" cy="55" r="5" fill="#b58be0"></circle>
          <ellipse cx="130" cy="140" rx="20" ry="28" fill="#d4bff5"></ellipse>
          <circle cx="120" cy="115" r="5" fill="#d4bff5"></circle>
          <circle cx="128" cy="108" r="4" fill="#d4bff5"></circle>
          <circle cx="138" cy="108" r="4" fill="#d4bff5"></circle>
          <circle cx="146" cy="115" r="5" fill="#d4bff5"></circle>
        </svg>
        <span class="tile__caption">První kroky</span>
      </div>

      {/* Tile 4: Cloud + sun */}
      <div class="tile tile--4 reveal">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="200" height="200" fill="#fff9f4"></rect>
          <circle cx="140" cy="60" r="30" fill="#fcc2d6"></circle>
          <circle cx="140" cy="60" r="22" fill="#ff9bbf"></circle>
          <ellipse cx="80" cy="120" rx="50" ry="22" fill="#a9d4f0" opacity="0.6"
          ></ellipse>
          <ellipse cx="105" cy="115" rx="40" ry="20" fill="white"></ellipse>
          <ellipse cx="80" cy="125" rx="35" ry="18" fill="white"></ellipse>
          <path
            d="M 30 170 Q 50 165 70 170 Q 90 175 110 170 Q 130 165 150 170 Q 170 175 190 170"
            stroke="#5ba9dd"
            stroke-width="2"
            fill="none"
            opacity="0.6"></path>
        </svg>
        <span class="tile__caption">Slunečné dopoledne</span>
      </div>

      {/* Tile 5: Heart with shapes */}
      <div class="tile tile--5 reveal">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="200" height="200" fill="#fcc2d6"></rect>
          <path
            d="M 100 160 L 60 120 Q 30 90 60 70 Q 85 55 100 90 Q 115 55 140 70 Q 170 90 140 120 Z"
            fill="white"></path>
          <circle cx="50" cy="40" r="8" fill="#ec2f8e"></circle>
          <rect
            x="155"
            y="35"
            width="14"
            height="14"
            rx="3"
            fill="#5ba9dd"
            transform="rotate(15 162 42)"></rect>
          <path d="M 170 165 L 180 180 L 165 180 Z" fill="#b58be0"></path>
        </svg>
        <span class="tile__caption">S láskou</span>
      </div>

      {/* Tile 6: Music/sounds */}
      <div class="tile tile--6 reveal">
        <svg
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="200" height="200" fill="#a9d4f0"></rect>
          <circle cx="60" cy="130" r="14" fill="white"></circle>
          <rect x="70" y="60" width="3" height="80" fill="white"></rect>
          <circle cx="130" cy="140" r="12" fill="white"></circle>
          <rect x="138" y="80" width="3" height="65" fill="white"></rect>
          <path
            d="M 70 60 Q 100 55 138 80"
            stroke="white"
            stroke-width="3"
            fill="none"></path>
          <circle cx="170" cy="50" r="6" fill="#fcc2d6"></circle>
          <circle cx="40" cy="60" r="5" fill="#fcc2d6"></circle>
        </svg>
        <span class="tile__caption">Písničky a říkanky</span>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery__header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 3rem;
  }

  .gallery__header h2 {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .gallery__header h2 .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .gallery__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  @media (min-width: 1024px) {
    .gallery__subtitle {
      font-size: 1.0625rem;
    }
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 160px;
    gap: 1rem;
  }

  .tile {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    transition:
      transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 320ms ease;
    grid-column: span 1 !important;
    grid-row: span 1 !important;
  }

  .tile:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 28px 60px -20px rgba(123, 90, 160, 0.4);
    z-index: 2;
  }

  .tile svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .tile__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.25rem 1rem 0.85rem;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(42, 31, 56, 0.6) 100%
    );
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    text-align: center;
  }

  .tile--1,
  .tile--4,
  .tile--6 {
    grid-column: span 2 !important;
  }

  @media (min-width: 1024px) {
    .gallery__grid {
      grid-template-columns: repeat(12, 1fr);
    }

    .tile {
      grid-column: unset !important;
      grid-row: unset !important;
    }

    .tile--1 {
      grid-column: span 4;
      grid-row: span 2;
    }
    .tile--2 {
      grid-column: span 5;
      grid-row: span 1;
    }
    .tile--3 {
      grid-column: span 3;
      grid-row: span 1;
    }
    .tile--4 {
      grid-column: span 4;
      grid-row: span 2;
    }
    .tile--5 {
      grid-column: span 4;
      grid-row: span 1;
    }
    .tile--6 {
      grid-column: span 4;
      grid-row: span 2;
    }
  }
</style>
