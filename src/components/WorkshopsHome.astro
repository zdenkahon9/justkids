---
import { workshopsHomeMeta } from "../data/WorkshopsHome";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = workshopsHomeMeta;
---

<section
  id={meta.sectionId}
  class="section workshops-home"
  aria-labelledby="workshops-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">{meta.eyebrow}</span>
      <h2 id="workshops-title">
        {meta.title}{" "}
        <span class="section-title-accent">{meta.titleAccent}</span>
      </h2>
      <p class="section-subtitle">{meta.subtitle}</p>
    </header>

    <ul class="workshops-home__grid">
      <li>
        <div
          class="workshops-home__card reveal"
          style={`--accent: ${cardAccentDeep("blush-deep")}; --accent-soft: ${cardAccentSoft("blush-deep")};`}
        >
          <svg
            class="workshops-home__blob"
            viewBox="-32 0 132 100"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M100 0 H-32 L0 0 A100 100 0 0 1 100 90 Z"></path>
          </svg>
          <div class="workshops-home__body">
            <h3 class="workshops-home__heading">Témata workshopů:</h3>
            <div
              class="workshops-home__content workshops-home__content--invisible"
              aria-hidden="true"
            >
              <div class="workshops-home__age-row">
                <span class="workshops-home__age">0–6 měsíců</span>
                <div class="workshops-home__illustration">
                  <span class="workshops-home__icon-ring"></span>
                </div>
              </div>
              <p class="workshops-home__groups">
                Specifika dětské první pomoci • Resuscitace • Dušení
              </p>
              <span class="workshops-home__rule"></span>
              <p class="workshops-home__summary">
                Jak reagovat v krizových situacích a poskytnout dítěti první
                pomoc.
              </p>
            </div>
          </div>
        </div>
      </li>
    </ul>

    <div class="workshops-home__cta reveal">
      <a class="btn btn-primary" href={meta.detailHref}>
        {meta.ctaLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .workshops-home {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .workshops-home .section-title-accent {
    color: var(--color-blush-vivid);
  }

  /* Mobile-first: stejné tokeny šířky karty jako .age-home__grid */
  .workshops-home__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .workshops-home__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshops-home__blob {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    width: 9.9rem;
    height: 7.5rem;
    display: block;
    pointer-events: none;
  }

  .workshops-home__blob path {
    fill: var(--accent-soft);
  }

  .workshops-home__body {
    z-index: 1;
  }

  .workshops-home__content--invisible {
    visibility: hidden;
  }

  .workshops-home__age-row {
    --age-text-height: calc(1.375rem * var(--line-height-2xl));
    position: relative;
    padding-right: calc(var(--card-icon-size-corner) + var(--space-4));
  }

  .workshops-home__illustration {
    position: absolute;
    right: 0;
    top: calc(0.5 * var(--age-text-height));
    transform: translateY(-50%);
  }

  .workshops-home__icon-ring {
    display: block;
    width: var(--card-icon-size-corner);
    height: var(--card-icon-size-corner);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
  }

  .workshops-home__heading {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .workshops-home__age {
    display: block;
    width: 100%;
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--accent);
  }

  .workshops-home__groups {
    margin: 0 0 var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink-muted);
  }

  .workshops-home__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: 0 0 var(--space-5);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
  }

  .workshops-home__summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-home__cta {
    margin-top: var(--stack-gap);
    display: flex;
    justify-content: center;
  }

  .workshops-home__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    padding: 1.125rem 1.375rem;
    border-radius: var(--radius-full);
    box-shadow: none;
  }

  .workshops-home__cta :global(.btn-primary:hover),
  .workshops-home__cta :global(.btn-primary:active) {
    box-shadow: var(--shadow-pop);
  }

  @media (min-width: 768px) {
    .workshops-home__grid {
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--card-grid-width-md));
      justify-content: center;
    }

    .workshops-home__cta :global(.btn) {
      width: auto;
      max-width: none;
    }
  }

  @media (min-width: 1180px) {
    .workshops-home__grid {
      max-width: calc(2 * var(--card-grid-width-md) + var(--stack-gap));
      margin-inline: auto;
    }
  }
</style>
