---
import Icon from "astro-iconify";
import { workshops, workshopsHomeMeta } from "../data/WorkshopsHome";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = workshopsHomeMeta;
---

<section
  id={meta.sectionId}
  class="section workshops-home"
  aria-labelledby="workshops-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">{meta.eyebrow}</span>
      <h2 id="workshops-title">
        {meta.title}{" "}
        <span class="section-title-accent">{meta.titleAccent}</span>
      </h2>
      <p class="section-subtitle">{meta.subtitle}</p>
    </header>

    <ul class="workshops-home__grid">
      <li>
        <div
          class="workshops-home__card reveal"
          style={`--accent: ${cardAccentDeep(workshops[0].accent)};`}
        >
          <p class="workshops-home__note">
            <span class="workshops-home__note-inner">
              <Icon
                name="twemoji:pink-heart"
                class="workshops-home__note-icon"
              />
              <span class="workshops-home__note-text">
                {meta.cardNoteLead}{" "}
                <span class="workshops-home__note-highlight">
                  {meta.cardNoteHighlight}
                </span>{" "}
                {meta.cardNoteTail}
              </span>
            </span>
          </p>
          <div class="workshops-home__body">
            <ul class="workshops-home__topics">
              {
                workshops.map((w, index) => (
                  <li
                    class="workshops-home__topic"
                    style={`--accent: ${cardAccentDeep(w.accent)}; --accent-soft: ${cardAccentSoft(w.accent)};`}
                  >
                    {index > 0 ? (
                      <span class="workshops-home__rule" aria-hidden="true" />
                    ) : null}
                    <div class="workshops-home__topic-row">
                      <div class="workshops-home__topic-copy">
                        <h3 class="workshops-home__topic-label">{w.title}</h3>
                        <span
                          class="workshops-home__topic-rule"
                          aria-hidden="true"
                        />
                        {w.homeSummary ? (
                          <p class="workshops-home__topic-summary">
                            {w.homeSummary}
                          </p>
                        ) : null}
                      </div>
                      <a
                        class="workshops-home__arrow"
                        href={`${meta.detailHref}#${w.id}`}
                        data-workshops-home-arrow={w.id}
                        aria-label={`Přejít na workshop ${w.title}`}
                      >
                        <Icon
                          name="iconamoon:arrow-right-2-light"
                          class="workshops-home__arrow-graphic"
                        />
                      </a>
                    </div>
                  </li>
                ))
              }
            </ul>
            <p class="workshops-home__info">
              <span class="workshops-home__info-inner">
                <Icon
                  name="fluent:info-24-regular"
                  class="workshops-home__info-icon"
                  aria-hidden="true"
                />
                <span class="workshops-home__info-text"
                  >{meta.cardInfoText}</span
                >
              </span>
            </p>
          </div>
        </div>
      </li>
    </ul>

    <div class="workshops-home__cta reveal">
      <a class="btn btn-primary" href={meta.detailHref}>
        {meta.ctaLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .workshops-home {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .workshops-home .section-title-accent {
    color: var(--color-sky-deep);
  }

  /* Mobile-first: stejné tokeny šířky karty jako .age-home__grid */
  .workshops-home__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .workshops-home__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: 0;
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshops-home__note {
    margin: 0;
    padding: var(--space-8) var(--card-padding-x) var(--space-8);
    border-radius: 0;
    background: var(--color-apricot-soft);
    text-align: center;
  }

  .workshops-home__note-inner {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    max-width: 100%;
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
    text-align: center;
  }

  .workshops-home__note-text {
    max-width: 22ch;
  }

  .workshops-home__note-highlight {
    color: var(--color-blush-deep);
    font-weight: 600;
  }

  .workshops-home__note-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .workshops-home__body {
    min-width: 0;
    padding: var(--card-padding);
  }

  .workshops-home__topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .workshops-home__topic {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .workshops-home__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-5) 0;
    border: none;
    background: rgba(42, 31, 56, 0.12);
  }

  .workshops-home__topic-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .workshops-home__topic:last-child .workshops-home__topic-row {
    margin-bottom: var(--space-8);
  }

  .workshops-home__topic-copy {
    flex: 1;
    min-width: 0;
  }

  .workshops-home__topic-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--color-ink);
  }

  .workshops-home__topic-rule {
    display: block;
    width: 2.75rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--accent);
    margin: 0 0 var(--space-4);
  }

  .workshops-home__topic-summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-home__arrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    text-decoration: none;
    transition: transform 200ms ease;
  }

  .workshops-home__arrow:hover,
  .workshops-home__arrow:focus-visible {
    transform: scale(1.05);
  }

  .workshops-home__arrow-graphic {
    width: 1.5rem;
    height: 1.5rem;
  }

  .workshops-home__info {
    margin: var(--space-6) 0 0;
    padding: 0;
  }

  .workshops-home__info-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-blush-soft);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-home__info-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    color: var(--color-blush-deep);
  }

  .workshops-home__info-text {
    flex: 1;
    min-width: 0;
  }

  .workshops-home__cta {
    margin-top: var(--stack-gap);
    display: flex;
    justify-content: center;
  }

  .workshops-home__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .workshops-home__cta :global(.btn-primary:hover) {
      box-shadow: var(--shadow-pop);
    }
  }

  .workshops-home__cta :global(.btn-primary:active) {
    box-shadow: var(--shadow-pop);
    transform: translate3d(0, 0, 0) scale(0.98);
  }

  @media (min-width: 768px) {
    .workshops-home__cta :global(.btn) {
      width: auto;
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .workshops-home__topic-summary {
      font-size: var(--text-lg);
    }

    .workshops-home__info-text {
      font-size: var(--text-base);
    }
  }
</style>

<script>
  const WORKSHOPS_HOME_SCROLL_KEY = "workshops-home-scroll";

  const setupWorkshopsHomeArrows = () => {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-workshops-home-arrow]")
      .forEach((link) => {
        if (link.dataset.homeArrowReady === "true") return;
        link.dataset.homeArrowReady = "true";

        link.addEventListener("click", (event) => {
          const id = link.getAttribute("data-workshops-home-arrow");
          if (!id) return;

          event.preventDefault();
          sessionStorage.setItem(WORKSHOPS_HOME_SCROLL_KEY, id);
          window.location.assign(link.pathname);
        });
      });
  };

  setupWorkshopsHomeArrows();
  document.addEventListener("astro:page-load", setupWorkshopsHomeArrows);
</script>
