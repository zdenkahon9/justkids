---
import { workshops, workshopsHomeMeta } from "../data/WorkshopsHome";
import { cardAccentDeep } from "../utils/cardAccent";

const meta = workshopsHomeMeta;
---

<section
  id={meta.sectionId}
  class="section workshops-home"
  aria-labelledby="workshops-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">{meta.eyebrow}</span>
      <h2 id="workshops-title">
        {meta.title}{" "}
        <span class="section-title-accent">{meta.titleAccent}</span>
      </h2>
      <p class="section-subtitle">
        {meta.subtitle}
        <br />
        {meta.subtitleLine2}
      </p>
    </header>

    <ul class="workshops-home__grid">
      <li>
        <div
          class="workshops-home__card reveal"
          style={`--accent: ${cardAccentDeep(workshops[0].accent)};`}
        >
          <div class="workshops-home__body">
            <ul class="workshops-home__topics">
              {
                workshops.map((w, index) => (
                  <li class="workshops-home__topic">
                    {index > 0 ? (
                      <span class="workshops-home__rule" aria-hidden="true" />
                    ) : null}
                    <div class="workshops-home__topic-copy">
                      <span class="workshops-home__topic-label">{w.title}</span>
                      {w.homeSummary ? (
                        <p class="workshops-home__topic-summary">
                          {w.homeSummary}
                        </p>
                      ) : null}
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </li>
    </ul>

    <div class="workshops-home__cta reveal">
      <a class="btn btn-primary" href={meta.detailHref}>
        {meta.ctaLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .workshops-home {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .workshops-home .section-title-accent {
    color: var(--color-sky-deep);
  }

  /* Mobile-first: stejné tokeny šířky karty jako .age-home__grid */
  .workshops-home__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .workshops-home__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    --workshops-home-rule-bg: color-mix(
      in srgb,
      var(--accent) 30%,
      var(--color-ink) 8%
    );
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshops-home__topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .workshops-home__topic {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .workshops-home__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-5) 0;
    border: none;
    background: var(--workshops-home-rule-bg);
    transition: background 220ms ease;
  }

  .workshops-home__topic-copy {
    min-width: 0;
  }

  .workshops-home__topic-label {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--color-ink);
  }

  .workshops-home__topic-summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-home__cta {
    margin-top: var(--stack-gap);
    display: flex;
    justify-content: center;
  }

  .workshops-home__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    padding: 1.125rem 1.375rem;
    border-radius: var(--radius-full);
    box-shadow: none;
  }

  .workshops-home__cta :global(.btn-primary:hover),
  .workshops-home__cta :global(.btn-primary:active) {
    box-shadow: var(--shadow-pop);
  }

  @media (min-width: 768px) {
    .workshops-home__grid {
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--card-grid-width-md));
      justify-content: center;
    }

    .workshops-home__cta :global(.btn) {
      width: auto;
      max-width: none;
    }
  }

  @media (min-width: 1180px) {
    .workshops-home__grid {
      max-width: calc(2 * var(--card-grid-width-md) + var(--stack-gap));
      margin-inline: auto;
    }
  }
</style>
