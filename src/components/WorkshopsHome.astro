---
import Icon from "astro-iconify";

import { workshopIconById, workshops, workshopsHomeMeta } from "../data/WorkshopsHome";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = workshopsHomeMeta;
---

<section
  id={meta.sectionId}
  class="section workshops-home"
  aria-labelledby="workshops-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">{meta.eyebrow}</span>
      <h2 id="workshops-title">
        {meta.title}{" "}
        <span class="section-title-accent">{meta.titleAccent}</span>
      </h2>
      <p class="section-subtitle">{meta.subtitle}</p>
    </header>

    <ul class="workshops-home__grid">
      <li>
        <div
          class="workshops-home__card reveal"
          style={`--accent: ${cardAccentDeep(workshops[0].accent)};`}
        >
          <div class="workshops-home__aside">
            <p class="workshops-home__note">
              <span class="workshops-home__note-inner">
                <span class="workshops-home__note-icon-ring" aria-hidden="true">
                  <Icon name="twemoji:pink-heart" class="workshops-home__note-icon" />
                </span>
                <span class="workshops-home__note-text">
                  {meta.cardNoteLead}{" "}
                  <span class="workshops-home__note-highlight">
                    {meta.cardNoteHighlight}
                  </span>{" "}
                  {meta.cardNoteTail}
                </span>
              </span>
            </p>
            <p class="workshops-home__note-description">
              {meta.cardNoteDescription}
            </p>
            <a class="workshops-home__card-cta btn btn-primary" href={meta.detailHref}>
              {meta.ctaLabel}
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="workshops-home__body">
            <ul class="workshops-home__topics">
              {
                workshops.map((w, index) => (
                  <li
                    class="workshops-home__topic"
                    style={`--accent: ${cardAccentDeep(w.accent)}; --accent-soft: ${cardAccentSoft(w.accent)};`}
                  >
                    {index > 0 ? (
                      <span class="workshops-home__rule" aria-hidden="true" />
                    ) : null}
                    <div class="workshops-home__topic-row">
                      <span class="workshops-home__topic-icon" aria-hidden="true">
                        <Icon
                          name={workshopIconById[w.id] ?? "streamline:health-care-2"}
                          class="workshops-home__topic-icon-graphic"
                        />
                      </span>
                      <div class="workshops-home__topic-copy">
                        <h3 class="workshops-home__topic-label">
                          <a
                            class="workshops-home__topic-link"
                            href={`${meta.detailHref}#${w.id}`}
                            data-workshops-home-arrow={w.id}
                            aria-label={`Přejít na workshop ${w.title}`}
                          >
                            {w.title}
                          </a>
                          <span class="workshops-home__topic-label-plain">{w.title}</span>
                        </h3>
                        <span class="workshops-home__topic-rule" aria-hidden="true" />
                        {w.ageRange ? (
                          <span class="workshop__age">{w.ageRange}</span>
                        ) : null}
                        {w.homeSummary ? (
                          <p class="workshops-home__topic-summary">{w.homeSummary}</p>
                        ) : null}
                      </div>
                      <a
                        class="workshops-home__arrow"
                        href={`${meta.detailHref}#${w.id}`}
                        data-workshops-home-arrow={w.id}
                        aria-label={`Přejít na workshop ${w.title}`}
                      >
                        <Icon
                          name="iconamoon:arrow-right-2-light"
                          class="workshops-home__arrow-graphic"
                        />
                      </a>
                    </div>
                  </li>
                ))
              }
            </ul>
            <p class="workshops-home__info">
              <span class="workshops-home__info-inner">
                <Icon
                  name="fluent:info-24-regular"
                  class="workshops-home__info-icon"
                  aria-hidden="true"
                />
                <span class="workshops-home__info-text">{meta.cardInfoText}</span>
              </span>
            </p>
          </div>
        </div>
      </li>
    </ul>

    <div class="workshops-home__cta reveal">
      <a class="btn btn-primary" href={meta.detailHref}>
        {meta.ctaLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .workshops-home {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .workshops-home .section-title-accent {
    color: var(--color-sky-deep);
  }

  /* Mobile-first: stejné tokeny šířky karty jako .age-home__grid */
  .workshops-home__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .workshops-home__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: 0;
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshops-home__aside {
    display: contents;
  }

  .workshops-home__note-description,
  .workshops-home__card-cta {
    display: none;
  }

  .workshops-home__topic-icon {
    display: none;
  }

  .workshop__age {
    display: none;
  }

  .workshops-home__note-icon-ring {
    display: contents;
  }

  .workshops-home__note {
    margin: 0;
    padding: var(--space-8) var(--card-padding-x) var(--space-8);
    border-radius: 0;
    background: var(--color-apricot-soft);
    text-align: center;
  }

  .workshops-home__note-inner {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    max-width: 100%;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
    text-align: center;
  }

  .workshops-home__note-text {
    max-width: 22ch;
  }

  .workshops-home__note-highlight {
    color: var(--color-blush-deep);
    font-weight: 600;
  }

  .workshops-home__note-icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }

  .workshops-home__body {
    min-width: 0;
    padding: var(--card-padding);
  }

  .workshops-home__topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .workshops-home__topic {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .workshops-home__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-5) 0;
    border: none;
    background: rgba(42, 31, 56, 0.12);
  }

  .workshops-home__topic-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .workshops-home__topic:last-child .workshops-home__topic-row {
    margin-bottom: var(--space-8);
  }

  .workshops-home__topic-copy {
    flex: 1;
    min-width: 0;
  }

  .workshops-home__topic-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--color-ink);
  }

  .workshops-home__topic-link {
    display: none;
  }

  .workshops-home__topic-rule {
    display: block;
    width: 2.75rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--accent);
    margin: 0 0 var(--space-4);
  }

  .workshops-home__topic-summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-home__arrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    text-decoration: none;
    transition: transform 200ms ease;
  }

  .workshops-home__arrow:hover,
  .workshops-home__arrow:focus-visible {
    transform: scale(1.05);
  }

  .workshops-home__arrow-graphic {
    width: 1.5rem;
    height: 1.5rem;
  }

  .workshops-home__info {
    margin: var(--space-6) 0 0;
    padding: 0;
  }

  .workshops-home__info-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-blush-soft);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  .workshops-home__info-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    color: var(--color-blush-deep);
  }

  .workshops-home__info-text {
    flex: 1;
    min-width: 0;
  }

  .workshops-home__cta {
    margin-top: var(--stack-gap);
    display: flex;
    justify-content: center;
  }

  .workshops-home__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .workshops-home__cta :global(.btn-primary:hover) {
      box-shadow: var(--shadow-pop);
    }
  }

  .workshops-home__cta :global(.btn-primary:active) {
    box-shadow: var(--shadow-pop);
    transform: translate3d(0, 0, 0) scale(0.98);
  }

  @media (min-width: 768px) {
    .workshops-home__cta :global(.btn) {
      width: auto;
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .workshops-home__grid {
      width: min(100%, 60rem);
      max-width: 100%;
      grid-template-columns: minmax(0, 1fr);
      justify-content: stretch;
    }

    .workshops-home__card {
      display: grid;
      grid-template-columns: minmax(0, 31%) minmax(0, 69%);
      align-items: stretch;
      border: 1px solid color-mix(in srgb, var(--color-ink) 10%, #fefefe);
    }

    .workshops-home__aside {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      height: 100%;
      padding: var(--card-padding);
      background: var(--color-apricot-soft);
    }

    .workshops-home__note {
      margin: 0;
      padding: 0;
      background: transparent;
      text-align: left;
    }

    .workshops-home__note-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
      text-align: left;
    }

    .workshops-home__note-icon-ring {
      display: grid;
      place-items: center;
      align-self: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius-full);
      background: var(--color-blush-soft);
    }

    .workshops-home__note-icon {
      width: 1.375rem;
      height: 1.375rem;
    }

    .workshops-home__note-text {
      max-width: 14ch;
      font-size: var(--text-h3);
      line-height: var(--line-height-xl);
      font-weight: 600;
      line-height: var(--line-height-2xl);
    }

    .workshops-home__note-description {
      display: block;
      margin: 0;
      max-width: 28ch;
      font-family: var(--font-body);
      font-size: var(--text-lg);
      font-weight: 400;
      line-height: var(--line-height-base);
      color: var(--color-ink);
    }

    .workshops-home__card-cta {
      display: inline-flex;
      width: 100%;
      max-width: 16rem;
      box-shadow: none;
    }

    .workshops-home__cta {
      display: none;
    }

    .workshops-home__body {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding: var(--card-padding);
    }

    .workshops-home__topic-row {
      position: relative;
      min-height: 110px;
      align-items: center;
      gap: var(--space-5);
      margin-left: 0.75rem;
    }

    .workshops-home__topic-label-plain {
      display: none;
    }

    .workshops-home__topic-link {
      display: inline;
      position: static;
      color: inherit;
      text-decoration: none;
    }

    .workshops-home__topic-link::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    .workshops-home__topic-link:focus-visible {
      outline: none;
    }

    .workshops-home__topic-row:has(.workshops-home__topic-link:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: var(--radius-card);
    }

    .workshops-home__topic-label {
      margin: 0 0 var(--space-2);
      font-size: var(--text-h3);
      line-height: var(--line-height-xl);
    }

    .workshops-home__topic-rule {
      display: block;
      margin: 0 0 var(--space-3);
    }

    .workshop__age {
      display: inline-flex;
      align-items: center;
      margin: 0 0 var(--space-3);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-full);
      background: var(--accent-soft);
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: 600;
      line-height: var(--line-height-lg);
      color: var(--accent);
    }

    .workshops-home__topic-summary {
      font-size: var(--text-lg);
      color: var(--color-ink);
    }

    .workshops-home__topic:last-child .workshops-home__topic-row {
      margin-bottom: 1rem;
    }

    .workshops-home__arrow {
      position: relative;
      inset-inline-end: var(--space-4);
      width: var(--space-10);
      height: var(--space-10);
      pointer-events: none;
      transition: transform 180ms ease;
    }

    .workshops-home__topic-row:has(.workshops-home__topic-link:hover)
      .workshops-home__arrow,
    .workshops-home__topic-row:has(.workshops-home__topic-link:focus-visible)
      .workshops-home__arrow {
      transform: translateX(0.25rem);
    }

    .workshops-home__arrow:hover,
    .workshops-home__arrow:focus-visible {
      transform: none;
    }

    .workshops-home__arrow-graphic {
      width: var(--text-3xl);
      height: var(--text-3xl);
    }

    .workshops-home__info {
      margin-top: var(--space-7);
    }

    .workshops-home__info-inner {
      gap: var(--space-3);
      padding: var(--space-2) var(--space-6);
      border-radius: var(--radius-2xl);
    }

    .workshops-home__info-icon {
      width: 1.5rem;
      height: 1.5rem;
    }

    .workshops-home__info-text {
      font-size: var(--text-sm);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .workshops-home__card-cta:hover {
      box-shadow: var(--shadow-pop);
    }
  }

  .workshops-home__card-cta:active {
    box-shadow: var(--shadow-pop);
    transform: translate3d(0, 0, 0) scale(0.98);
  }
</style>

<script>
  const WORKSHOPS_HOME_SCROLL_KEY = "workshops-home-scroll";

  const syncWorkshopsHomeArrowTabIndex = () => {
    const isDesktop = window.matchMedia("(min-width: 1024px)").matches;

    document
      .querySelectorAll<HTMLAnchorElement>(
        ".workshops-home__arrow[data-workshops-home-arrow]",
      )
      .forEach((link) => {
        link.tabIndex = isDesktop ? -1 : 0;
      });
  };

  const setupWorkshopsHomeArrows = () => {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-workshops-home-arrow]")
      .forEach((link) => {
        if (link.dataset.homeArrowReady === "true") return;
        link.dataset.homeArrowReady = "true";

        link.addEventListener("click", (event) => {
          const id = link.getAttribute("data-workshops-home-arrow");
          if (!id) return;

          event.preventDefault();
          sessionStorage.setItem(WORKSHOPS_HOME_SCROLL_KEY, id);
          window.location.assign(link.pathname);
        });
      });
  };

  setupWorkshopsHomeArrows();
  syncWorkshopsHomeArrowTabIndex();
  window.addEventListener("resize", syncWorkshopsHomeArrowTabIndex, {
    passive: true,
  });
  document.addEventListener("astro:page-load", setupWorkshopsHomeArrows);
  document.addEventListener("astro:page-load", syncWorkshopsHomeArrowTabIndex);
</script>
