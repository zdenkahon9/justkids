---
import Icon from "astro-iconify";
import { workshops, workshopsHomeMeta } from "../data/WorkshopsHome";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = workshopsHomeMeta;

/** Iconify názvy (sada:id) — mapování podle id z WorkshopsHome.ts */
const workshopIconById: Record<string, string> = {
  "prvni-pomoc-u-deti": "fluent:briefcase-medical-24-regular",
  "handling-a-psychomotoricky-vyvoj": "streamline-sharp:health-care-2",
  "psychomotoricky-vyvoj-prevence": "ph:brain",
};
---

<section
  id={meta.sectionId}
  class="section workshops-home"
  aria-labelledby="workshops-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">{meta.eyebrow}</span>
      <h2 id="workshops-title">
        {meta.title}{" "}
        <span class="section-title-accent">{meta.titleAccent}</span>
      </h2>
      <p class="section-subtitle">{meta.subtitle}</p>
    </header>

    <ul class="workshops-home__grid">
      <li>
        <div class="workshops-home__card reveal">
          <div class="workshops-home__body">
            <h3 class="workshops-home__heading">Témata workshopů:</h3>
            <ul class="workshops-home__topics">
              {
                workshops.map((w) => (
                  <li
                    class="workshops-home__topic"
                    style={`--accent: ${cardAccentDeep(w.accent)}; --accent-soft: ${cardAccentSoft(w.accent)};`}
                  >
                    <span class="workshops-home__topic-icon" aria-hidden="true">
                      <Icon
                        name={
                          workshopIconById[w.id] ?? "streamline:health-care-2"
                        }
                        class="workshops-home__topic-icon-graphic"
                      />
                    </span>
                    <span class="workshops-home__topic-label">{w.title}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </li>
    </ul>

    <div class="workshops-home__cta reveal">
      <a class="btn btn-primary" href={meta.detailHref}>
        {meta.ctaLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .workshops-home {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .workshops-home .section-title-accent {
    color: var(--color-blush-vivid);
  }

  /* Mobile-first: stejné tokeny šířky karty jako .age-home__grid */
  .workshops-home__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .workshops-home__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .workshops-home__heading {
    margin: 0 0 var(--space-9);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .workshops-home__topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-8);
  }

  .workshops-home__topic {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }

  .workshops-home__topic:last-child {
    margin-bottom: 0;
  }

  .workshops-home__topic-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: var(--card-icon-size);
    height: var(--card-icon-size);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 280ms ease;
  }

  .workshops-home__topic-icon-graphic {
    width: var(--footer-social-icon-size);
    height: var(--footer-social-icon-size);
  }

  .workshops-home__topic-label {
    display: block;
    flex: 1;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--color-ink);
  }

  .workshops-home__cta {
    margin-top: var(--stack-gap);
    display: flex;
    justify-content: center;
  }

  .workshops-home__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    padding: 1.125rem 1.375rem;
    border-radius: var(--radius-full);
    box-shadow: none;
  }

  .workshops-home__cta :global(.btn-primary:hover),
  .workshops-home__cta :global(.btn-primary:active) {
    box-shadow: var(--shadow-pop);
  }

  @media (min-width: 768px) {
    .workshops-home__grid {
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--card-grid-width-md));
      justify-content: center;
    }

    .workshops-home__cta :global(.btn) {
      width: auto;
      max-width: none;
    }
  }

  @media (min-width: 1180px) {
    .workshops-home__grid {
      max-width: calc(2 * var(--card-grid-width-md) + var(--stack-gap));
      margin-inline: auto;
    }
  }
</style>
