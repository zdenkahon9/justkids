---
import Icon from "astro-iconify";
import { ageGroupsHomeCards, ageGroupsHomeMeta } from "../data/ageGroupsHome";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

const meta = ageGroupsHomeMeta;
---

<section
  id={meta.sectionId}
  class="section age-home"
  aria-labelledby="age-home-title"
>
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">{meta.eyebrow}</span>
      <h2 id="age-home-title">
        {meta.title}{" "}
        <span class="section-title-accent">{meta.titleAccent}</span>
      </h2>
      <p class="section-subtitle">
        Od 3 měsíců do 9 let – každá věková skupina má vlastní cvičení
        přizpůsobené vývoji dítěte.
      </p>
    </header>

    <ul class="age-home__grid">
      {
        ageGroupsHomeCards.map((card, i) => (
          <li>
            <div
              class="age-home__card reveal"
              style={`--accent: ${cardAccentDeep(card.accent)}; --accent-soft: ${cardAccentSoft(card.accent)}; transition-delay: ${i * 80}ms;`}
            >
              <svg
                class="age-home__blob"
                viewBox="-32 0 132 100"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M100 0 H-32 L0 0 A100 100 0 0 1 100 90 Z" />
              </svg>
              <div class="age-home__body">
                <div class="age-home__content">
                  <h3 class="age-home__heading">
                    <a class="age-home__card-link" href={meta.detailHref}>
                      {card.title}
                    </a>
                  </h3>
                  <div class="age-home__age-row">
                    <span class="age-home__age">{card.ageRange}</span>
                    <div class="age-home__illustration" aria-hidden="true">
                      <span class="age-home__icon-ring">
                        <Icon name={card.icon} class="age-home__icon-graphic" />
                      </span>
                    </div>
                  </div>
                  <p class="age-home__groups">
                    {card.groups.map((group, index) => (
                      <>
                        {index > 0 ? (
                          <span class="age-home__groups-sep" aria-hidden="true">
                            {" • "}
                          </span>
                        ) : null}
                        {group}
                      </>
                    ))}
                  </p>
                  <span class="age-home__rule" aria-hidden="true" />
                  <p class="age-home__summary">{card.summary}</p>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="age-home__cta reveal">
      <a class="btn btn-primary" href={meta.detailHref}>
        {meta.ctaLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .age-home {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .age-home .section-title-accent {
    color: var(--color-blush-vivid);
  }

  /* Mobile-first: stejné tokeny šířky karty jako .workshops__grid */
  .age-home__grid {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--card-grid-width));
    gap: var(--stack-gap);
    justify-content: center;
  }

  .age-home__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease;
  }

  .age-home__card:has(.age-home__card-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .age-home__card-link {
    position: static;
    color: inherit;
    text-decoration: none;
  }

  .age-home__card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .age-home__card-link:focus-visible {
    outline: none;
  }

  .age-home__blob {
    position: absolute;
    z-index: 0;
    top: -1px;
    right: -1px;
    width: 9.9rem;
    height: 7.5rem;
    display: block;
    pointer-events: none;
  }

  .age-home__blob path {
    fill: var(--accent-soft);
  }

  .age-home__body {
    z-index: 1;
  }

  .age-home__age-row {
    --age-text-height: calc(1.375rem * var(--line-height-2xl));
    position: relative;
    padding-right: calc(var(--card-icon-size-corner) + var(--space-4));
  }

  .age-home__illustration {
    position: absolute;
    right: 0;
    top: calc(0.5 * var(--age-text-height));
    transform: translateY(-50%);
  }

  .age-home__icon-ring {
    display: grid;
    place-items: center;
    width: var(--card-icon-size-corner);
    height: var(--card-icon-size-corner);
    border-radius: var(--radius-full);
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 280ms ease;
  }

  .age-home__icon-graphic {
    width: var(--card-icon-graphic-size-corner);
    height: var(--card-icon-graphic-size-corner);
  }

  .age-home__heading {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink);
  }

  .age-home__age {
    display: block;
    width: 100%;
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: var(--line-height-2xl);
    color: var(--accent);
  }

  .age-home__groups {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--line-height-xl);
    color: var(--color-ink-muted);
  }

  .age-home__groups-sep {
    color: var(--accent);
  }

  .age-home__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-5) 0 var(--space-5);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
  }

  .age-home__summary {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
    color: var(--color-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .age-home__card:has(.age-home__card-link:hover) {
      transform: translateY(-4px);
      box-shadow: 0 26px 55px -18px
        color-mix(in srgb, var(--accent) 45%, transparent);
    }

    .age-home__card:has(.age-home__card-link:hover) .age-home__icon-ring {
      transform: scale(1.05);
    }
  }

  .age-home__card:has(.age-home__card-link:active) {
    transform: translateY(-2px) scale(0.99);
    box-shadow: 0 18px 40px -18px
      color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .age-home__card:has(.age-home__card-link:active) .age-home__icon-ring {
    transform: scale(1.02);
  }

  .age-home__cta {
    margin-top: var(--stack-gap);
    display: flex;
    justify-content: center;
  }

  .age-home__cta :global(.btn) {
    width: 90%;
    max-width: var(--card-grid-width);
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .age-home__cta :global(.btn-primary:hover) {
      box-shadow: var(--shadow-pop);
    }
  }

  .age-home__cta :global(.btn-primary:active) {
    box-shadow: var(--shadow-pop);
    transform: translate3d(0, 0, 0) scale(0.98);
  }

  @media (min-width: 640px) {
    .age-home__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .age-home__age-row {
      display: contents;
    }

    .age-home__illustration {
      position: static;
      transform: none;
      align-self: center;
      margin-bottom: var(--space-4);
      order: -1;
    }

    .age-home__groups {
      font-size: var(--text-lg);
    }

    .age-home__blob {
      transform: scale(1.35, 1.55);
      transform-origin: 100% 0;
    }
  }

  @media (min-width: 768px) {
    .age-home__grid {
      width: min(100%, 1040px);
      max-width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
      justify-content: stretch;
    }

    .age-home__cta :global(.btn) {
      width: auto;
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .age-home__grid {
      width: fit-content;
      max-width: calc(760px + var(--space-7));
      grid-template-columns: repeat(2, 380px);
      justify-content: center;
    }

    .age-home__groups {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: var(--space-3);
    }

    .age-home__groups-sep {
      font-size: 0;
      line-height: 0;
    }

    .age-home__groups-sep::before {
      content: "•";
      font-size: var(--text-lg);
      line-height: var(--line-height-xl);
      color: var(--accent);
    }

    .age-home__summary {
      max-width: 24ch;
      font-size: var(--text-lg);
    }

    .age-home__rule {
      margin: var(--space-5) 0 var(--space-6);
    }
  }
</style>
