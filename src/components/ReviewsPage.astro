---
import Icon from "astro-iconify";
import { reviews, reviewsPageMeta } from "../data/reviews";
import { site } from "../data/site";
import { splitReviewText } from "../utils/splitReviewText";

const meta = reviewsPageMeta;
---

<section class="section reviews-page" aria-labelledby="reviews-page-title">
  <div class="reviews-page__intro">
    <div class="reviews-page__intro-nav-bg" aria-hidden="true">
      <div class="reviews-page__intro-photo"></div>
      <div class="reviews-page__intro-veil"></div>
    </div>
    <div class="container-x reviews-page__intro-inner">
      <header class="section-header reveal">
        <div class="reviews-page__head">
          <h1 id="reviews-page-title">
            {meta.title}{" "}
            <span class="section-title-accent">{meta.titleAccent}</span>
          </h1>
          <p class="section-subtitle">
            Přečtěte si, co o nás napsali rodiče na našem{" "}
            <a
              href={site.social.facebookReviews}
              target="_blank"
              rel="noopener noreferrer"
              class="reviews-page__fb"
              aria-label="Recenze na Facebooku"
            >
              Facebooku
              <Icon
                name="wordpress:external"
                class="reviews-page__fb-icon"
                aria-hidden="true"
              />
            </a>
          </p>
        </div>
      </header>
    </div>
  </div>

  <div class="container-x reviews-page__inner">
    <div class="about__divider reveal">
      <span aria-hidden="true">
        <Icon name="twemoji:pink-heart" class="about__divider-icon" />
      </span>
    </div>

    <ol class="reviews-page__list" role="list">
      {
        reviews.map((r, i) => (
          <li
            class="reviews-page__item reveal"
            style={`transition-delay: ${Math.min(i, 6) * 70}ms;`}
          >
            {r.rating && (
              <div
                class="reviews-page__stars"
                aria-label={`Hodnocení ${r.rating} z 5`}
              >
                {Array.from({ length: 5 }, (_, k) => (
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class={k < (r.rating ?? 0) ? "is-on" : ""}
                  >
                    <path
                      d="M 12 2 L 14.5 8.5 L 21 9 L 16 13.5 L 17.5 20 L 12 16.5 L 6.5 20 L 8 13.5 L 3 9 L 9.5 8.5 Z"
                      fill="currentColor"
                    />
                  </svg>
                ))}
              </div>
            )}

            <blockquote class="reviews-page__text">
              {splitReviewText(r.text).map((part) =>
                part.emoji ? (
                  <span class="reviews-page__emoji">{part.value}</span>
                ) : (
                  part.value
                ),
              )}
            </blockquote>

            {r.childAge && (
              <span class="reviews-page__date">{r.childAge}</span>
            )}
          </li>
        ))
      }
    </ol>

    <div class="reviews-page__footer reveal">
      <a class="btn btn-ghost reviews-page__back-btn" href="/">
        <span aria-hidden="true">←</span> Zpět na hlavní stránku
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-page {
    --accent: var(--color-blush-deep);
    padding-top: 0;
    padding-bottom: 0;
    scroll-margin-top: var(--nav-height);
    background-color: var(--color-cream);
  }

  /* Mini page-hero — pod navbarom stejná vrstva jako na AgeGroupsPage */
  .reviews-page__intro {
    position: relative;
    background-color: var(--color-cream);
  }

  .reviews-page__intro-nav-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .reviews-page__intro-photo {
    position: absolute;
    left: -3%;
    right: -3%;
    top: -3svh;
    height: 106svh;
    background-image: url("/images/hero-balloons.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    transform-origin: center top;
  }

  .reviews-page__intro-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100svh;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.55) 72%,
        rgba(255, 249, 244, 0.95) 100%
      );
  }

  .reviews-page__intro-inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-height) + var(--section-header-spacing));
  }

  .reviews-page__intro .section-header {
    margin-bottom: var(--section-header-spacing);
  }

  /* Editorial reading column — narrow + centered for comfortable mobile reading */
  .reviews-page__inner {
    max-width: 44rem;
  }

  .reviews-page .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .reviews-page__fb {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .reviews-page__fb:hover {
    color: var(--color-ink);
  }

  .reviews-page__fb-icon {
    width: 1.125em;
    height: 1.125em;
    flex-shrink: 0;
    color: currentColor;
  }

  .reviews-page__fb-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .reviews-page .section-header h1 {
    font-size: var(--text-clamp-h2);
    margin-bottom: 2rem;
  }

  /* Desktop: obal je průhledný; mobil viz @media níže (639px = section-header v global.css) */
  .reviews-page__head {
    display: contents;
  }

  .about__divider {
    position: relative;
    margin: 2rem 0 2rem;
    height: 1px;
    background: var(--color-blush-mid);
  }

  .about__divider span {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-cream);
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .about__divider-icon {
    width: 1rem;
    height: 1rem;
  }

  /* Editorial list — vertical rhythm + subtle dividers, no cards */
  .reviews-page__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .reviews-page__item {
    padding-block: var(--space-9);
  }

  .reviews-page__item:first-child {
    padding-top: var(--space-6);
  }

  .reviews-page__item:last-child {
    padding-bottom: var(--space-6);
  }

  /* Stejná barva oddělovače jako age-page__rule (např. první karta Locations) */
  .reviews-page__item + .reviews-page__item {
    border-top: 1px solid
      color-mix(in srgb, var(--accent) 16%, var(--color-ink) 4%);
  }

  /* Same star styling as the homepage review cards */
  .reviews-page__stars {
    display: inline-flex;
    align-items: center;
    margin: 0 0 var(--space-4);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-ink);
  }

  .reviews-page__stars svg {
    width: 1em;
    height: 1em;
    color: rgba(42, 31, 56, 0.15);
  }

  .reviews-page__stars svg.is-on {
    color: #f5b400;
  }

  /* Full-length review text — never truncated, preserves line breaks */
  .reviews-page__text {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-style: italic;
    line-height: var(--line-height-base);
    white-space: pre-line;
    word-break: break-word;
  }

  .reviews-page__emoji {
    font-style: normal;
  }

  .reviews-page__date {
    display: block;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--line-height-base);
    color: var(--color-ink-muted);
  }

  .reviews-page__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  /* Mobilní section-header — stejný breakpoint jako global.css (639px) */
  @media (max-width: 639px) {
    .reviews-page__head {
      display: inline-grid;
      grid-template-columns: minmax(0, max-content);
      justify-items: stretch;
      max-width: 100%;
      margin-inline: auto;
      text-align: center;
    }

    .reviews-page__head h1,
    .reviews-page .section-subtitle {
      grid-column: 1;
    }

    .reviews-page .section-subtitle {
      width: 0;
      min-width: 100%;
      text-wrap: pretty;
    }
  }

  @media (min-width: 768px) {
    .reviews-page__text {
      font-size: var(--text-xl);
    }
  }
</style>
