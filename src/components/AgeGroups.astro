---
import Icon from "astro-iconify";
import { ageGroups } from "../data/ageGroups";
import { cardAccentDeep, cardAccentSoft } from "../utils/cardAccent";

/** Iconify názvy (sada:id) — mapování podle id z ageGroups.ts */
const ageIconById: Record<string, string> = {
  "3-6": "fxemoji:cherryblossom",
  "6-12": "twemoji:hatching-chick",
  "1-2": "noto-v1:lion",
  "2-3": "emojione:monkey-face",
};
---

<section id="vekove-skupiny" class="section age" aria-labelledby="age-title">
  <div class="container-x">
    <header class="section-header reveal">
      <span class="eyebrow">Věkové kategorie</span>
      <h2 id="age-title">
        Pro každý věk <span class="section-title-accent">to pravé cvičení</span>
      </h2>
      <p class="section-subtitle">
        Každá věková skupina má vlastní náplň – od jemné stimulace pro miminka
        po hravé překážky pro batolata. Vše v klidu a v tempu, které dítěti
        vyhovuje.
      </p>
    </header>

    <ul class="age__grid">
      {
        ageGroups.map((g, i) => (
          <li
            class="age__card reveal"
            style={`--accent: ${cardAccentDeep(g.accent)}; --accent-soft: ${cardAccentSoft(g.accent)}; transition-delay: ${i * 80}ms;`}
          >
            {i === 0 ? (
              <span class="age__new" aria-label="Novinka">
                Nově
              </span>
            ) : null}
            {g.optional ? <span class="age__optional">Dle kurzu</span> : null}
            <div class="age__top">
              <div class="age__icon" aria-hidden="true">
                <Icon
                  name={ageIconById[g.id] ?? "emojione:monkey-face"}
                  class="age__icon-graphic"
                />
              </div>
              <h3 class="age__title">{g.title}</h3>
              <span class="age__range">{g.range}</span>
            </div>
            <div class="age__desc">
              <p>{g.description}</p>
            </div>
            {/* <div class="age__details">
              <ul class="age__highlights">
                {g.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div> */}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  #vekove-skupiny {
    scroll-margin-top: var(--section-scroll-margin);
  }

  .age .section-title-accent {
    color: var(--color-blush-vivid);
  }

  /* Mobile-first: jednotný subgrid uvnitř karty; mění se jen počet sloupců */
  .age__grid {
    --age-card-width: var(--card-grid-width);
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: fit-content;
    max-width: 100%;
    display: grid;
    grid-template-columns: min(100%, var(--age-card-width));
    grid-auto-rows: auto auto auto;
    gap: var(--stack-gap);
    justify-content: center;
  }

  .age__card {
    position: relative;
    list-style: none;
    box-sizing: border-box;
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    text-align: center;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    padding-top: var(--card-padding-top-wave);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease,
      filter 280ms ease;
  }

  .age__card::before {
    content: "";
    position: absolute;
    top: 0;
    left: -4%;
    right: -4%;
    height: 3.5rem;
    background: var(--accent-soft);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    pointer-events: none;
  }

  /** „Nově“ — první karta (3–6 měsíců); pill + border, horní levý roh */
  .age__new {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    z-index: 5;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    background: #fff;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-full);
    border: 2px solid
      color-mix(in srgb, var(--accent) 55%, var(--color-ink) 12%);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent),
      0 4px 14px -6px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .age__optional {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 4;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    background: var(--color-cream);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .age__top {
    display: flex;
    flex-direction: column;
    grid-row: 1;
    align-self: start;
  }

  .age__icon {
    position: relative;
    z-index: 1;
    width: var(--card-icon-size-wave);
    height: var(--card-icon-size-wave);
    margin: calc(-1 * var(--card-icon-overlap-wave)) auto 1.25rem;
    border-radius: var(--radius-full);
    background: #fff;
    border: none;
    display: grid;
    place-items: center;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 0 0 6px color-mix(in srgb, var(--accent) 12%, white),
      0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .age__icon-graphic {
    width: var(--card-icon-graphic-size-wave);
    height: var(--card-icon-graphic-size-wave);
    flex-shrink: 0;
    filter: drop-shadow(
      0 3px 10px color-mix(in srgb, var(--accent) 35%, transparent)
    );
  }

  .age__range {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 1rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-ink);
    line-height: var(--line-height-xl);
    text-align: center;
  }

  .age__title {
    margin: 0 auto 0.375rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    color: var(--accent);
    line-height: var(--line-height-2xl);
    text-align: center;
  }

  .age__desc {
    margin: 0 0 1.75rem;
    font-size: var(--text-base);
    grid-row: 2;
    align-self: start;
    text-align: center;
  }

  .age__card p {
    color: var(--color-ink);
    margin: 0;
    font-size: var(--text-base);
  }

  .age__details {
    padding: var(--space-4);
    border-radius: var(--radius-xl);
    background: var(--accent-soft);
    grid-row: 3;
    align-self: start;
    text-align: left;
  }

  .age__highlights {
    list-style-type: disc;
    list-style-position: outside;
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .age__highlights > li {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-ink);
  }

  .age__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 55px -18px
      color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .age__card:hover .age__icon {
    transform: scale(1.05);
  }

  @media (min-width: 768px) {
    .age__grid {
      --age-card-width: var(--card-grid-width-md);
      width: fit-content;
      max-width: 100%;
      grid-template-columns: repeat(2, var(--age-card-width));
      justify-content: center;
    }
  }

  @media (min-width: 1180px) {
    .age__grid {
      --age-card-width: var(--card-grid-width-md);
      max-width: calc(2 * var(--age-card-width) + var(--stack-gap));
      margin-inline: auto;
    }

    .age__range {
      margin-bottom: 1.25rem;
    }

    .age__desc {
      margin-bottom: 1.25rem;
    }

    .age__highlights li {
      font-size: var(--text-base);
    }
  }
</style>
