---
import { ageGroups } from "../data/ageGroups";

const accentMap: Record<string, string> = {
  blush: "var(--color-blush-mid)",
  sky: "var(--color-sky-mid)",
  lilac: "var(--color-lilac-mid)",
  cream: "var(--color-cream-200)",
};

const emojiMap: Record<string, string> = {
  "3-6": "🌸",
  "6-12": "🐣",
  "1-2": "🦁",
  "2-3": "🐵",
};

/** Which card skin: `wave` | `bubbles`. Maps to <li data-variant="…"> + CSS below. */
const cardVariant = (index: number) => (index < 2 ? "wave" : "bubbles");
---

<section
  id="vekove-skupiny"
  class="section age"
  aria-labelledby="age-title"
>
  <div class="container-x">
    <header class="age__header reveal">
      <span class="eyebrow">Věkové kategorie</span>
      <h2 id="age-title">
        Pro každý věk <span class="section-title-accent">to pravé cvičení</span>
      </h2>
      <p class="age__subtitle">
        Každá věková skupina má vlastní náplň – od jemné stimulace pro miminka
        po hravé překážky pro batolata. Vše v klidu a v tempu, které dítěti
        vyhovuje.
      </p>
    </header>

    <ul class="age__grid">
      {
        ageGroups.map((g, i) => (
          <li
            class="age__card reveal"
            data-accent={g.accent}
            data-variant={cardVariant(i)}
            style={`--accent: ${accentMap[g.accent]}; transition-delay: ${i * 80}ms;`}
          >
            {g.optional ? (
              <span class="age__optional">Dle kurzu</span>
            ) : null}
            <div class="age__icon" aria-hidden="true">
              <span class="age__emoji">{emojiMap[g.id]}</span>
            </div>
            <div class="age__range">{g.range}</div>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
            <ul class="age__highlights">
              {g.highlights.map((h) => (
                <li>
                  <svg
                    viewBox="0 0 16 16"
                    width="14"
                    height="14"
                    aria-hidden="true"
                  >
                    <path
                      d="M 3 8 L 7 12 L 13 4"
                      stroke="currentColor"
                      stroke-width="2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {h}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /*
   * ---------------------------------------------------------------------------
   * AgeGroups — věkové karty
   * • ŽIVÉ styly: sekce LIVE WAVE / LIVE BUBBLES (nepřesouvat bez úmyslu).
   * • Archiv: na konci souboru v <style> je zakomentovaný duplikát obou variant
   *   (ARCHIVED PATTERN: WAVE / BUBBLES) — kopírování pro jinou sekci nebo obnovu.
   * • HTML: <li class="age__card" data-variant="wave"|"bubbles"
   *         style="--accent: …; transition-delay: …">
   * ---------------------------------------------------------------------------
   */

  #vekove-skupiny {
    scroll-margin-top: -5.5rem;
  }
  .age__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }

  .age__header h2 {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    margin: 0 0 1.5rem;
  }

  .age__header h2 .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .age__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  .age__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .age__card {
    position: relative;
    list-style: none;
    box-sizing: border-box;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease,
      filter 280ms ease;
  }

  .age__optional {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 4;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    background: var(--color-cream);
    padding: 0.3rem 0.6rem;
    border-radius: 9999px;
  }

  .age__icon {
    width: 72px;
    height: 72px;
    background: color-mix(in srgb, var(--accent) 35%, white);
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin: 0 auto 1.25rem;
  }

  .age__emoji {
    font-size: 2.5rem;
    line-height: 1;
  }

  .age__range {
    display: inline-block;
    font-family: var(--font-script);
    font-size: 1.4rem;
    color: var(--color-blush-vivid);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .age__card h3 {
    font-size: 1.4rem;
    margin: 0 0 0.65rem;
  }

  .age__card p {
    color: var(--color-ink-soft);
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }

  .age__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .age__highlights li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .age__highlights svg {
    color: var(--color-blush-vivid);
    flex-shrink: 0;
  }

  /* ========== LIVE: wave (data-variant="wave") ========== */
  .age__card[data-variant="wave"] {
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    padding-top: 4.5rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    background: linear-gradient(
      180deg,
      var(--color-cream-50) 0%,
      #fefefe 45%,
      color-mix(in srgb, var(--accent) 14%, white) 100%
    );
    overflow: hidden;
  }

  .age__card[data-variant="wave"]::before {
    content: "";
    position: absolute;
    top: 0;
    left: -4%;
    right: -4%;
    height: 3.5rem;
    background: color-mix(in srgb, var(--accent) 38%, white);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    pointer-events: none;
  }

  .age__card[data-variant="wave"] .age__icon {
    position: relative;
    z-index: 1;
    background: white;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 10px 28px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .age__card[data-variant="wave"] .age__range {
    color: var(--color-ink-soft);
  }

  .age__card[data-variant="wave"]:hover {
    transform: translateY(-4px);
    box-shadow:
      0 26px 55px -18px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .age__card[data-variant="wave"]:hover .age__icon {
    transform: scale(1.05);
  }

  /* ========== LIVE: bubbles (data-variant="bubbles") ========== */
  .age__card[data-variant="bubbles"] {
    text-align: center;
    border-radius: 1.75rem;
    padding: 4.35rem 1.55rem 1.85rem;
    border: 2px solid color-mix(in srgb, var(--accent) 28%, white);
    background-color: #fffefb;
    background-image:
      radial-gradient(
        85% 70% at 8% 0%,
        color-mix(in srgb, var(--color-lilac-mid) 38%, transparent),
        transparent 58%
      ),
      radial-gradient(
        75% 65% at 100% 8%,
        color-mix(in srgb, var(--color-blush-mid) 42%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 55% at 50% 100%,
        color-mix(in srgb, var(--accent) 22%, transparent),
        transparent 52%
      ),
      linear-gradient(180deg, var(--color-cream-50) 0%, #fffefb 55%);
    box-shadow: none;
    overflow: hidden;
    isolation: isolate;
  }

  .age__card[data-variant="bubbles"] > *:not(.age__optional) {
    position: relative;
    z-index: 1;
  }

  .age__card[data-variant="bubbles"]::before {
    content: "";
    position: absolute;
    top: 0;
    left: -7%;
    right: -7%;
    height: 3.85rem;
    z-index: 0;
    background: color-mix(in srgb, var(--accent) 44%, white);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    pointer-events: none;
  }

  .age__card[data-variant="bubbles"] .age__emoji {
    filter: drop-shadow(0 3px 10px color-mix(in srgb, var(--accent) 35%, transparent));
  }

  .age__card[data-variant="bubbles"] .age__icon {
    width: 80px;
    height: 80px;
    margin: -2.85rem auto 1.05rem;
    border-radius: 999px;
    background: #fff;
    border: none;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 0 0 6px color-mix(in srgb, var(--accent) 12%, white),
      0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .age__card[data-variant="bubbles"] .age__range {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.7rem;
    padding: 0.38rem 1.1rem;
    font-family: "Sniglet", var(--font-display), system-ui, sans-serif;
    font-size: 1.06rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--accent) 24%, white);
    border-radius: 999px;
    border: 2px solid color-mix(in srgb, var(--accent) 38%, white);
    box-shadow: 0 2px 0 color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .age__card[data-variant="bubbles"] h3 {
    margin-left: auto;
    margin-right: auto;
    max-width: 20ch;
  }

  .age__card[data-variant="bubbles"] p {
    margin-left: auto;
    margin-right: auto;
    max-width: 32ch;
  }

  .age__card[data-variant="bubbles"] .age__highlights li {
    justify-content: flex-start;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--color-cream-100) 88%, var(--accent));
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    text-align: left;
  }

  .age__card[data-variant="bubbles"] .age__highlights svg {
    color: color-mix(in srgb, var(--accent) 55%, var(--color-blush-vivid));
  }

  .age__card[data-variant="bubbles"]:hover {
    transform: translateY(-4px);
    box-shadow:
      0 26px 55px -18px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .age__card[data-variant="bubbles"]:hover .age__icon {
    transform: scale(1.05);
  }

  /*
   * ===========================================================================
   * ARCHIVED PATTERNS — zakomentovaný SNAPSHOT pro pozdější použití
   * (kopírovat do aktivní části výše; po úpravě LIVE bloků aktualizuj i tady)
   * ===========================================================================

  ---------- ARCHIVED PATTERN: WAVE ----------
  .age__card[data-variant="wave"] {
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    padding-top: 4.5rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    background: linear-gradient(
      180deg,
      var(--color-cream-50) 0%,
      #fefefe 45%,
      color-mix(in srgb, var(--accent) 14%, white) 100%
    );
    overflow: hidden;
  }

  .age__card[data-variant="wave"]::before {
    content: "";
    position: absolute;
    top: 0;
    left: -4%;
    right: -4%;
    height: 3.5rem;
    background: color-mix(in srgb, var(--accent) 38%, white);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    pointer-events: none;
  }

  .age__card[data-variant="wave"] .age__icon {
    position: relative;
    z-index: 1;
    background: white;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 10px 28px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .age__card[data-variant="wave"] .age__range {
    color: var(--color-ink-soft);
  }

  .age__card[data-variant="wave"]:hover {
    transform: translateY(-4px);
    box-shadow:
      0 26px 55px -18px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .age__card[data-variant="wave"]:hover .age__icon {
    transform: scale(1.05);
  }

  ---------- ARCHIVED PATTERN: BUBBLES ----------
  .age__card[data-variant="bubbles"] {
    text-align: center;
    border-radius: 1.75rem;
    padding: 4.35rem 1.55rem 1.85rem;
    border: 2px solid color-mix(in srgb, var(--accent) 28%, white);
    background-color: #fffefb;
    background-image:
      radial-gradient(
        85% 70% at 8% 0%,
        color-mix(in srgb, var(--color-lilac-mid) 38%, transparent),
        transparent 58%
      ),
      radial-gradient(
        75% 65% at 100% 8%,
        color-mix(in srgb, var(--color-blush-mid) 42%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 55% at 50% 100%,
        color-mix(in srgb, var(--accent) 22%, transparent),
        transparent 52%
      ),
      linear-gradient(180deg, var(--color-cream-50) 0%, #fffefb 55%);
    box-shadow: none;
    overflow: hidden;
    isolation: isolate;
  }

  .age__card[data-variant="bubbles"] > *:not(.age__optional) {
    position: relative;
    z-index: 1;
  }

  .age__card[data-variant="bubbles"]::before {
    content: "";
    position: absolute;
    top: 0;
    left: -7%;
    right: -7%;
    height: 3.85rem;
    z-index: 0;
    background: color-mix(in srgb, var(--accent) 44%, white);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    pointer-events: none;
  }

  .age__card[data-variant="bubbles"] .age__emoji {
    filter: drop-shadow(0 3px 10px color-mix(in srgb, var(--accent) 35%, transparent));
  }

  .age__card[data-variant="bubbles"] .age__icon {
    width: 80px;
    height: 80px;
    margin: -2.85rem auto 1.05rem;
    border-radius: 999px;
    background: #fff;
    border: none;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 0 0 6px color-mix(in srgb, var(--accent) 12%, white),
      0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .age__card[data-variant="bubbles"] .age__range {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.7rem;
    padding: 0.38rem 1.1rem;
    font-family: "Sniglet", var(--font-display), system-ui, sans-serif;
    font-size: 1.06rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--accent) 24%, white);
    border-radius: 999px;
    border: 2px solid color-mix(in srgb, var(--accent) 38%, white);
    box-shadow: 0 2px 0 color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .age__card[data-variant="bubbles"] h3 {
    margin-left: auto;
    margin-right: auto;
    max-width: 20ch;
  }

  .age__card[data-variant="bubbles"] p {
    margin-left: auto;
    margin-right: auto;
    max-width: 32ch;
  }

  .age__card[data-variant="bubbles"] .age__highlights li {
    justify-content: flex-start;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--color-cream-100) 88%, var(--accent));
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    text-align: left;
  }

  .age__card[data-variant="bubbles"] .age__highlights svg {
    color: color-mix(in srgb, var(--accent) 55%, var(--color-blush-vivid));
  }

  .age__card[data-variant="bubbles"]:hover {
    transform: translateY(-4px);
    box-shadow:
      0 26px 55px -18px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .age__card[data-variant="bubbles"]:hover .age__icon {
    transform: scale(1.05);
  }

   * ===========================================================================
   */

  @media (min-width: 1024px) {
    .age__header h2 {
      margin: 0 0 1rem;
    }

    .age__subtitle {
      font-size: 1.0625rem;
    }
  }
</style>
