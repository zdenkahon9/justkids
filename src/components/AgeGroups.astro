---
import Icon from "astro-iconify";
import { ageGroups } from "../data/ageGroups";

const accentMap: Record<string, string> = {
  blush: "var(--color-blush-mid)",
  sky: "var(--color-sky-mid)",
  lilac: "var(--color-lilac-mid)",
  cream: "var(--color-cream-200)",
};

const cardAccentVar = (index: number, accent: keyof typeof accentMap) => {
  if (index === 0) return "var(--color-sky-deep)";
  if (index === 1) return "var(--color-lilac-deep)";
  if (index === 2) return "var(--color-blush-deep)";
  if (index === 3) return "var(--color-coral-deep)";
  return accentMap[accent];
};

/** Iconify názvy (sada:id) — mapování podle id z ageGroups.ts */
const ageIconById: Record<string, string> = {
  "3-6": "fxemoji:cherryblossom",
  "6-12": "twemoji:hatching-chick",
  "1-2": "noto-v1:lion",
  "2-3": "emojione:monkey-face",
};

/** Card skin: all rows use `wave`. `--accent`: 0 sky-deep, 1 lilac-deep, 2 blush-deep, 3 coral-deep, else from data. */
const cardVariant = (_index: number) => "wave";
---

<section id="vekove-skupiny" class="section age" aria-labelledby="age-title">
  <div class="container-x age__container">
    <header class="age__header reveal">
      <span class="eyebrow">Věkové kategorie</span>
      <h2 id="age-title">
        Pro každý věk <span class="section-title-accent">to pravé cvičení</span>
      </h2>
      <p class="age__subtitle">
        Každá věková skupina má vlastní náplň – od jemné stimulace pro miminka
        po hravé překážky pro batolata. Vše v klidu a v tempu, které dítěti
        vyhovuje.
      </p>
    </header>

    <ul class="age__grid">
      {
        ageGroups.map((g, i) => (
          <li
            class="age__card reveal"
            data-accent={g.accent}
            data-variant={cardVariant(i)}
            style={`--accent: ${cardAccentVar(i, g.accent)}; transition-delay: ${i * 80}ms;`}
          >
            {i === 0 ? (
              <span class="age__new" aria-label="Novinka">
                Nově
              </span>
            ) : null}
            {g.optional ? <span class="age__optional">Dle kurzu</span> : null}
            <div class="age__icon" aria-hidden="true">
              <Icon
                name={ageIconById[g.id] ?? "emojione:monkey-face"}
                class="age__icon-graphic"
              />
            </div>
            <h3 class="age__range">{g.range}</h3>
            {/* <h3>{g.title}</h3> */}
            <div class="age__desc">
              <p>{g.description}</p>
            </div>
            <ul class="age__highlights">
              {g.highlights.map((h) => (
                <li>
                  <svg
                    viewBox="0 0 16 16"
                    width="14"
                    height="14"
                    aria-hidden="true"
                  >
                    <path
                      d="M 3 8 L 7 12 L 13 4"
                      stroke="currentColor"
                      stroke-width="2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {h}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  #vekove-skupiny {
    scroll-margin-top: -5.5rem;
  }

  .age__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }

  .age__header h2 {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    margin: 0 0 1.5rem;
  }

  .age__header h2 .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .age__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
  }

  .age__grid {
    --age-card-height: 30rem; /* menší než workshopy (34.75rem) */
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .age__card {
    position: relative;
    list-style: none;
    box-sizing: border-box;
    min-height: var(--age-card-height);
    display: flex;
    flex-direction: column;
    transition:
      transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 280ms ease,
      filter 280ms ease;
  }

  /** „Nově“ — první karta (3–6 měsíců); pill + border, horní levý roh */
  .age__new {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    z-index: 5;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    background: #fff;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    border: 2px solid
      color-mix(in srgb, var(--accent) 55%, var(--color-ink) 12%);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent),
      0 4px 14px -6px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .age__optional {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    z-index: 4;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    background: var(--color-cream);
    padding: 0.3rem 0.6rem;
    border-radius: 9999px;
  }

  .age__icon {
    width: 72px;
    height: 72px;
    background: color-mix(in srgb, var(--accent) 35%, white);
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin: 0 auto 1.25rem;
  }

  .age__icon-graphic {
    width: 2.375rem;
    height: 2.375rem;
    flex-shrink: 0;
  }

  .age__range {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 1.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--color-blush-vivid);
    line-height: 1;
    text-align: center;
  }

  /* .age__card h3 {
    font-size: 1.4rem;
    margin: 0 0 0.65rem;
  } */

  /**
   * Varianta A (viewport pod 650px): min. výška bloku popisu → stejný začátek .age__highlights v řádku mřížky
   */
  .age__desc {
    margin: 0 0 1.75rem;
    font-size: 1.125rem;
    line-height: 1.6;
    min-height: calc(4 * 1.6em);
  }

  .age__card p {
    color: color-mix(in srgb, var(--color-ink-soft) 42%, var(--color-ink) 58%);
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }

  .age__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .age__highlights li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.125rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .age__highlights svg {
    color: var(--color-blush-vivid);
    flex-shrink: 0;
  }

  /* ========== LIVE: wave (data-variant="wave") ========== */
  .age__card[data-variant="wave"] {
    border-radius: var(--radius-card);
    padding: 2rem 1.75rem;
    padding-top: 4.5rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    background: #fefefe;
    overflow: hidden;
  }

  .age__card[data-variant="wave"]::before {
    content: "";
    position: absolute;
    top: 0;
    left: -4%;
    right: -4%;
    height: 3.5rem;
    background: color-mix(in srgb, var(--accent) 38%, white);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    pointer-events: none;
  }

  .age__card[data-variant="wave"] .age__icon {
    position: relative;
    z-index: 1;
    width: 80px;
    height: 80px;
    margin: -2.85rem auto 1.25rem;
    border-radius: 999px;
    background: #fff;
    border: none;
    display: grid;
    place-items: center;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 0 0 6px color-mix(in srgb, var(--accent) 12%, white),
      0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .age__card[data-variant="wave"] .age__icon-graphic {
    width: 2.75rem;
    height: 2.75rem;
    filter: drop-shadow(
      0 3px 10px color-mix(in srgb, var(--accent) 35%, transparent)
    );
  }

  .age__card[data-variant="wave"]:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 55px -18px
      color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .age__card[data-variant="wave"]:hover .age__icon {
    transform: scale(1.05);
  }

  /* ========== LIVE: bubbles (data-variant="bubbles") ========== */
  .age__card[data-variant="bubbles"] {
    text-align: center;
    border-radius: 1.75rem;
    padding: 4.35rem 1.55rem 1.85rem;
    border: 2px solid color-mix(in srgb, var(--accent) 28%, white);
    background-color: #fffefb;
    background-image:
      radial-gradient(
        85% 70% at 8% 0%,
        color-mix(in srgb, var(--color-lilac-mid) 38%, transparent),
        transparent 58%
      ),
      radial-gradient(
        75% 65% at 100% 8%,
        color-mix(in srgb, var(--color-blush-mid) 42%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 55% at 50% 100%,
        color-mix(in srgb, var(--accent) 22%, transparent),
        transparent 52%
      ),
      linear-gradient(180deg, var(--color-cream-50) 0%, #fffefb 55%);
    box-shadow: none;
    overflow: hidden;
    isolation: isolate;
  }

  .age__card[data-variant="bubbles"] > *:not(.age__optional) {
    position: relative;
    z-index: 1;
  }

  .age__card[data-variant="bubbles"]::before {
    content: "";
    position: absolute;
    top: 0;
    left: -7%;
    right: -7%;
    height: 3.85rem;
    z-index: 0;
    background: color-mix(in srgb, var(--accent) 44%, white);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    pointer-events: none;
  }

  .age__card[data-variant="bubbles"] .age__icon-graphic {
    width: 2.75rem;
    height: 2.75rem;
    filter: drop-shadow(
      0 3px 10px color-mix(in srgb, var(--accent) 35%, transparent)
    );
  }

  .age__card[data-variant="bubbles"] .age__icon {
    width: 80px;
    height: 80px;
    margin: -2.85rem auto 1.2rem;
    border-radius: 999px;
    background: #fff;
    border: none;
    box-shadow:
      inset 0 0 0 3px color-mix(in srgb, var(--accent) 60%, white),
      0 0 0 6px color-mix(in srgb, var(--accent) 12%, white),
      0 14px 32px -10px color-mix(in srgb, var(--accent) 55%, transparent);
    transition: transform 280ms ease;
  }

  .age__card[data-variant="bubbles"] h3 {
    margin-left: auto;
    margin-right: auto;
    max-width: 20ch;
  }

  .age__card[data-variant="bubbles"] .age__desc {
    text-align: left;
    margin-bottom: 1.2rem;
  }

  .age__card[data-variant="bubbles"] .age__highlights li {
    justify-content: flex-start;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--color-cream-100) 88%, var(--accent));
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    text-align: left;
  }

  .age__card[data-variant="bubbles"] .age__highlights svg {
    color: color-mix(in srgb, var(--accent) 55%, var(--color-blush-vivid));
  }

  .age__card[data-variant="bubbles"]:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 55px -18px
      color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .age__card[data-variant="bubbles"]:hover .age__icon {
    transform: scale(1.05);
  }

  /* Kontejner: šířka jako při viewportu 416px */
  @media (min-width: 416px) and (max-width: 639px) {
    #vekove-skupiny .age__container {
      max-width: 416px;
    }
  }

  /* Grid: tablet — 2 sloupce (2+2 karty) */
  @media (min-width: 640px) and (max-width: 1179px) {
    .age__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Kontejner: šířka jako při viewportu 843px (padding 4rem od 640px v global.css) */
  @media (min-width: 843px) and (max-width: 1179px) {
    #vekove-skupiny .age__container {
      max-width: 843px;
    }
  }

  @media (min-width: 1024px) {
    .age__header h2 {
      margin: 0 0 1rem;
    }

    .age__subtitle {
      font-size: 1.0625rem;
    }
  }

  /**
   * Varianta A: od ~tabletů (2 sloupce od 640px) větší rezerva řádků
   */
  @media (min-width: 650px) {
    .age__desc {
      min-height: calc(5 * 1.6em);
    }
  }

  /* Grid: desktop — 4 karty v řádku */
  @media (min-width: 1180px) {
    .age__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .age__desc {
      font-size: 1rem;
    }

    .age__highlights li {
      font-size: 1rem;
    }
  }
</style>
