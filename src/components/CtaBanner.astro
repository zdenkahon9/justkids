---
import { site } from "../data/site";
---

<section id="rezervace" class="section cta-banner" aria-labelledby="cta-title">
  <div class="container-x">
    <div class="cta-banner__inner reveal">
      <div class="cta-banner__decor" aria-hidden="true">
        <div class="cta-balloon cta-balloon--1"></div>
        <div class="cta-balloon cta-balloon--2"></div>
        <div class="cta-balloon cta-balloon--3"></div>
      </div>

      <div class="cta-banner__copy">
        <span class="eyebrow">Připraveni?</span>
        <h2 id="cta-title">
          Pojďme si <span class="section-title-accent">zacvičit</span>
        </h2>
        <p>Místa v lekcích jsou omezená. Rezervujte si svoje včas - online během minuty.</p>
      </div>

      <div class="cta-banner__actions">
        <a
          href={site.reservationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Rezervovat lekci
          <span aria-hidden="true">→</span>
        </a>
        <a href={`mailto:${site.contact.email}`} class="btn btn-ghost">
          Napsat e-mail
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner__inner {
    position: relative;
    background: linear-gradient(135deg, #fff9f4 0%, #ffe1ed 40%, #ece1f7 80%, #d6ecfa 100%);
    border-radius: var(--radius-card);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 3.5rem);
    overflow: hidden;
    border: 2px solid white;
    box-shadow: 0 30px 80px -30px rgba(236, 47, 142, 0.3);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    text-align: center;
  }

  .cta-banner__decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-balloon {
    position: absolute;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    opacity: 0.5;
  }

  .cta-balloon--1 {
    width: 80px; height: 95px;
    background: radial-gradient(circle at 30% 30%, white, #fcc2d6);
    top: -20px; left: 12%;
    animation: float-medium 6s ease-in-out infinite;
  }
  .cta-balloon--2 {
    width: 60px; height: 72px;
    background: radial-gradient(circle at 30% 30%, white, #a9d4f0);
    bottom: -15px; right: 22%;
    animation: float-slow 8s ease-in-out infinite reverse;
  }
  .cta-balloon--3 {
    width: 50px; height: 60px;
    background: radial-gradient(circle at 30% 30%, white, #d4bff5);
    top: 30%; right: 5%;
    animation: drift 9s ease-in-out infinite;
  }

  .cta-banner__copy {
    position: relative;
    z-index: 1;
  }

  .cta-banner__copy h2 {
    font-size: clamp(2.5rem, 4.5vw, 3.2rem);
    margin: 0 0 1.5rem;
  }

  .cta-banner__copy h2 .section-title-accent {
    background: linear-gradient(90deg, #ec2f8e, #b58be0);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cta-banner__copy p {
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    margin: 0 auto;
    max-width: 32rem;
  }

  .cta-banner__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (min-width: 1024px) {
    .cta-banner__copy h2 {
      margin: 0 0 0.75rem;
    }

    .cta-banner__inner {
      grid-template-columns: 1.5fr auto;
      text-align: unset;
    }

    .cta-banner__copy p {
      margin: 0;
    }

    .cta-banner__actions {
      flex-direction: column;
      justify-content: flex-start;
    }
  }
</style>
