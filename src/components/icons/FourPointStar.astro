---
/**
 * Geometric 4-point sparkle (8 vertices): tips at N/E/S/W, valleys on diagonals.
 * Use `class` + `color` / Tailwind, or default warm yellow via CSS.
 */
interface Props {
  class?: string;
  size?: number;
  title?: string;
}

const { class: className, size = 40, title } = Astro.props;
---

<span class:list={["four-point-star-wrap", className]}>
  {
    title ? (
      <svg
        class="four-point-star"
        width={size}
        height={size}
        viewBox="0 0 100 100"
        role="img"
        aria-label={title}
      >
        <title>{title}</title>
        <path
          class="four-point-star__path"
          d="M50 2 L63 37 L98 50 L63 63 L50 98 L37 63 L2 50 L37 37 Z"
        />
      </svg>
    ) : (
      <svg
        class="four-point-star"
        width={size}
        height={size}
        viewBox="0 0 100 100"
        aria-hidden="true"
        focusable="false"
      >
        <path
          class="four-point-star__path"
          d="M50 2 L63 37 L98 50 L63 63 L50 98 L37 63 L2 50 L37 37 Z"
        />
      </svg>
    )
  }
</span>

<style>
  .four-point-star-wrap {
    display: inline-flex;
    line-height: 0;
    vertical-align: middle;
    color: #e8b923;
  }

  .four-point-star {
    flex-shrink: 0;
  }

  .four-point-star__path {
    fill: currentColor;
    filter: drop-shadow(0 1px 0 color-mix(in srgb, #b8860b 55%, transparent))
      drop-shadow(0 2px 10px color-mix(in srgb, #e8b923 50%, transparent));
  }

  @media (prefers-reduced-motion: no-preference) {
    .four-point-star-wrap {
      animation: four-point-star-drift 5s ease-in-out infinite;
    }
  }

  @keyframes four-point-star-drift {
    0%,
    100% {
      transform: rotate(-6deg) scale(1);
    }
    50% {
      transform: rotate(6deg) scale(1.04);
    }
  }
</style>
