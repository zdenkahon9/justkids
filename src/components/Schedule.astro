---
import {
  scheduleAccentSoftVar,
  scheduleLayout,
  scheduleLocations,
  scheduleMeta,
} from "../data/schedule";
import { cardAccentDeep } from "../utils/cardAccent";
import ScheduleTimetableBody from "./ScheduleTimetableBody.astro";

const meta = scheduleMeta;
const defaultLocation = scheduleLocations[0];
const cardAccent = cardAccentDeep(defaultLocation.accent);
const cardAccentSoftColor = scheduleAccentSoftVar(defaultLocation.accentSoft);

const cardStyle = (location: (typeof scheduleLocations)[number]) =>
  [
    `--accent: ${cardAccentDeep(location.accent)}`,
    `--accent-soft: ${scheduleAccentSoftVar(location.accentSoft)}`,
    `--schedule-axis-col: ${scheduleLayout.axisColumn}`,
    `--schedule-axis-width: ${scheduleLayout.axisWidth}`,
    `--schedule-dot-size: ${scheduleLayout.dotSize}`,
    `--schedule-row-height: ${scheduleLayout.rowHeight}`,
    `--schedule-time-col: ${scheduleLayout.timeColumn}`,
    `--schedule-axis-to-time-gap: ${scheduleLayout.axisToTimeGap}`,
    `--schedule-time-to-activity-gap: ${scheduleLayout.timeToActivityGap}`,
  ].join("; ");
---

<section id={meta.sectionId} class="section schedule" aria-labelledby="schedule-title">
  <div class="container-x">
    <header class="section-header reveal">
      <h2 id="schedule-title">
        {meta.title}{" "}
        <span class="section-title-accent">{meta.titleAccent}</span>
      </h2>
      <aside class="schedule__availability" aria-label="Dostupnost kurzů">
        <p class="schedule__availability-copy">
          <span class="schedule__availability-lead">Ještě se k nám můžete přidat</span>{
            " "
          }
          <span class="schedule__availability-detail">– zbývá pár volných míst.</span>
        </p>
        <ul class="schedule__availability-legend" aria-label="Význam dostupnosti lekcí">
          <li class="schedule__availability-item schedule__availability-item--full">
            <span
              class="schedule__availability-dot schedule__availability-dot--full"
              aria-hidden="true"></span>
            <span>Obsazeno</span>
          </li>
          <li class="schedule__availability-item schedule__availability-item--last-spots">
            <span
              class="schedule__availability-dot schedule__availability-dot--last-spots"
              aria-hidden="true"></span>
            <span>Poslední místa</span>
          </li>
        </ul>
      </aside>
    </header>

    <div class="schedule__panel schedule__panel--mobile reveal">
      <article
        class="schedule__card"
        style={`--accent: ${cardAccent}; --accent-soft: ${cardAccentSoftColor}; --schedule-axis-col: ${scheduleLayout.axisColumn}; --schedule-axis-width: ${scheduleLayout.axisWidth}; --schedule-dot-size: ${scheduleLayout.dotSize}; --schedule-row-height: ${scheduleLayout.rowHeight}; --schedule-time-col: ${scheduleLayout.timeColumn}; --schedule-axis-to-time-gap: ${scheduleLayout.axisToTimeGap}; --schedule-time-to-activity-gap: ${scheduleLayout.timeToActivityGap};`}
      >
        <div
          class="schedule__pill schedule__pill--split"
          role="tablist"
          aria-label="Vybrat pobočku"
          aria-orientation="horizontal"
        >
          {
            scheduleLocations.map((location, index) => (
              <button
                type="button"
                id={`schedule-location-tab-${location.id}`}
                class:list={[
                  "schedule__pill-third",
                  location.accentClass,
                  { "is-active": index === 0 },
                ]}
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`schedule-location-panel-${location.id}`}
                tabindex={index === 0 ? 0 : -1}
                data-location={location.id}
                data-accent={cardAccentDeep(location.accent)}
                data-accent-soft={scheduleAccentSoftVar(location.accentSoft)}
                style={`--accent: ${cardAccentDeep(location.accent)}; --accent-soft: ${scheduleAccentSoftVar(location.accentSoft)}`}
              >
                {location.label}
              </button>
            ))
          }
        </div>
        <span class="age-page__rule" aria-hidden="true"></span>

        <div class="schedule__body">
          {
            scheduleLocations.map((location, index) => (
              <div
                id={`schedule-location-panel-${location.id}`}
                class="schedule__timetable"
                role="tabpanel"
                aria-labelledby={`schedule-location-tab-${location.id}`}
                data-location={location.id}
                hidden={index !== 0}
              >
                <ScheduleTimetableBody location={location} />
              </div>
            ))
          }
        </div>
      </article>
      <noscript>
        <style>
          .schedule__panel--mobile .schedule__pill,
          .schedule__panel--mobile .schedule__card > .age-page__rule {
            display: none !important;
          }

          .schedule__panel--mobile .schedule__timetable[hidden] {
            display: block !important;
          }

          .schedule__panel--mobile .schedule__timetable + .schedule__timetable {
            margin-top: var(--space-14);
            padding-top: var(--space-14);
            border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
          }
        </style>
      </noscript>
    </div>

    <div class="schedule__grid schedule__grid--desktop reveal">
      {
        scheduleLocations.map((location) => (
          <article class="schedule__card" style={cardStyle(location)}>
            <div
              class:list={[
                "schedule__card-tab",
                location.accentClass.replace(
                  "schedule__pill-third",
                  "schedule__card-tab",
                ),
              ]}
            >
              {location.label}
            </div>
            <span class="age-page__rule" aria-hidden="true" />
            <ScheduleTimetableBody location={location} />
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .schedule {
    scroll-margin-top: var(--section-scroll-margin);
    background-color: var(--color-cream);
  }

  .schedule .section-title-accent {
    color: var(--color-lilac-deep);
  }

  .schedule__panel--mobile {
    width: min(100%, var(--card-grid-width));
    margin: 0 auto;
  }

  .schedule__grid--desktop {
    display: none;
  }

  .schedule__availability {
    display: block;
    text-align: center;
  }

  .schedule__availability-copy {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: var(--line-height-base);
  }

  .schedule__availability-lead {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .schedule__availability-detail {
    font-weight: 400;
  }

  .schedule__availability-legend {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--line-height-base);
  }

  .schedule__availability-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: calc(var(--radius-pill) + var(--space-4));
    white-space: nowrap;
  }

  .schedule__availability-item--full {
    background: var(--color-status-full-soft);
  }

  .schedule__availability-item--last-spots {
    background: var(--color-status-last-spots-soft);
  }

  .schedule__availability-dot {
    flex: 0 0 var(--space-8);
    width: var(--space-8);
    height: var(--space-8);
    border-radius: 50%;
  }

  .schedule__availability-dot--full {
    background: var(--color-status-full);
  }

  .schedule__availability-dot--last-spots {
    background: var(--color-status-last-spots);
  }

  .schedule__pill {
    display: flex;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--radius-pill);
    border: 1.5px solid rgba(42, 31, 56, 0.12);
    background: transparent;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    line-height: var(--line-height-base);
    white-space: nowrap;
    padding: 0;
    min-height: calc(2rem + 1em * var(--line-height-base));
  }

  .schedule__pill--split {
    align-items: stretch;
  }

  .schedule__pill-third {
    flex: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: var(--space-8) 0;
    border: none;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-weight: 500;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .schedule__pill-third.is-active {
    font-weight: 600;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .schedule__pill-third:not(.is-active):hover,
  .schedule__pill-third:not(.is-active):focus-visible {
    background: color-mix(in srgb, var(--color-ink) 4%, #fefefe);
    outline: none;
  }

  .schedule__card {
    position: relative;
    display: block;
    box-sizing: border-box;
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    border: var(--card-border);
    background: #fefefe;
    box-shadow: none;
    overflow: hidden;
  }

  .schedule__panel--mobile .schedule__card > .age-page__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-10);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
    transition: background 220ms ease;
  }

  .schedule__body {
    position: relative;
    z-index: 1;
  }

  .schedule__timetable[hidden] {
    display: none;
  }

  .schedule__card-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: calc(2rem + 1em * var(--line-height-base));
    padding: var(--space-8) 0;
    border-radius: var(--radius-pill);
    border: 1.5px solid rgba(42, 31, 56, 0.12);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--line-height-base);
    text-align: center;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .schedule__grid--desktop .schedule__card > .age-page__rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-10) 0 var(--space-10);
    border: none;
    background: color-mix(in srgb, var(--accent) 30%, var(--color-ink) 8%);
  }

  @media (min-width: 768px) {
    .schedule__panel--mobile {
      width: min(100%, calc(2 * var(--card-grid-width-md) + var(--stack-gap)));
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .schedule__panel--mobile .schedule__card {
      --schedule-row-height: 3.125rem !important;
      --schedule-axis-to-time-gap: var(--space-6) !important;
      --schedule-time-to-activity-gap: var(--space-8) !important;
      padding: var(--space-17) var(--space-18);
    }

    .schedule__pill-third {
      min-height: calc(2.25rem + 1em * var(--line-height-base));
      padding: var(--space-9) 0;
      font-size: var(--text-lg);
    }

    .schedule__panel--mobile .schedule__card > .age-page__rule {
      margin: var(--space-12) 0;
    }

    .schedule__panel--mobile :global(.schedule__slots) {
      gap: var(--space-6);
    }

    .schedule__panel--mobile :global(.schedule__day-divider) {
      margin: var(--space-12) 0;
    }

    .schedule__panel--mobile .schedule__timetable[data-location="zdice"]:not([hidden]) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-14);
      align-items: start;
    }

    .schedule__panel--mobile
      .schedule__timetable[data-location="zdice"]:not([hidden])
      > :global(.schedule__day-block)
      :global(.schedule__day-divider) {
      display: none;
    }

    .schedule__panel--mobile
      .schedule__timetable[data-location="zdice"]:not([hidden])
      > :global(.schedule__venue) {
      grid-column: 1 / -1;
    }

    .schedule__panel--mobile :global(.schedule__venue) {
      margin-top: var(--space-12);
      padding: var(--space-9) var(--space-14);
    }
  }

  @media (min-width: 1024px) {
    .schedule__panel--mobile {
      display: none;
    }

    .schedule__grid--desktop {
      display: grid;
      /* grid-template-columns: repeat(3, minmax(0, 1fr)); */
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
      width: min(100%, calc(2 * var(--card-grid-width) + var(--space-8)));
      margin: 0 auto;
    }

    .schedule__grid--desktop .schedule__card:nth-child(2) :global(.schedule__day-block),
    .schedule__grid--desktop .schedule__card:nth-child(3) :global(.schedule__day-block) {
      display: flex;
      flex-direction: column;
    }

    /* Volný prostor pod sloty — timeline (a osa) zůstane jen u bodů */
    .schedule__grid--desktop
      .schedule__card:nth-child(3)
      :global(.schedule__day-block)::after {
      content: "";
      flex: 1 1 auto;
    }

    .schedule__card-tab {
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 1024px) and (max-width: 1179px) {
    .schedule__grid--desktop .schedule__card {
      --schedule-time-to-activity-gap: 10px !important;
    }
  }
</style>

<script>
  const setupSchedulePill = () => {
    const pill = document.querySelector<HTMLElement>(
      ".schedule__panel--mobile .schedule__pill--split",
    );
    if (!pill || pill.dataset.pillReady === "true") return;
    pill.dataset.pillReady = "true";

    const card = pill.closest<HTMLElement>(".schedule__card");
    const timetables = card?.querySelectorAll<HTMLElement>(".schedule__timetable");
    const buttons = pill.querySelectorAll<HTMLButtonElement>(".schedule__pill-third");

    const setActive = (button: HTMLButtonElement, moveFocus = false) => {
      buttons.forEach((item) => {
        const isSelected = item === button;
        item.classList.remove("is-active");
        item.setAttribute("aria-selected", String(isSelected));
        item.tabIndex = isSelected ? 0 : -1;
      });

      button.classList.add("is-active");
      button.setAttribute("aria-selected", "true");

      const accent = button.dataset.accent;
      const accentSoft = button.dataset.accentSoft;
      if (card && accent) {
        card.style.setProperty("--accent", accent);
      }
      if (card && accentSoft) {
        card.style.setProperty("--accent-soft", accentSoft);
      }

      const locationId = button.dataset.location;
      timetables?.forEach((panel) => {
        panel.hidden = panel.dataset.location !== locationId;
      });

      if (moveFocus) button.focus();
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => setActive(button));
      button.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight") nextIndex = (index + 1) % buttons.length;
        if (event.key === "ArrowLeft") {
          nextIndex = (index - 1 + buttons.length) % buttons.length;
        }
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = buttons.length - 1;

        if (nextIndex === undefined) return;
        event.preventDefault();
        setActive(buttons[nextIndex], true);
      });
    });

    const selectedButton = Array.from(buttons).find(
      (button) => button.getAttribute("aria-selected") === "true",
    );
    if (selectedButton) setActive(selectedButton);
  };

  setupSchedulePill();
  document.addEventListener("astro:page-load", setupSchedulePill);

  const SCHEDULE_DESKTOP_MQ = "(min-width: 1024px)";

  const syncScheduleHoroviceBroumyDayBlocks = () => {
    const grid = document.querySelector<HTMLElement>(".schedule__grid--desktop");
    if (!grid) return;

    const horoviceDay = grid.querySelector<HTMLElement>(
      ".schedule__card:nth-child(2) .schedule__day-block",
    );
    const broumyDay = grid.querySelector<HTMLElement>(
      ".schedule__card:nth-child(3) .schedule__day-block",
    );

    if (!horoviceDay || !broumyDay) return;

    broumyDay.style.minHeight = "";

    if (!window.matchMedia(SCHEDULE_DESKTOP_MQ).matches) return;
    if (getComputedStyle(grid).display === "none") return;

    broumyDay.style.minHeight = `${horoviceDay.getBoundingClientRect().height}px`;
  };

  const setupScheduleDayBlockSync = () => {
    const grid = document.querySelector<HTMLElement>(".schedule__grid--desktop");
    if (!grid || grid.dataset.dayBlockSyncReady === "true") return;
    grid.dataset.dayBlockSyncReady = "true";

    const run = () => {
      requestAnimationFrame(syncScheduleHoroviceBroumyDayBlocks);
    };

    run();
    window.addEventListener("resize", run, { passive: true });
    document.fonts?.ready.then(run);

    const horoviceDay = grid.querySelector<HTMLElement>(
      ".schedule__card:nth-child(2) .schedule__day-block",
    );
    if (horoviceDay) {
      const observer = new ResizeObserver(run);
      observer.observe(horoviceDay);
    }
  };

  setupScheduleDayBlockSync();
  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector<HTMLElement>(".schedule__grid--desktop");
    if (grid) delete grid.dataset.dayBlockSyncReady;
    setupScheduleDayBlockSync();
  });
</script>
