---
import About from "../components/About.astro";
import AgeGroupsHome from "../components/AgeGroupsHome.astro";
import Camps from "../components/Camps.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Locations from "../components/Locations.astro";
import Navbar from "../components/Navbar.astro";
import ReviewsHome from "../components/ReviewsHome.astro";
import Rules from "../components/Rules.astro";
import WorkshopsHome from "../components/WorkshopsHome.astro";
import { pageSeo } from "../config/seo";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const navLinks = [
  { href: "#o-mne", label: "O mně" },
  { href: "#vekove-kategorie", label: "Cvičení pro děti" },
  { href: "#workshopy", label: "Další akce" },
  { href: "#provozni-rad", label: "Provozní řád" },
  { href: "#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "#kempy", label: "Kempy & výjezdy" },
  { href: "/recenze", label: "Recenze" },
  { href: "#provozni-rad", label: "Provozní řád" },
  { href: "#kontakt", label: "Kontakt" },
];
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <Navbar
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.signupFormUrl}
    brand={site.name}
  />

  <main id="main">
    <Hero />
    <About />
    <AgeGroupsHome />
    <Locations />
    <WorkshopsHome />
    <Camps />
    <ReviewsHome />
    <Rules />
  </main>

  <Footer />
</BaseLayout>
