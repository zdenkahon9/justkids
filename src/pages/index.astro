---
import About from "../components/About.astro";
import AgeGroupsHome from "../components/AgeGroupsHome.astro";
import Camps from "../components/Camps.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Locations from "../components/Locations.astro";
import Navbar from "../components/Navbar.astro";
import ReviewsHome from "../components/ReviewsHome.astro";
import Rules from "../components/Rules.astro";
import WorkshopsHome from "../components/WorkshopsHome.astro";
import { NAV_LINKS } from "../config/routes";
import { pageSeo } from "../config/seo";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <Navbar
    links={NAV_LINKS.primary}
    mobileLinks={NAV_LINKS.mobile}
    reservationUrl={site.signupFormUrl}
    brand={site.name}
  />

  <main id="main">
    <Hero />
    <About />
    <AgeGroupsHome />
    <Locations />
    <WorkshopsHome />
    <Camps />
    <ReviewsHome />
    <Rules />
  </main>

  <Footer />
</BaseLayout>
