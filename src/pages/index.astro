---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import AgeGroups from "../components/AgeGroups.astro";
import Locations from "../components/Locations.astro";
import Workshops from "../components/Workshops.astro";
import Camps from "../components/Camps.astro";
import Reviews from "../components/Reviews.astro";
import Rules from "../components/Rules.astro";
import Footer from "../components/Footer.astro";

import Navbar from "../components/Navbar.tsx";
import { site } from "../data/site";

const navLinks = [
  { href: "#o-mne", label: "O mně" },
  { href: "#vekove-skupiny", label: "Věkové kategorie" },
  { href: "#lokace", label: "Kde cvičíme" },
  { href: "#workshopy", label: "Workshopy" },
  { href: "#kempy", label: "Kempy" },
  { href: "#provozni-rad", label: "Provozní řád" },
  { href: "#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "#o-mne", label: "O mně" },
  { href: "#vekove-skupiny", label: "Věkové kategorie" },
  { href: "#lokace", label: "Kde cvičíme" },
  { href: "#workshopy", label: "Workshopy" },
  { href: "#kempy", label: "Kempy & výjezdy" },
  { href: "#recenze", label: "Recenze" },
  { href: "#provozni-rad", label: "Provozní řád" },
  { href: "#kontakt", label: "Kontakt" },
];
---

<BaseLayout>
  <Navbar
    client:load
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.reservationUrl}
    logoSrc="/images/logo.png"
    brand={site.name}
  />

  <main id="main">
    <Hero />
    <About />
    <AgeGroups />
    <Locations />
    <Workshops />
    <Camps />
    <Reviews />
    <Rules />
  </main>

  <Footer />
</BaseLayout>
