---
import { Image } from "astro:assets";

import heroBoy from "../assets/images/hero-boy.png";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { NAV_LINKS, ROUTE_IDS, ROUTES } from "../config/routes";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Stránka nenalezena"
  description="Požadovanou stránku se nepodařilo najít. Vraťte se na hlavní stránku JustKids."
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <Navbar
    links={NAV_LINKS.primary}
    mobileLinks={NAV_LINKS.mobile}
    reservationUrl={site.signupFormUrl}
    brand={site.name}
    logoHref={ROUTES.home._}
    variant="solid"
  />

  <main id="main">
    <section id={ROUTE_IDS.home.hero} class="not-found" aria-labelledby="not-found-title">
      <div class="container-x not-found__inner">
        <div class="not-found__copy">
          <p class="eyebrow">404 · Stránka nenalezena</p>
          <h1 id="not-found-title">
            Jejda!<br />
            tudy cesta<br />
            <span>nevede.</span>
          </h1>
          <p class="not-found__lead">
            Tuhle stránku se nám nepodařilo najít. Možná byla přesunuta nebo už
            neexistuje.
          </p>

          <div class="not-found__actions">
            <a href={ROUTES.home._} class="btn btn-primary">
              <span aria-hidden="true">←</span>
              Zpátky domů
            </a>
          </div>
        </div>

        <div class="not-found__visual" aria-hidden="true">
          <div class="not-found__number">
            <span>4</span><span>0</span><span>4</span>
          </div>
          <div class="not-found__sun"></div>
          <Image
            src={heroBoy}
            alt=""
            class="not-found__hero"
            widths={[320, 480, 623]}
            sizes="(min-width: 900px) 34rem, 88vw"
            format="webp"
            priority
          />
        </div>
      </div>

      <div class="not-found__wave" aria-hidden="true">
        <svg
          class="not-found__wave-svg"
          viewBox="0 0 1440 100"
          preserveAspectRatio="xMidYMax meet"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill="var(--color-cream)"
            d="M0,51 C180,51 340,68 540,68 C720,68 820,51 920,51 C1080,51 1240,81 1440,85 L1440,100 L0,100 Z"
          ></path>
        </svg>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .not-found {
    --not-found-wave-h: max(2.75rem, calc(100svw * 100 / 1440));
    --not-found-wave-mobile-lift: 0.75rem;
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-height-scrolled) + var(--space-18)) 0 var(--space-21);
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 12% 28%, rgba(252, 194, 214, 0.62), transparent 27%),
      radial-gradient(circle at 88% 22%, rgba(169, 212, 240, 0.58), transparent 28%),
      radial-gradient(circle at 72% 82%, rgba(212, 191, 245, 0.54), transparent 31%),
      linear-gradient(145deg, #fff9f4 12%, #fff0e6 52%, #f8edff 100%);
    background-color: var(--color-cream);
  }

  .not-found::after {
    content: "";
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: -1px;
    left: 0;
    height: calc(var(--not-found-wave-mobile-lift) + 2px);
    background: var(--color-cream);
    pointer-events: none;
  }

  .not-found__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-17);
  }

  .not-found__copy {
    max-width: 40rem;
    text-align: center;
    margin-inline: auto;
    animation: copy-in 700ms 80ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .not-found__copy .eyebrow {
    margin-bottom: var(--space-8);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .not-found h1 {
    max-width: 12ch;
    margin: 0 auto var(--space-12);
    font-size: clamp(3rem, 12vw, 5.6rem);
    line-height: 0.96;
    text-wrap: balance;
  }

  .not-found h1 span {
    position: relative;
    color: var(--color-blush-vivid);
    white-space: nowrap;
  }

  .not-found__lead {
    max-width: 37rem;
    margin: 0 auto;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-8);
    margin-top: var(--space-15);
  }

  .not-found__visual {
    position: relative;
    width: min(100%, 36rem);
    aspect-ratio: 1.15;
    justify-self: center;
    animation: visual-in 900ms 180ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .not-found__number {
    position: absolute;
    inset: 3% 0 auto;
    display: flex;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 1rem);
    font-family: var(--font-display);
    font-size: clamp(8rem, 39vw, 15rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.08em;
    color: rgba(255, 255, 255, 0.84);
    text-shadow:
      0 18px 45px rgba(154, 111, 196, 0.16),
      0 0 0.06em rgba(236, 47, 142, 0.16);
    user-select: none;
  }

  .not-found__sun {
    position: absolute;
    top: 15%;
    left: 50%;
    width: 42%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--color-apricot-mid), var(--color-blush-mid));
    transform: translateX(-50%);
    box-shadow:
      0 0 0 1.2rem rgba(255, 255, 255, 0.3),
      0 20px 60px rgba(232, 148, 58, 0.18);
  }

  .not-found__hero {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 0;
    width: 66%;
    height: 92%;
    object-fit: contain;
    object-position: center bottom;
    transform: translateX(-50%);
    filter: drop-shadow(0 22px 18px rgba(42, 31, 56, 0.2));
  }

  .not-found__wave {
    position: absolute;
    right: 0;
    bottom: var(--not-found-wave-mobile-lift);
    left: 0;
    z-index: 1;
    line-height: 0;
    pointer-events: none;
  }

  .not-found__wave-svg {
    display: block;
    width: 100%;
    height: var(--not-found-wave-h);
  }

  :global(.footer) {
    margin-top: 0 !important;
  }

  @keyframes copy-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes visual-in {
    from {
      opacity: 0;
      transform: translateY(2rem) scale(0.96);
    }
  }

  @media (max-width: 420px) {
    .not-found__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .not-found__actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .not-found {
      padding-top: calc(var(--nav-height-scrolled) + var(--space-20));
    }

    .not-found__inner {
      grid-template-columns: minmax(0, 1fr) minmax(28rem, 0.9fr);
      gap: var(--space-18);
    }

    .not-found__copy {
      text-align: left;
      margin-inline: 0;
    }

    .not-found h1,
    .not-found__lead {
      margin-inline: 0;
    }

    .not-found h1 {
      font-size: clamp(4.5rem, 7vw, 6.5rem);
    }

    .not-found__actions {
      justify-content: flex-start;
    }

    .not-found__number {
      font-size: clamp(12rem, 18vw, 16rem);
    }
  }

  @media (min-width: 1024px) {
    .not-found::after {
      content: none;
      display: none;
    }

    .not-found__wave {
      bottom: 0;
    }
  }
</style>
