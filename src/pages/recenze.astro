---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.tsx";
import FacebookIcon from "../components/FacebookIcon.astro";
import Icon from "astro-iconify";
import { reviews } from "../data/reviews";
import { site } from "../data/site";
import { splitReviewText } from "../utils/splitReviewText";

const pageTitle = `Recenze od rodičů | ${site.name}`;
const pageDescription =
  "Skutečné zkušenosti rodičů, kteří s námi absolvovali lekce cvičení a plavání.";
const canonical = `${site.url}/recenze`;

const navLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/#workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/#workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy & výjezdy" },
  { href: "/#recenze", label: "Recenze" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>
  <Navbar
    client:load
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.reservationUrl}
    logoSrc="/images/logo.png"
    brand={site.name}
    logoHref="/"
  />

  <main id="main">
    <section class="section reviews-page" aria-labelledby="reviews-page-title">
      <div class="reviews-page__intro">
        <div class="reviews-page__intro-nav-bg" aria-hidden="true">
          <div class="reviews-page__intro-photo"></div>
          <div class="reviews-page__intro-veil"></div>
        </div>
        <div class="container-x reviews-page__intro-inner">
          <header class="section-header reveal">
            <h1 id="reviews-page-title">
              Recenze <span class="section-title-accent">od rodičů</span>
            </h1>
            <p class="section-subtitle">
              Přečtěte si, co o nás napsali rodiče na našem <a
                href={site.social.facebookReviews}
                target="_blank"
                rel="noopener noreferrer"
                class="section-subtitle__fb-group"
                aria-label="Recenze na Facebooku"
              >
                Facebooku<span class="section-subtitle__fb" aria-hidden="true">
                  <FacebookIcon />
                </span>
              </a>
            </p>
          </header>
        </div>
      </div>

      <div class="container-x reviews-page__inner">
        <div class="about__divider reveal">
          <span aria-hidden="true">
            <Icon name="twemoji:pink-heart" class="about__divider-icon" />
            <Icon name="twemoji:pink-heart" class="about__divider-icon" />
            <Icon name="twemoji:pink-heart" class="about__divider-icon" />
          </span>
        </div>

        <ol class="reviews-page__list" role="list">
          {
            reviews.map((r, i) => (
              <li
                class="reviews-page__item reveal"
                style={`transition-delay: ${Math.min(i, 6) * 70}ms;`}
              >
                {r.rating && (
                  <div
                    class="reviews-page__stars"
                    aria-label={`Hodnocení ${r.rating} z 5`}
                  >
                    {Array.from({ length: 5 }, (_, k) => (
                      <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        class={k < (r.rating ?? 0) ? "is-on" : ""}
                      >
                        <path
                          d="M 12 2 L 14.5 8.5 L 21 9 L 16 13.5 L 17.5 20 L 12 16.5 L 6.5 20 L 8 13.5 L 3 9 L 9.5 8.5 Z"
                          fill="currentColor"
                        />
                      </svg>
                    ))}
                  </div>
                )}

                <blockquote class="reviews-page__text">
                  {splitReviewText(r.text).map((part) =>
                    part.emoji ? (
                      <span class="reviews-page__emoji">{part.value}</span>
                    ) : (
                      part.value
                    ),
                  )}
                </blockquote>
              </li>
            ))
          }
        </ol>

        <div class="reviews-page__footer reveal">
          <a class="btn btn-ghost reviews-page__back-btn" href="/#recenze">
            <span aria-hidden="true">←</span> Zpět na úvod
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .reviews-page {
    --accent: var(--color-blush-deep);
    padding-top: 0;
    scroll-margin-top: var(--nav-height);
    background-color: var(--color-cream);
  }

  /* Mini page-hero — pod navbarom stejná vrstva jako na AgeGroupsPage */
  .reviews-page__intro {
    position: relative;
    background-color: var(--color-cream);
  }

  .reviews-page__intro-nav-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .reviews-page__intro-photo {
    position: absolute;
    left: -3%;
    right: -3%;
    top: -3svh;
    height: 106svh;
    background-image: url("/images/hero-balloons.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(5px) saturate(1.05);
    transform: scale(1.06);
    transform-origin: center top;
  }

  .reviews-page__intro-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 100svh;
    background:
      radial-gradient(
        48% 42% at 22% 32%,
        rgba(212, 191, 245, 0.55) 0%,
        rgba(212, 191, 245, 0) 70%
      ),
      radial-gradient(
        40% 40% at 30% 55%,
        rgba(252, 194, 214, 0.55) 0%,
        rgba(252, 194, 214, 0) 70%
      ),
      radial-gradient(
        55% 55% at 82% 30%,
        rgba(169, 212, 240, 0.4) 0%,
        rgba(169, 212, 240, 0) 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 249, 244, 0.2) 0%,
        rgba(255, 249, 244, 0.05) 35%,
        rgba(255, 249, 244, 0.55) 72%,
        rgba(255, 249, 244, 0.95) 100%
      );
  }

  .reviews-page__intro-inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-height) + var(--section-header-spacing));
  }

  .reviews-page__intro .section-header {
    margin-bottom: var(--section-header-spacing);
  }

  /* Editorial reading column — narrow + centered for comfortable mobile reading */
  .reviews-page__inner {
    max-width: 44rem;
  }

  .reviews-page .section-title-accent {
    color: var(--color-blush-vivid);
  }

  .section-subtitle__fb-group {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .section-subtitle__fb-group:hover {
    color: #1877f2;
  }

  .section-subtitle__fb {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: #1877f2;
  }

  .section-subtitle__fb :global(svg) {
    width: 1.15em;
    height: 1.15em;
  }

  .reviews-page .section-header h1 {
    font-size: var(--text-clamp-h2);
    margin: 0 0 var(--h2-title-gap);
  }

  .about__divider {
    position: relative;
    margin: 1.5rem 0 3rem;
    height: 1px;
    background: var(--color-blush-mid);
  }

  .about__divider span {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-cream);
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .about__divider-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  /* Editorial list — vertical rhythm + subtle dividers, no cards */
  .reviews-page__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .reviews-page__item {
    padding-block: var(--space-9);
  }

  .reviews-page__item:first-child {
    padding-top: 0;
  }

  .reviews-page__item:last-child {
    padding-bottom: var(--space-6);
  }

  /* Stejná barva oddělovače jako age-page__rule (např. první karta Locations) */
  .reviews-page__item + .reviews-page__item {
    border-top: 1px solid
      color-mix(in srgb, var(--accent) 16%, var(--color-ink) 4%);
  }

  /* Same star styling as the homepage review cards */
  .reviews-page__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-ink);
  }

  .reviews-page__stars svg {
    width: 1em;
    height: 1em;
    color: rgba(42, 31, 56, 0.15);
  }

  .reviews-page__stars svg.is-on {
    color: #f5b400;
  }

  /* Full-length review text — never truncated, preserves line breaks */
  .reviews-page__text {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-style: italic;
    line-height: var(--line-height-base);
    white-space: pre-line;
    word-break: break-word;
  }

  .reviews-page__emoji {
    font-style: normal;
  }

  .reviews-page__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-10);
  }

  @media (min-width: 768px) {
    .reviews-page__text {
      font-size: var(--text-xl);
    }
  }
</style>
