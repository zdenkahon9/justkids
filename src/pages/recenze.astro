---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import ReviewsPage from "../components/ReviewsPage.astro";
import { pageSeo } from "../config/seo";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const navLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/#vekove-kategorie", label: "Cvičení pro děti" },
  { href: "/#workshopy", label: "Další akce" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy & výjezdy" },
  { href: "/recenze", label: "Recenze" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];
---

<BaseLayout title={pageSeo.reviews.title} description={pageSeo.reviews.description}>
  <Navbar
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.signupFormUrl}
    brand={site.name}
    logoHref="/"
  />

  <main id="main">
    <ReviewsPage />
  </main>

  <Footer />
</BaseLayout>
