---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.tsx";
import ReviewsPage from "../components/ReviewsPage.astro";
import { reviewsPageMeta } from "../data/reviews";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = `${reviewsPageMeta.title} ${reviewsPageMeta.titleAccent} | ${site.name}`;
const pageDescription = reviewsPageMeta.pageDescription;
const canonical = `${site.url}/recenze`;

const navLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/#vekove-kategorie", label: "Cvičení pro děti" },
  { href: "/#workshopy", label: "Další akce" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy & výjezdy" },
  { href: "/recenze", label: "Recenze" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <Navbar
    client:load
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.signupFormUrl}
    logoSrc="/images/logo.png"
    brand={site.name}
    logoHref="/"
  />

  <main id="main">
    <ReviewsPage />
  </main>

  <Footer />
</BaseLayout>
