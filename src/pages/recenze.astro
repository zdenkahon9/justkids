---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import ReviewsPage from "../components/ReviewsPage.astro";
import { NAV_LINKS } from "../config/routes";
import { pageSeo } from "../config/seo";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={pageSeo.reviews.title} description={pageSeo.reviews.description}>
  <Navbar
    links={NAV_LINKS.primary}
    mobileLinks={NAV_LINKS.mobile}
    reservationUrl={site.signupFormUrl}
    brand={site.name}
  />

  <main id="main">
    <ReviewsPage />
  </main>

  <Footer />
</BaseLayout>
