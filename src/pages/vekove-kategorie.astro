---
import AgeGroupsPage from "../components/AgeGroupsPage.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.tsx";
import Schedule from "../components/Schedule.astro";
import { ageGroupsPageMeta } from "../data/ageGroupsPage";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = `${ageGroupsPageMeta.eyebrow} | ${site.name}`;
const pageDescription = ageGroupsPageMeta.pageDescription;
const canonical = `${site.url}/vekove-kategorie`;

const navLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/#vekove-kategorie", label: "Cvičení pro děti" },
  { href: "/#workshopy", label: "Další akce" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy & výjezdy" },
  { href: "/recenze", label: "Recenze" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <script slot="head" is:inline define:vars={{ scrollKey: "age-home-scroll" }}>
    if (
      window.matchMedia("(min-width: 1024px)").matches &&
      sessionStorage.getItem(scrollKey)
    ) {
      document.documentElement.dataset.ageHomeArrival = "true";
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    }
  </script>
  <style slot="head" is:inline>
    html[data-age-home-arrival] {
      visibility: hidden;
      background-color: #fff9f4;
    }
  </style>

  <Navbar
    client:load
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.signupFormUrl}
    logoSrc="/images/logo.png"
    brand={site.name}
    logoHref="/"
  />

  <main id="main">
    <AgeGroupsPage />
    <Schedule />
  </main>

  <script
    is:inline
    define:vars={{
      scrollKey: "age-home-scroll",
      arrivalAttr: "ageHomeArrival",
    }}
  >
    (function () {
      if (!window.matchMedia("(min-width: 1024px)").matches) return;

      var targetId = sessionStorage.getItem(scrollKey);
      if (!targetId) return;

      var reveal = function () {
        delete document.documentElement.dataset[arrivalAttr];
      };

      var runScroll = function () {
        var agePage = document.querySelector(".age-page");
        var target = document.getElementById(targetId);
        if (!agePage || !target) return false;

        var offsetEl =
          targetId === "s-rodici"
            ? agePage.querySelector(".age-page__pill-half--with-parents")
            : agePage.querySelector(".age-page__pill-half--without-parents");
        if (!offsetEl) return false;

        var probe = document.createElement("div");
        probe.style.position = "absolute";
        probe.style.visibility = "hidden";
        probe.style.pointerEvents = "none";
        probe.style.height = "var(--age-page-pill-scroll-offset)";
        offsetEl.appendChild(probe);
        var offset = probe.getBoundingClientRect().height;
        probe.remove();

        var top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo(0, top);
        history.replaceState(null, "", "#" + targetId);
        return true;
      };

      var finish = function () {
        sessionStorage.removeItem(scrollKey);
        reveal();
      };

      document.fonts.ready.then(function () {
        runScroll();
        requestAnimationFrame(function () {
          runScroll();
          finish();
        });
      });
    })();
  </script>

  <Footer />
</BaseLayout>
