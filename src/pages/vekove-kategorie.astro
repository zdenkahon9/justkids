---
import AgeGroupsPage from "../components/AgeGroupsPage.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Pricing from "../components/Pricing.astro";
import Schedule from "../components/Schedule.astro";
import { NAV_LINKS, ROUTE_IDS } from "../config/routes";
import { pageSeo } from "../config/seo";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={pageSeo.ageGroups.title} description={pageSeo.ageGroups.description}>
  <script slot="head" is:inline define:vars={{ scrollKey: "age-home-scroll" }}>
    if (
      window.matchMedia("(min-width: 1024px)").matches &&
      sessionStorage.getItem(scrollKey)
    ) {
      document.documentElement.dataset.ageHomeArrival = "true";
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    }
  </script>
  <style slot="head" is:inline>
    html[data-age-home-arrival] {
      visibility: hidden;
      background-color: #fff9f4;
    }
  </style>

  <Navbar
    links={NAV_LINKS.primary}
    mobileLinks={NAV_LINKS.mobile}
    reservationUrl={site.signupFormUrl}
    brand={site.name}
  />

  <main id="main">
    <AgeGroupsPage />
    <Schedule />
    <Pricing />
  </main>

  <script
    is:inline
    define:vars={{
      scrollKey: "age-home-scroll",
      arrivalAttr: "ageHomeArrival",
      withParentsId: ROUTE_IDS.ageGroups.withParents,
    }}
  >
    (function () {
      if (!window.matchMedia("(min-width: 1024px)").matches) return;

      const targetId = sessionStorage.getItem(scrollKey);
      if (!targetId) return;

      const reveal = function () {
        delete document.documentElement.dataset[arrivalAttr];
      };

      const runScroll = function () {
        const agePage = document.querySelector(".age-page");
        const target = document.getElementById(targetId);
        if (!agePage || !target) return false;

        const offsetEl =
          targetId === withParentsId
            ? agePage.querySelector(".age-page__pill-half--with-parents")
            : agePage.querySelector(".age-page__pill-half--without-parents");
        if (!offsetEl) return false;

        const probe = document.createElement("div");
        probe.style.position = "absolute";
        probe.style.visibility = "hidden";
        probe.style.pointerEvents = "none";
        probe.style.height = "var(--age-page-pill-scroll-offset)";
        offsetEl.appendChild(probe);
        const offset = probe.getBoundingClientRect().height;
        probe.remove();

        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo(0, top);
        history.replaceState(null, "", "#" + targetId);
        return true;
      };

      const finish = function () {
        sessionStorage.removeItem(scrollKey);
        reveal();
      };

      document.fonts.ready.then(function () {
        runScroll();
        requestAnimationFrame(function () {
          runScroll();
          finish();
        });
      });
    })();
  </script>

  <Footer />
</BaseLayout>
