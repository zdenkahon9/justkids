---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.tsx";
import WorkshopsPage from "../components/WorkshopsPage.astro";
import { workshopsHomeMeta } from "../data/WorkshopsHome";
import { workshopsPageMeta } from "../data/WorkshopsPage";
import { site } from "../data/site";

const pageTitle = `${workshopsHomeMeta.title} ${workshopsHomeMeta.titleAccent} | ${site.name}`;
const pageDescription = workshopsPageMeta.pageDescription;
const canonical = `${site.url}/workshopy`;

const navLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy & výjezdy" },
  { href: "/recenze", label: "Recenze" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>
  <Navbar
    client:load
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.reservationUrl}
    logoSrc="/images/logo.png"
    brand={site.name}
    logoHref="/"
  />

  <main id="main">
    <WorkshopsPage />
  </main>

  <Footer />
</BaseLayout>
