---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.tsx";
import WorkshopsAllDates from "../components/WorkshopsAllDates.astro";
import WorkshopsPage from "../components/WorkshopsPage.astro";
import { site } from "../data/site";
import { workshopsHomeMeta } from "../data/WorkshopsHome";
import { workshopsPageMeta } from "../data/WorkshopsPage";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = `${workshopsHomeMeta.title} ${workshopsHomeMeta.titleAccent} | ${site.name}`;
const pageDescription = workshopsPageMeta.pageDescription;
const canonical = `${site.url}/workshopy`;

const navLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/#vekove-kategorie", label: "Cvičení pro děti" },
  { href: "/#workshopy", label: "Další akce" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];

const mobileNavLinks = [
  { href: "/#o-mne", label: "O mně" },
  { href: "/vekove-kategorie", label: "Věkové kategorie" },
  { href: "/#lokace", label: "Kde cvičíme" },
  { href: "/workshopy", label: "Workshopy" },
  { href: "/#kempy", label: "Kempy & výjezdy" },
  { href: "/recenze", label: "Recenze" },
  { href: "/#provozni-rad", label: "Provozní řád" },
  { href: "/#kontakt", label: "Kontakt" },
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <script is:inline define:vars={{ scrollKey: "workshops-home-scroll" }}>
    if (sessionStorage.getItem(scrollKey)) {
      document.documentElement.dataset.workshopsHomeArrival = "true";
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    }
  </script>

  <Navbar
    client:load
    links={navLinks}
    mobileLinks={mobileNavLinks}
    reservationUrl={site.signupFormUrl}
    logoSrc="/images/logo.png"
    brand={site.name}
    logoHref="/"
  />

  <main id="main">
    <WorkshopsPage />
    <WorkshopsAllDates />
  </main>

  <script
    is:inline
    define:vars={{
      scrollKey: "workshops-home-scroll",
      arrivalAttr: "workshopsHomeArrival",
    }}
  >
    (function () {
      const targetId = sessionStorage.getItem(scrollKey);
      if (!targetId) return;

      const target = document.getElementById(targetId);
      if (!target) {
        delete document.documentElement.dataset[arrivalAttr];
        return;
      }

      const scrollToTarget = function () {
        const offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo(0, top);
        history.replaceState(null, "", "#" + targetId);
      };

      const finish = function () {
        sessionStorage.removeItem(scrollKey);
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            delete document.documentElement.dataset[arrivalAttr];
          });
        });
      };

      document.fonts.ready.then(function () {
        scrollToTarget();
        requestAnimationFrame(function () {
          scrollToTarget();
          finish();
        });
      });
    })();
  </script>

  <Footer />
</BaseLayout>
