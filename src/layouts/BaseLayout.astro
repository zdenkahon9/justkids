---
import "../styles/global.css";

import MetaHead from "../components/Meta/Head.astro";
import PreloadFonts from "../components/Meta/PreloadFonts.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import { ROUTE_IDS, ROUTES } from "../config/routes";
import {
  createBreadcrumbSchema,
  createLocalBusinessSchema,
  createWebsiteSchema,
} from "../config/schemaJson";
import { site } from "../data/site";

type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const websiteSchema = createWebsiteSchema(siteUrl);
const localBusinessSchema = createLocalBusinessSchema(siteUrl);
const breadcrumbSchema =
  Astro.url.pathname === ROUTES.home._
    ? undefined
    : createBreadcrumbSchema(siteUrl, [
        { name: "Domů", path: ROUTES.home._ },
        { name: title, path: Astro.url.pathname },
      ]);
---

<!doctype html>
<html lang="cs">
  <MetaHead title={title} description={description}>
    <PreloadFonts />

    <SchemaOrg schema={websiteSchema} />
    <SchemaOrg schema={localBusinessSchema} />
    {breadcrumbSchema && <SchemaOrg schema={breadcrumbSchema} />}
    <slot name="head" />
  </MetaHead>

  <body>
    <a href={`#${ROUTE_IDS.home.hero}`} class="skip-link">Přeskočit na obsah</a>
    <slot />

    {/* Reveal-on-scroll observer (vanilla, lightweight) */}
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = document.querySelectorAll(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((e) => e.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>
