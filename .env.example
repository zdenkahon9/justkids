# Astro env
SITE_URL="https://justkids.cz"
ENV_NAME="staging | production"
PUBLIC_UMAMI_SITE_ID="umami-site-id"
PUBLIC_UMAMI_SHARE_URL="https://cloud.umami.is"

# Apify API token pro stahování recenzí z Facebooku
# Získej ho na: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ID datasetu z Apify (v URL po spuštění actoru: .../datasets/XXXXX/items)
APIFY_DATASET_ID=

# Volitelný limit (prázdné nebo 0 = stáhnout všechny recenze z datasetu)
APIFY_REVIEWS_LIMIT=
